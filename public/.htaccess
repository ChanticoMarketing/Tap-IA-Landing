# ====================================================================
# CONFIGURACIÓN DE REDIRECCIÓN Y PROXY PARA ASTRO SSR EN HOSTINGER
# ====================================================================
#
# Este archivo ayuda a resolver el error "403 Forbidden" en Hostinger
# redirigiendo el tráfico del servidor Apache/LiteSpeed al proceso Node.js.
#
# Hay dos métodos comunes en Hostinger. Activa el que corresponda a tu plan.
# Por defecto, este archivo viene configurado para el Método A (Proxy Reverso).
#
# ====================================================================
# MÉTODO A: PROXY REVERSO A UN PUERTO LOCAL (RECOMENDADO / MÁS COMÚN)
# ====================================================================
# Si tu aplicación corre en un puerto asignado por Hostinger (ej. 4321, 3000, etc.),
# este bloque redirige todo el tráfico web a ese puerto de forma transparente.
#
# IMPORTANTE: Reemplaza "4321" con el puerto exacto asignado a tu aplicación
# en el panel de Node.js en hPanel de Hostinger (ej. 3000, 3001, etc.).

<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # 1. Forzar HTTPS si no está ya activo
    RewriteCond %{HTTPS} off
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # 2. Permitir el acceso directo a archivos estáticos reales (CSS, JS, imágenes, etc.)
    # Si el archivo físico existe en la carpeta actual, sírvelo directamente
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # 3. Redirigir todo lo demás al proceso Node.js local de Astro
    # Reemplaza 4321 con tu puerto real si es diferente. El flag [P] hace un Proxy reverso.
    RewriteRule ^(.*)$ http://127.0.0.1:4321/$1 [P,L]
</IfModule>

# ====================================================================
# MÉTODO B: CONFIGURACIÓN PHUSION PASSENGER (CPanel/Planes específicos)
# ====================================================================
# Si tu hPanel utiliza Phusion Passenger para levantar el Node.js, descomenta
# las siguientes líneas (quita el '#' al principio de cada línea) y comenta
# el bloque del Método A superior.
#
# <IfModule mod_passenger.c>
#     PassengerEnabled on
#     PassengerAppEnv production
#     PassengerAppRoot /home/u123456789/domains/tap-ia.tech/public_html
#     PassengerStartupFile dist/server/entry.mjs
# </IfModule>
