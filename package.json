    "verify:resend": "node scripts/verify-resend.mjs",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/node": "^9.5.5",
    "@astrojs/react": "^4.4.2",
    "@tailwindcss/vite": "^4.2.1",
    "@types/three": "^0.170.0",
    "astro": "^5.1.1",
    "framer-motion": "^12.35.0",
    "gsap": "^3.14.2",
    "lucide-react": "^0.577.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "resend": "^6.12.3",
    "tailwindcss": "^4.2.1",
    "three": "^0.183.2",
    "typescript": "^5.7.3"
  },
  "devDependencies": {
    "sharp": "^0.34.5",
    "to-ico": "^1.1.5"
