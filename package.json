{
  "name": "tap-ia",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev --open",
    "start": "astro dev",
    "prebuild": "node scripts/build-favicon.mjs",
    "build": "astro check && astro build",
    "start:prod": "node ./dist/server/entry.mjs",
    "prod": "npm run build && node ./dist/server/entry.mjs",
    "prod:clean": "node scripts/restart-prod.mjs",
    "preview": "astro preview",
    "validate:editorial-plan": "node scripts/validate-editorial-plan.mjs",
    "validate:blog": "node scripts/validate-blog-run.mjs",
    "promote:blog-run": "node scripts/promote-blog-run.mjs",
    "review:antigravity": "node scripts/run-antigravity-review.mjs",
