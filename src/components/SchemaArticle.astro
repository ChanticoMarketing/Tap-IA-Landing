---
import { SITE_URL } from '../lib/seo';

interface Props {
  headline: string;
  description: string;
  url: string;
  datePublished: string;
  dateModified?: string;
  author?: string;
  image?: string;
  articleSection?: string;
  type?: 'Article' | 'NewsArticle' | 'BlogPosting';
  keywords?: string[];
  citation?: string[];
  wordCount?: number;
  imageAlt?: string;
}

const {
  headline,
  description,
  url,
  datePublished,
  dateModified,
  author = 'Emmanuel Tapia',
  image = `${SITE_URL}/logo.png`,
  articleSection = 'Novedades IA',
  type = 'NewsArticle',
  keywords = [],
  citation = [],
  wordCount,
  imageAlt = headline,
} = Astro.props;

const articleUrl = new URL(url, SITE_URL).href;
---

<script type="application/ld+json" is:inline set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": type,
  "@id": `${articleUrl}#article`,
  "headline": headline,
  "description": description,
  "url": articleUrl,
  "image": [{
    "@type": "ImageObject",
    "url": image,
    "contentUrl": image,
    "caption": imageAlt,
  }],
  "datePublished": datePublished,
  "dateModified": dateModified ?? datePublished,
  "author": author === 'Emmanuel Tapia' ? {
    "@type": "Person",
    "@id": "https://tap-ia.tech/nosotros/emmanuel-tapia#person",
    "name": "Emmanuel Tapia",
    "url": "https://tap-ia.tech/nosotros/emmanuel-tapia"
  } : {
    "@type": "Organization",
    "@id": "https://tap-ia.tech/#organization",
    "name": author,
  },
  "publisher": {
    "@type": "Organization",
    "@id": "https://tap-ia.tech/#organization",
    "name": "TAP-IA",
    "logo": {
      "@type": "ImageObject",
      "url": `${SITE_URL}/logo.png`
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": articleUrl
  },
  "articleSection": articleSection,
  "keywords": keywords,
  "citation": citation,
  ...(wordCount ? { "wordCount": wordCount } : {}),
  "isPartOf": {
    "@type": "WebSite",
    "@id": "https://tap-ia.tech/#website",
    "url": "https://tap-ia.tech",
    "name": "TAP-IA"
  },
  "isAccessibleForFree": true
})} />
