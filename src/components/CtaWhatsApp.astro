---
// src/components/CtaWhatsApp.astro
// Este es el CTA primario de conversión (diagnóstico/contacto).
// No es exclusivo de WhatsApp, aunque conserve el nombre del archivo.

interface Props {
    text?: string;
    microcopy?: string;
    href?: string;
    classes?: string;
    align?: 'start' | 'center';
}

const { 
    text = "Solicitar Diagnóstico", 
    microcopy = "Te digo en 5 min si esto aplica a tu empresa.",
    href = "/contacto",
    classes = "min-h-[48px] px-10 py-4 bg-white text-charcoal font-semibold rounded-full hover:bg-gold hover:text-white hover:scale-[1.02] transition-all duration-300 shadow-lg shadow-white/5 text-base inline-flex items-center justify-center gap-2",
    align = 'center'
} = Astro.props;

const isExternal = /^https?:\/\//.test(href);
const alignClass = align === 'start' ? 'items-start text-left' : 'items-center text-center';
---

<div class:list={['flex flex-col', alignClass]}>
    <a href={href} class={classes} target={isExternal ? "_blank" : undefined} rel={isExternal ? "noopener noreferrer" : undefined}>
        {text} <i class="fa-solid fa-arrow-right text-sm opacity-80"></i>
    </a>
    {microcopy && (
        <p class="text-xs text-subtle mt-4 font-medium tracking-wide uppercase">
            {microcopy}
        </p>
    )}
</div>
