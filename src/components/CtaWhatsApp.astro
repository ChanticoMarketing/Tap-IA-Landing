---
// src/components/CtaWhatsApp.astro
// Este es el CTA primario de conversión (diagnóstico/contacto).
// No es exclusivo de WhatsApp, aunque conserve el nombre del archivo.

interface Props {
    text?: string;
    microcopy?: string;
    href?: string;
    classes?: string;
    align?: 'start' | 'center';
}

const { 
    text = "Quiero potenciar mi negocio con IA", 
    microcopy = "Te digo de forma honesta y en 5 minutos si esto aplica para ti.",
    href = "/contacto",
    classes = "min-h-[48px] px-8 py-3.5 bg-white text-charcoal font-semibold rounded-full hover:bg-offwhite hover:shadow-[0_0_35px_rgba(59,130,246,0.25)] hover:scale-[1.02] transition-all duration-300 shadow-[0_0_25px_rgba(59,130,246,0.14)] text-base inline-flex items-center justify-center gap-2.5",
    align = 'center'
} = Astro.props;

const isExternal = /^https?:\/\//.test(href);
const isWhatsApp = href.includes('wa.me/');
const alignClass = align === 'start' ? 'items-start text-left' : 'items-center text-center';
---

<div class:list={['flex flex-col', alignClass]}>
    <a href={href} class={classes} target={isExternal ? "_blank" : undefined} rel={isExternal ? "noopener noreferrer" : undefined}>
        {text}
        {isWhatsApp ? (
            <i class="fa-brands fa-whatsapp text-base opacity-90" aria-hidden="true"></i>
        ) : (
            <i class="fa-solid fa-arrow-right text-sm opacity-80" aria-hidden="true"></i>
        )}
    </a>
    {microcopy && (
        <p class="text-xs text-subtle mt-4 font-medium tracking-wide uppercase">
            {microcopy}
        </p>
    )}
</div>
