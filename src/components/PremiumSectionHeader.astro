---
interface Props {
    label: string;
    title: string;
    subtitle?: string;
    centered?: boolean;
}

const { label, title, subtitle, centered = false } = Astro.props;
---

<div class={`mb-12 md:mb-16 ${centered ? 'text-center flex flex-col items-center' : 'text-left flex flex-col items-start'}`}>
    <span class="editorial-label block mb-3">{label}</span>
    <div class="gold-rule mb-6"></div>
    <h2 class="mb-4 text-white" set:html={title}></h2>
    {subtitle && <p class={`text-subtle text-base md:text-lg max-w-2xl font-light ${centered ? 'text-center' : ''}`} set:html={subtitle}></p>}
</div>
