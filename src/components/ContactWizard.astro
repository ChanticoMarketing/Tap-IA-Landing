---
interface Props {
  wizardId?: string;
  plan?: string;
  problem?: string;
  servicio?: string;
  demo?: string;
  showMobileWa?: boolean;
  showDesktopWaLink?: boolean;
}

const {
  wizardId = 'contact',
  plan = '',
  problem = '',
  servicio = '',
  demo = '',
  showDesktopWaLink = false,
} = Astro.props;

const waText = encodeURIComponent('¡Hola Tap-IA! Estoy en tu web y prefiero platicarte mi idea directamente por chat para ver cómo lo ves. ¿Platicamos? 📲');
const waHref = `https://wa.me/5213324239103?text=${waText}`;
const wid = wizardId;
---

<div class="contact-wizard" data-contact-wizard={wid} id={`contact-wizard-${wid}`}>

  <div class="bg-transparent p-0">
    <!-- Success State (Inline Thank You Card) -->
    <div
      data-wizard-success-state
      aria-labelledby={`wizard-success-heading-${wid}`}
      class="hidden animate-sweep text-center py-12 px-6 md:py-16 md:px-10 rounded-2xl border border-white/5 bg-matte/60 backdrop-blur-md max-w-xl mx-auto shadow-2xl focus:outline-none focus:ring-2 focus:ring-gold"
      role="status"
      aria-live="polite"
      tabindex="-1"
    >
      <div class="inline-flex items-center justify-center w-20 h-20 rounded-full bg-gold/10 border border-gold/30 text-gold mb-6 shadow-[0_0_30px_rgba(212,175,55,0.15)] animate-pulse-slow">
        <i class="fa-solid fa-check text-4xl" aria-hidden="true"></i>
      </div>

      <h3 id={`wizard-success-heading-${wid}`} class="font-playfair text-3xl md:text-4xl text-offwhite font-bold mb-4 tracking-wide">
        ¡Solicitud Recibida!
      </h3>

      <p class="font-jakarta text-subtle text-base md:text-lg mb-8 leading-relaxed">
        Gracias, <span data-user-name-placeholder class="text-gold font-semibold"></span>. Tu diagnóstico de encaje está en revisión.
      </p>

      <p class="text-subtle text-sm mb-10 max-w-md mx-auto leading-relaxed">
        Revisamos tu caso y te contactamos en <strong class="text-offwhite">1 día hábil</strong> con el siguiente paso.
        Si tu proyecto es urgente, puedes escribirnos directamente por WhatsApp.
      </p>

      <div class="gold-rule my-6 opacity-30"></div>

      <div class="flex flex-col sm:flex-row gap-4 justify-center items-center font-jakarta">
        <a
          href={waHref}
          target="_blank"
          rel="noopener noreferrer"
          data-wizard-success-wa-link
          class="w-full sm:w-auto inline-flex items-center justify-center gap-3 bg-[#25D366] hover:bg-[#20ba5a] text-white px-8 py-3.5 rounded-full font-bold transition-all duration-300 shadow-[0_4px_15px_rgba(37,211,102,0.2)] hover:shadow-[0_6px_20px_rgba(37,211,102,0.3)] active:scale-95 text-xs uppercase tracking-wider min-h-[44px]"
        >
          <i class="fa-brands fa-whatsapp text-lg" aria-hidden="true"></i>
          Acelerar por WhatsApp
        </a>
        
        <a
          href="/"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 border border-white/10 hover:border-gold/30 bg-matte/45 hover:bg-gold/5 text-offwhite hover:text-gold px-8 py-3.5 rounded-full font-bold transition-all duration-300 active:scale-95 text-xs uppercase tracking-wider min-h-[44px]"
        >
          <i class="fa-solid fa-house text-sm" aria-hidden="true"></i>
          Volver al Inicio
        </a>
      </div>
    </div>

    <!-- Progress Indicator -->
    <div class="mb-6 md:mb-8" aria-label="Progreso del formulario" data-wizard-scroll-anchor>
      <div class="flex justify-between ui-caption mb-3">
        <span data-wizard-step-indicator>Paso 1 de 4</span>
        <span data-wizard-progress-percent class="text-gold font-semibold">0%</span>
      </div>
      <div
        class="w-full bg-white/5 h-1.5 rounded-full overflow-hidden"
        role="progressbar"
        aria-valuemin="0"
        aria-valuemax="100"
        aria-valuenow="0"
        data-wizard-progress-track
      >
        <div data-wizard-progress-bar class="bg-gold h-full transition-all duration-500 w-0"></div>
      </div>
    </div>

    <!-- Live Status Banner -->
    <div
      data-wizard-form-status
      class="hidden mb-6 p-4 rounded-lg border text-sm"
      role="status"
      aria-live="polite"
    >
    </div>

    <form data-wizard-form novalidate>
      <!-- Honeypot Spam Filter -->
      <input
        type="text"
        name="bot_field"
        class="honeypot-field"
        tabindex="-1"
        autocomplete="off"
        aria-hidden="true"
      />

      <input type="hidden" name="source_page" data-attr="source_page" value="" />
      <input type="hidden" name="utm_source" data-attr="utm_source" value="" />
      <input type="hidden" name="utm_medium" data-attr="utm_medium" value="" />
      <input type="hidden" name="utm_campaign" data-attr="utm_campaign" value="" />
      <input type="hidden" name="plan" data-attr="plan" value={plan} />
      <input type="hidden" name="servicio" data-attr="servicio" value={servicio} />
      <input type="hidden" name="problem" data-attr="problem" value={problem} />
      <input type="hidden" name="demo" data-attr="demo" value={demo} />
      <input type="hidden" name="referrer" data-attr="referrer" value="" />

      <!-- ========================================== -->
      <!-- STEP 1: DIGITAL STARTING POINT -->
      <!-- ========================================== -->
      <div class="step-content active" data-step="1">
        <h3 class="mb-6 text-white font-playfair text-xl md:text-2xl" data-wizard-step-title="1" tabindex="-1">
          1. Tu punto de partida digital
        </h3>

        <!-- Website Status Tiles (router) -->
        <div class="mb-6" data-wizard-has_website-group>
          <label class="block ui-caption mb-3 text-gold font-jakarta">
            ¿Tu negocio tiene una página web activa? <span class="text-gold">*</span>
          </label>
          <input type="hidden" name="has_website" id={`${wid}-field-has_website`} required />

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 font-jakarta text-sm">
            <button
              type="button"
              data-tile-name="has_website"
              data-tile-value="no"
              class="tile-option p-4 rounded-xl border border-white/5 bg-matte/45 text-left hover:border-gold/30 hover:bg-gold/5 transition-all focus:outline-none flex flex-col justify-between gap-4"
            >
              <i class="fa-solid fa-circle-xmark text-subtle text-lg" aria-hidden="true"></i>
              <div>
                <span class="font-bold text-offwhite block">No, aún no</span>
                <span class="text-[11px] text-subtle mt-1 block leading-normal">Buscamos arrancar una estrategia desde cero.</span>
              </div>
            </button>

            <button
              type="button"
              data-tile-name="has_website"
              data-tile-value="old"
              class="tile-option p-4 rounded-xl border border-white/5 bg-matte/45 text-left hover:border-gold/30 hover:bg-gold/5 transition-all focus:outline-none flex flex-col justify-between gap-4"
            >
              <i class="fa-solid fa-clock-rotate-left text-gold text-lg" aria-hidden="true"></i>
              <div>
                <span class="font-bold text-offwhite block">Sí, pero obsoleta</span>
                <span class="text-[11px] text-subtle mt-1 block leading-normal">Es lenta, no vende o no tiene soporte.</span>
              </div>
            </button>

            <button
              type="button"
              data-tile-name="has_website"
              data-tile-value="yes"
              class="tile-option p-4 rounded-xl border border-white/5 bg-matte/45 text-left hover:border-gold/30 hover:bg-gold/5 transition-all focus:outline-none flex flex-col justify-between gap-4"
            >
              <i class="fa-solid fa-circle-check text-gold text-lg" aria-hidden="true"></i>
              <div>
                <span class="font-bold text-offwhite block">Sí, activa</span>
                <span class="text-[11px] text-subtle mt-1 block leading-normal">Web estable funcionando en internet.</span>
              </div>
            </button>
          </div>
          <p data-wizard-has_website-error class="field-error hidden" role="alert"></p>
        </div>

        <!-- Prioridades por problema (mapeo interno a servicios Tap-IA) -->
        <div class="mb-6 hidden" data-wizard-priority-block>
          <input type="hidden" name="primary_goal" id={`${wid}-field-primary_goal`} />
          <input type="hidden" name="obstacle" id={`${wid}-field-obstacle`} />
          <div data-wizard-priority-group>
            <label class="block ui-caption mb-2 text-gold font-jakarta">
              ¿Con qué situación te identificas hoy? <span class="text-gold">*</span>
            </label>
            <p class="text-subtle text-xs mb-3 font-jakarta">
              Puedes marcar varias. No necesitas saber el servicio: eso lo aterrizamos contigo en la sesión.
            </p>

            <div
              class="grid grid-cols-1 sm:grid-cols-2 gap-4 font-jakarta text-sm"
              role="group"
              aria-label="Problemas o situaciones actuales"
            >
              <button
                type="button"
                data-tile-name="priority"
                data-tile-value="diagnostic"
                aria-pressed="false"
                class="tile-option p-4 rounded-xl border border-white/5 bg-matte/45 text-left hover:border-gold/30 hover:bg-gold/5 transition-all focus:outline-none flex items-start gap-4"
              >
                <i class="fa-solid fa-magnifying-glass-chart text-gold text-lg mt-0.5" aria-hidden="true"></i>
                <div>
                  <span class="font-bold text-offwhite block">No sé por dónde empezar</span>
                  <span class="text-xs text-subtle mt-1 block leading-normal">Invierto en digital, pero sin un plan claro ni prioridades.</span>
                </div>
              </button>

              <button
                type="button"
                data-tile-name="priority"
                data-tile-value="visibility"
                aria-pressed="false"
                class="tile-option p-4 rounded-xl border border-white/5 bg-matte/45 text-left hover:border-gold/30 hover:bg-gold/5 transition-all focus:outline-none flex items-start gap-4"
              >
                <i class="fa-solid fa-wand-magic-sparkles text-gold text-lg mt-0.5" aria-hidden="true"></i>
                <div>
                  <span class="font-bold text-offwhite block">Casi nadie nos encuentra</span>
                  <span class="text-xs text-subtle mt-1 block leading-normal">Poca presencia en Google y la IA no nos recomienda.</span>
                </div>
              </button>

              <button
                type="button"
                data-tile-name="priority"
                data-tile-value="conversion_leads"
                class="tile-option p-4 rounded-xl border border-white/5 bg-matte/45 text-left hover:border-gold/30 hover:bg-gold/5 transition-all focus:outline-none flex items-start gap-4"
              >
                <i class="fa-solid fa-funnel-dollar text-gold text-lg mt-0.5" aria-hidden="true"></i>
                <div>
                  <span class="font-bold text-offwhite block">Hay tráfico, pero no vendemos</span>
                  <span class="text-xs text-subtle mt-1 block leading-normal">Visitas o contactos que no se convierten en clientes.</span>
                </div>
              </button>

              <button
                type="button"
                data-tile-name="priority"
                data-tile-value="marketing_ai"
                class="tile-option p-4 rounded-xl border border-white/5 bg-matte/45 text-left hover:border-gold/30 hover:bg-gold/5 transition-all focus:outline-none flex items-start gap-4"
              >
                <i class="fa-solid fa-bullseye text-gold text-lg mt-0.5" aria-hidden="true"></i>
                <div>
                  <span class="font-bold text-offwhite block">Marketing sin resultados claros</span>
                  <span class="text-xs text-subtle mt-1 block leading-normal">Mucho esfuerzo publicando o pautando; poco retorno medible.</span>
                </div>
              </button>

              <button
                type="button"
                data-tile-name="priority"
                data-tile-value="automation"
                class="tile-option p-4 rounded-xl border border-white/5 bg-matte/45 text-left hover:border-gold/30 hover:bg-gold/5 transition-all focus:outline-none flex items-start gap-4"
              >
                <i class="fa-solid fa-gears text-gold text-lg mt-0.5" aria-hidden="true"></i>
                <div>
                  <span class="font-bold text-offwhite block">Perdemos tiempo en lo repetitivo</span>
                  <span class="text-xs text-subtle mt-1 block leading-normal">Seguimiento, respuestas o procesos que deberían ser automáticos.</span>
                </div>
              </button>

              <button
                type="button"
                data-tile-name="priority"
                data-tile-value="custom_platform"
                class="tile-option p-4 rounded-xl border border-white/5 bg-matte/45 text-left hover:border-gold/30 hover:bg-gold/5 transition-all focus:outline-none flex items-start gap-4"
              >
                <i class="fa-solid fa-code text-gold text-lg mt-0.5" aria-hidden="true"></i>
                <div>
                  <span class="font-bold text-offwhite block">Necesitamos algo que no existe listo</span>
                  <span class="text-xs text-subtle mt-1 block leading-normal">Excel, WhatsApp o herramientas sueltas ya no nos alcanzan.</span>
                </div>
              </button>

              <button
                type="button"
                data-tile-name="priority"
                data-tile-value="video_avatar"
                class="tile-option p-4 rounded-xl border border-white/5 bg-matte/45 text-left hover:border-gold/30 hover:bg-gold/5 transition-all focus:outline-none flex items-start gap-4"
              >
                <i class="fa-solid fa-user-astronaut text-gold text-lg mt-0.5" aria-hidden="true"></i>
                <div>
                  <span class="font-bold text-offwhite block">No damos abasto con video</span>
                  <span class="text-xs text-subtle mt-1 block leading-normal">Queremos presencia en video sin grabar y editar todo a mano.</span>
                </div>
              </button>

              <button
                type="button"
                data-tile-name="priority"
                data-tile-value="strategy"
                class="tile-option p-4 rounded-xl border border-white/5 bg-matte/45 text-left hover:border-gold/30 hover:bg-gold/5 transition-all focus:outline-none flex items-start gap-4"
              >
                <i class="fa-solid fa-chess-knight text-gold text-lg mt-0.5" aria-hidden="true"></i>
                <div>
                  <span class="font-bold text-offwhite block">Quiero usar IA, pero con criterio</span>
                  <span class="text-xs text-subtle mt-1 block leading-normal">Miedo a invertir mal o elegir herramientas al azar.</span>
                </div>
              </button>

              <button
                type="button"
                data-tile-name="priority"
                data-tile-value="web_launch"
                class="tile-option p-4 rounded-xl border border-white/5 bg-matte/45 text-left hover:border-gold/30 hover:bg-gold/5 transition-all focus:outline-none flex items-start gap-4"
                data-priority-no-web-only
              >
                <i class="fa-solid fa-rocket text-gold text-lg mt-0.5" aria-hidden="true"></i>
                <div>
                  <span class="font-bold text-offwhite block">Aún no existimos en digital</span>
                  <span class="text-xs text-subtle mt-1 block leading-normal">No tenemos web o canal serio que nos represente.</span>
                </div>
              </button>

              <button
                type="button"
                data-tile-name="priority"
                data-tile-value="not_sure"
                class="tile-option p-4 rounded-xl border border-white/5 bg-matte/45 text-left hover:border-gold/30 hover:bg-gold/5 transition-all focus:outline-none flex items-start gap-4 sm:col-span-2"
              >
                <i class="fa-solid fa-compass text-subtle text-lg mt-0.5" aria-hidden="true"></i>
                <div>
                  <span class="font-bold text-offwhite block">No identifico el problema exacto</span>
                  <span class="text-xs text-subtle mt-1 block leading-normal">Necesito ayuda para priorizar antes de invertir.</span>
                </div>
              </button>
            </div>
            <p data-wizard-priority-error class="field-error hidden" role="alert"></p>
          </div>
        </div>

        <!-- URL input (yes or old) -->
        <div id={`${wizardId}-website-url`} class="hidden mb-6 animate-sweep">
          <label class="block ui-caption mb-2 font-jakarta" for={`${wid}-field-current_website`}>
            Dirección (URL) de tu web actual
          </label>
          <input
            type="url"
            name="current_website"
            id={`${wid}-field-current_website`}
            class="input-field font-jakarta text-sm"
            placeholder="https://www.tuempresa.com"
          />
        </div>

        <div class="mb-6">
          <label class="block ui-caption mb-2 font-jakarta" for={`${wid}-field-value_prop`}>
            ¿Qué hace que tus clientes te elijan a ti? <span class="normal-case text-subtle font-jakarta">(opcional)</span>
          </label>
          <textarea
            name="value_prop"
            id={`${wid}-field-value_prop`}
            rows="2"
            maxlength="280"
            class="input-field font-jakarta text-sm"
            placeholder="Ej. Soporte 24/7, tecnología propietaria, atención especializada..."></textarea>
        </div>
      </div>

      <!-- ========================================== -->
      <!-- STEP 2: SERVICES -->
      <!-- ========================================== -->
      <div class="step-content" data-step="2">
        <h3 class="mb-6 text-white font-playfair text-xl md:text-2xl" data-wizard-step-title="2" tabindex="-1">
          2. Prioridades de proyecto
        </h3>

        <!-- Services Checkboxes Group -->
        <div class="mb-6" data-wizard-services-group>
          <span class="block ui-caption mb-2 text-gold font-jakarta" id={`${wid}-services-label`}>
            ¿Qué te gustaría construir o mejorar primero? <span class="text-gold">*</span>
          </span>
          <p class="text-subtle text-xs mb-3 font-jakarta" data-wizard-services-hint>Puedes seleccionar varias opciones.</p>
          <div
            class="grid grid-cols-1 md:grid-cols-2 gap-3 font-jakarta text-sm"
            role="group"
            aria-labelledby={`${wid}-services-label`}
            data-wizard-services-grid
          >
            <label class="option-label" data-service-item="web">
              <input type="checkbox" name="services" value="web" class="mr-3" />
              <span>Página web o Landing page premium</span>
            </label>
            <label class="option-label" data-service-item="seo_geo">
              <input type="checkbox" name="services" value="seo_geo" class="mr-3" />
              <span>Posicionamiento en Google y motores de IA</span>
            </label>
            <label class="option-label" data-service-item="agents">
              <input type="checkbox" name="services" value="agents" class="mr-3" />
              <span>Automatizaciones o agentes de IA</span>
            </label>
            <label class="option-label" data-service-item="webapps">
              <input type="checkbox" name="services" value="webapps" class="mr-3" />
              <span>Plataforma o software web a medida</span>
            </label>
            <label class="option-label" data-service-item="marketing">
              <input type="checkbox" name="services" value="marketing" class="mr-3" />
              <span>Campañas de marketing asistidas por IA</span>
            </label>
            <label class="option-label" data-service-item="avatars">
              <input type="checkbox" name="services" value="avatars" class="mr-3" />
              <span>Avatares IA o videos automatizados</span>
            </label>
            <label class="option-label" data-service-item="consultoria">
              <input type="checkbox" name="services" value="consultoria" class="mr-3" />
              <span>Consultoría estratégica en IA</span>
            </label>
            <label class="option-label" data-service-item="audit">
              <input type="checkbox" name="services" value="audit" class="mr-3" />
              <span>Auditoría AI Marketing + SEO/GEO</span>
            </label>
          </div>
          <p data-wizard-services-error class="field-error hidden" role="alert"></p>
        </div>
      </div>

      <!-- ========================================== -->
      <!-- STEP 3: TIMES & BUDGET SCALE -->
      <!-- ========================================== -->
      <div class="step-content" data-step="3">
        <h3 class="mb-6 text-white font-playfair text-xl md:text-2xl" data-wizard-step-title="3" tabindex="-1">
          3. Tiempos y Presupuesto
        </h3>

        <!-- Interactive Urgency Tiles -->
        <div class="mb-6" data-wizard-urgency-group>
          <label class="block ui-caption mb-3 text-gold font-jakarta">
            ¿Cuándo te gustaría iniciar este proyecto? <span class="text-gold">*</span>
          </label>
          <input type="hidden" name="urgency" id={`${wid}-field-urgency`} required />
          
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 font-jakarta text-sm">
            <button
              type="button"
              data-tile-name="urgency"
              data-tile-value="asap"
              class="tile-option p-4 rounded-xl border border-white/5 bg-matte/45 text-left hover:border-gold/30 hover:bg-gold/5 transition-all focus:outline-none flex flex-col justify-between gap-4"
            >
              <i class="fa-solid fa-bolt text-gold text-lg" aria-hidden="true"></i>
              <div>
                <span class="font-bold text-offwhite block">Inmediato</span>
                <span class="text-[11px] text-subtle mt-1 block leading-normal">En menos de 2 semanas.</span>
              </div>
            </button>
            
            <button
              type="button"
              data-tile-name="urgency"
              data-tile-value="soon"
              class="tile-option p-4 rounded-xl border border-white/5 bg-matte/45 text-left hover:border-gold/30 hover:bg-gold/5 transition-all focus:outline-none flex flex-col justify-between gap-4"
            >
              <i class="fa-solid fa-calendar-days text-gold text-lg" aria-hidden="true"></i>
              <div>
                <span class="font-bold text-offwhite block">Próximo mes</span>
                <span class="text-[11px] text-subtle mt-1 block leading-normal">Ventana de tiempo planificada.</span>
              </div>
            </button>
            
            <button
              type="button"
              data-tile-name="urgency"
              data-tile-value="info"
              class="tile-option p-4 rounded-xl border border-white/5 bg-matte/45 text-left hover:border-gold/30 hover:bg-gold/5 transition-all focus:outline-none flex flex-col justify-between gap-4"
            >
              <i class="fa-solid fa-magnifying-glass-chart text-subtle text-lg" aria-hidden="true"></i>
              <div>
                <span class="font-bold text-offwhite block">Investigación</span>
                <span class="text-[11px] text-subtle mt-1 block leading-normal">Solo explorando factibilidad inicial.</span>
              </div>
            </button>
          </div>
          <p data-wizard-urgency-error class="field-error hidden" role="alert"></p>
        </div>

        <!-- Interactive Budget scale Tiles -->
        <div class="mb-6 font-jakarta" data-wizard-budget-group>
          <label class="block ui-caption mb-3 text-gold">
            ¿Cuál es la escala actual de tu operación comercial? <span class="text-gold">*</span>
          </label>
          <input type="hidden" name="budget" id={`${wid}-field-budget`} required />
          
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 font-jakarta text-sm">
            <button
              type="button"
              data-tile-name="budget"
              data-tile-value="captacion"
              class="tile-option p-4 rounded-xl border border-white/5 bg-matte/45 text-left hover:border-gold/30 hover:bg-gold/5 transition-all focus:outline-none flex items-start gap-4"
            >
              <i class="fa-solid fa-user text-gold text-lg mt-0.5" aria-hidden="true"></i>
              <div>
                <span class="font-bold text-offwhite block">Independiente / Startup</span>
                <span class="text-xs text-subtle mt-1 block leading-normal">Validando negocio u operación inicial.</span>
              </div>
            </button>
            
            <button
              type="button"
              data-tile-name="budget"
              data-tile-value="sistema"
              class="tile-option p-4 rounded-xl border border-white/5 bg-matte/45 text-left hover:border-gold/30 hover:bg-gold/5 transition-all focus:outline-none flex items-start gap-4"
            >
              <i class="fa-solid fa-users text-gold text-lg mt-0.5" aria-hidden="true"></i>
              <div>
                <span class="font-bold text-offwhite block">Equipo en crecimiento</span>
                <span class="text-xs text-subtle mt-1 block leading-normal">De 2 a 15 colaboradores activos.</span>
              </div>
            </button>
            
            <button
              type="button"
              data-tile-name="budget"
              data-tile-value="arquitectura"
              class="tile-option p-4 rounded-xl border border-white/5 bg-matte/45 text-left hover:border-gold/30 hover:bg-gold/5 transition-all focus:outline-none flex items-start gap-4"
            >
              <i class="fa-solid fa-building text-gold text-lg mt-0.5" aria-hidden="true"></i>
              <div>
                <span class="font-bold text-offwhite block">Empresa Consolidada</span>
                <span class="text-xs text-subtle mt-1 block leading-normal">Más de 15 personas o corporación.</span>
              </div>
            </button>
            
            <button
              type="button"
              data-tile-name="budget"
              data-tile-value="evaluar"
              class="tile-option p-4 rounded-xl border border-white/5 bg-matte/45 text-left hover:border-gold/30 hover:bg-gold/5 transition-all focus:outline-none flex items-start gap-4"
            >
              <i class="fa-solid fa-comments text-subtle text-lg mt-0.5" aria-hidden="true"></i>
              <div>
                <span class="font-bold text-offwhite block">Definir en la sesión</span>
                <span class="text-xs text-subtle mt-1 block leading-normal">Revisar las opciones con el consultor.</span>
              </div>
            </button>
          </div>
          <p data-wizard-budget-error class="field-error hidden" role="alert"></p>
        </div>
      </div>

      <!-- ========================================== -->
      <!-- STEP 4: CONTACT ACQUISITION -->
      <!-- ========================================== -->
      <div class="step-content" data-step="4">
        <h3 class="mb-6 text-white font-playfair text-xl md:text-2xl" data-wizard-step-title="4" tabindex="-1">
          4. ¿A dónde enviamos tu diagnóstico?
        </h3>
        <p class="text-subtle mb-6 text-sm font-jakarta">
          Ingresa tus datos para enviarte los resultados del test y el plan de acción sugerido para tu negocio.
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6 mb-6 font-jakarta">
          <div>
            <label class="block ui-caption mb-2 text-gold" for={`${wid}-field-name`}>Tu nombre</label>
            <input
              type="text"
              name="name"
              id={`${wid}-field-name`}
              class="input-field font-jakarta text-sm"
              required
              autocomplete="name"
              placeholder="Ej. Carlos Mendoza"
            />
          </div>
          <div>
            <label class="block ui-caption mb-2 text-gold" for={`${wid}-field-email`}>Tu correo de trabajo</label>
            <input
              type="email"
              name="email"
              id={`${wid}-field-email`}
              class="input-field font-jakarta text-sm"
              required
              autocomplete="email"
              placeholder="carlos@empresa.com"
            />
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6 mb-6 font-jakarta">
          <div>
            <label class="block ui-caption mb-2" for={`${wid}-field-role`}>Tu puesto o cargo</label>
            <input
              type="text"
              name="role"
              id={`${wid}-field-role`}
              class="input-field font-jakarta text-sm"
              autocomplete="organization-title"
              placeholder="Ej. Director, Fundador, CMO"
            />
          </div>
          <div>
            <label class="block ui-caption mb-2 text-gold" for={`${wid}-field-company`}>Nombre de tu empresa</label>
            <input
              type="text"
              name="company"
              id={`${wid}-field-company`}
              class="input-field font-jakarta text-sm"
              required
              autocomplete="organization"
              placeholder="Ej. Mi Negocio S.A."
            />
          </div>
        </div>

        <div class="mb-6 font-jakarta">
          <label class="block ui-caption mb-2" for={`${wid}-field-phone`}>
            Número de WhatsApp <span class="normal-case text-subtle font-jakarta">(opcional para agilizar contacto)</span>
          </label>
          <input
            type="tel"
            name="phone"
            id={`${wid}-field-phone`}
            class="input-field font-jakarta text-sm"
            autocomplete="tel"
            placeholder="Ej. +52 33 1234 5678"
          />
        </div>

        <!-- Notion field removed to prevent final step friction -->

        <div class="mb-4">
          <label class="option-label items-start gap-3">
            <input
              type="checkbox"
              name="consent"
              id={`${wid}-field-consent`}
              value="1"
              class="mt-1 shrink-0 animate-pulse-slow"
              required
            />
            <span class="text-sm text-subtle normal-case tracking-normal leading-normal">
              Acepto el <a href="/legal#privacidad" class="text-gold hover:underline" target="_blank"
                >tratamiento de mis datos</a
              > según el aviso de privacidad de Tap-IA.
            </span>
          </label>
        </div>
      </div>

      <!-- Action Navigation Buttons -->
      <div class="flex justify-between items-center mt-8 pt-6 border-t border-white/10">
        <button
          type="button"
          data-wizard-prev
          class="ui-caption text-subtle hover:text-white px-4 py-2 transition-colors hidden min-h-[44px] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gold"
        >
          <i class="fa-solid fa-arrow-left mr-2" aria-hidden="true"></i> Atrás
        </button>

        <button
          type="button"
          data-wizard-next
          class="bg-white text-charcoal hover:bg-gold hover:text-white px-8 py-3 rounded-full font-bold transition-all duration-300 shadow-lg ml-auto uppercase tracking-wider text-sm min-h-[44px] active:scale-95 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gold"
        >
          Siguiente <i class="fa-solid fa-arrow-right ml-2" aria-hidden="true"></i>
        </button>

        <button
          type="button"
          data-wizard-submit
          class="bg-gold text-charcoal hover:bg-white hover:text-charcoal px-8 py-3 rounded-full font-bold transition-all duration-300 shadow-lg ml-auto hidden items-center gap-2 uppercase tracking-wider text-sm min-h-[44px] active:scale-95 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gold"
        >
          <i class="fa-solid fa-paper-plane text-base" aria-hidden="true"></i>
          Enviar solicitud de diagnóstico
        </button>
      </div>
    </form>
  </div>

  {showDesktopWaLink && (
    <p class="hidden md:block text-center mt-8">
      <a
        href={waHref}
        target="_blank"
        rel="noopener noreferrer"
        class="text-subtle hover:text-gold text-sm transition-colors inline-flex items-center gap-2"
      >
        <i class="fa-brands fa-whatsapp text-whatsapp" aria-hidden="true"></i>
        ¿Prefieres WhatsApp? Escríbeme y lo platicamos directo 💬
      </a>
    </p>
  )}
</div>

<style>
  .tile-option {
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    transform-style: preserve-3d;
    will-change: transform, border-color, background-color;
  }
  .tile-option:hover {
    border-color: rgba(212, 175, 55, 0.3);
    background-color: rgba(212, 175, 55, 0.04);
    transform: translateY(-2px);
  }
  .tile-option:focus-visible {
    outline: 2px solid var(--color-gold);
    outline-offset: 2px;
  }
  .tile-option:active {
    transform: translateY(0) scale(0.98);
  }

  /* Revelado hacia abajo (evita sensación de contenido que “sube”) */
  .contact-wizard .animate-sweep {
    animation: wizardRevealDown 0.25s ease-out;
  }

  @keyframes wizardRevealDown {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-wizard .animate-sweep {
      animation: none;
    }
  }
</style>

<script>
  // @ts-nocheck
  (function initContactWizards() {
    const PLAN_SERVICES = {
      venta_rapida: ['web'],
      autoridad_google: ['web', 'seo_geo'],
      dominio_total: ['web', 'seo_geo'],
      impulso_captacion: ['web'],
      sistema_web_inteligente: ['web', 'seo_geo'],
      arquitectura_ia_comercial: ['web', 'marketing', 'agents'],
    };

    const SERVICIO_MAP = {
      'agentes-ia': 'agents',
      'ai-marketing': 'marketing',
      webapps: 'webapps',
      'avatares-ia': 'avatars',
      'seo-geo': 'seo_geo',
      web: 'web',
      'consultoria-inteligencia-artificial': 'consultoria',
      'auditoria-ia-marketing-seo-geo': 'audit',
    };

    const LEGACY_PRIORITY_MAP = {
      invisibility: 'visibility',
      conversion: 'conversion_leads',
      trust: 'conversion_leads',
      tech: 'visibility',
      launch_presence: 'web_launch',
      get_found_google: 'visibility',
      ai_visibility: 'visibility',
      automate_leads: 'automation',
    };

    const PRIORITY_CONFIG = {
      diagnostic: { preselect: ['audit', 'seo_geo', 'marketing'], filter: ['audit', 'seo_geo', 'marketing', 'consultoria'] },
      visibility: { preselect: ['seo_geo'], filter: ['seo_geo', 'web', 'marketing', 'audit'] },
      conversion_leads: { preselect: ['web', 'marketing'], filter: ['web', 'marketing', 'seo_geo', 'agents'] },
      marketing_ai: { preselect: ['marketing'], filter: ['marketing', 'seo_geo', 'web', 'avatars'] },
      automation: { preselect: ['agents'], filter: ['agents', 'webapps', 'marketing', 'web'] },
      custom_platform: { preselect: ['webapps'], filter: ['webapps', 'agents', 'web'] },
      video_avatar: { preselect: ['avatars'], filter: ['avatars', 'marketing', 'web'] },
      strategy: { preselect: ['consultoria'], filter: ['consultoria', 'audit', 'marketing', 'agents'] },
      web_launch: { preselect: ['web'], filter: ['web', 'seo_geo', 'marketing', 'audit'] },
      not_sure: { preselect: ['audit', 'seo_geo'], filter: null },
    };

    const ALL_SERVICES = ['web', 'seo_geo', 'agents', 'webapps', 'marketing', 'avatars', 'consultoria', 'audit'];

    const setFieldError = (field, hasError) => {
      if (!field) return;
      if (hasError) {
        field.classList.add('input-field--error');
        field.setAttribute('aria-invalid', 'true');
      } else {
        field.classList.remove('input-field--error');
        field.removeAttribute('aria-invalid');
      }
    };

    document.querySelectorAll('[data-contact-wizard]').forEach((root) => {
      const wizardId = root.dataset.contactWizard;
      let currentStep = 1;
      const totalSteps = 4;

      const qs = (sel) => root.querySelector(sel);

      const showFormStatus = (message, type) => {
        const el = qs('[data-wizard-form-status]');
        if (!el) return;
        el.textContent = message;
        el.classList.remove(
          'hidden',
          'border-red-500/50',
          'bg-red-500/10',
          'text-red-300',
          'border-gold/50',
          'bg-gold/10',
          'text-gold'
        );
        if (type === 'error') {
          el.classList.add('border-red-500/50', 'bg-red-500/10', 'text-red-300');
        } else {
          el.classList.add('border-gold/50', 'bg-gold/10', 'text-gold');
        }
      };

      const hideFormStatus = () => {
        const el = qs('[data-wizard-form-status]');
        if (el) el.classList.add('hidden');
      };

      const scrollWizardIntoView = () => {
        const anchor = qs('[data-wizard-scroll-anchor]') || root;
        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        anchor.scrollIntoView({
          behavior: prefersReducedMotion ? 'auto' : 'smooth',
          block: 'start',
        });
      };

      const focusStepTitle = () => {
        const title = qs(`[data-wizard-step-title="${currentStep}"]`);
        if (title) {
          title.setAttribute('tabindex', '-1');
          title.focus({ preventScroll: true });
        }
      };

      const updateUI = (shouldFocus = false) => {
        root.querySelectorAll('.step-content').forEach((el) => el.classList.remove('active'));
        qs(`.step-content[data-step="${currentStep}"]`)?.classList.add('active');

        const prevBtn = qs('[data-wizard-prev]');
        const nextBtn = qs('[data-wizard-next]');
        const submitBtn = qs('[data-wizard-submit]');

        if (currentStep === 1) {
          prevBtn?.classList.add('hidden');
        } else {
          prevBtn?.classList.remove('hidden');
        }

        if (currentStep === totalSteps) {
          nextBtn?.classList.add('hidden');
          submitBtn?.classList.remove('hidden');
          submitBtn?.classList.add('flex');
        } else {
          nextBtn?.classList.remove('hidden');
          submitBtn?.classList.add('hidden');
          submitBtn?.classList.remove('flex');
        }

        const progress = Math.round(((currentStep - 1) / (totalSteps - 1)) * 100);
        const bar = qs('[data-wizard-progress-bar]');
        const percent = qs('[data-wizard-progress-percent]');
        const indicator = qs('[data-wizard-step-indicator]');
        const track = qs('[data-wizard-progress-track]');

        if (bar) bar.style.width = `${progress}%`;
        if (percent) percent.textContent = `${progress}%`;
        if (indicator) indicator.textContent = `Paso ${currentStep} de ${totalSteps}`;
        if (track) track.setAttribute('aria-valuenow', String(progress));

        if (shouldFocus) {
          scrollWizardIntoView();
          requestAnimationFrame(() => focusStepTitle());
        }
      };

      const scrollBranchBlockIntoView = (block) => {
        if (!block || block.classList.contains('hidden')) return;
        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        requestAnimationFrame(() => {
          block.scrollIntoView({
            behavior: prefersReducedMotion ? 'auto' : 'smooth',
            block: 'nearest',
          });
        });
      };

      const toggleWebsiteUrl = (value) => {
        const urlDiv = document.getElementById(`${wizardId}-website-url`);
        const input = urlDiv?.querySelector('input');

        if (value === 'yes' || value === 'old') {
          urlDiv?.classList.remove('hidden');
          urlDiv?.classList.add('animate-sweep');
          scrollBranchBlockIntoView(urlDiv);
          if (value === 'yes') {
            input?.setAttribute('required', '');
          } else {
            input?.removeAttribute('required');
          }
        } else {
          urlDiv?.classList.add('hidden');
          if (input) {
            input.removeAttribute('required');
            input.value = '';
            setFieldError(input, false);
          }
        }
      };

      const clearTileGroup = (name) => {
        const hiddenInput = qs(`input[name="${name}"]`);
        if (hiddenInput) hiddenInput.value = '';
        root.querySelectorAll(`.tile-option[data-tile-name="${name}"]`).forEach((t) => {
          t.classList.remove('border-gold/50', 'bg-gold/5', 'shadow-lg', 'shadow-gold/2');
          t.classList.add('border-white/5', 'bg-matte/45');
        });
        qs(`[data-wizard-${name}-error]`)?.classList.add('hidden');
        qs(`[data-wizard-${name}-group]`)?.classList.remove('services-group--error');
      };

      const getHasWebsite = () => qs('input[name="has_website"]')?.value || '';

      const getPriorityValues = () => {
        const hasWebsite = getHasWebsite();
        let raw = '';
        if (hasWebsite === 'no') raw = qs('input[name="primary_goal"]')?.value || '';
        else if (hasWebsite === 'yes' || hasWebsite === 'old') raw = qs('input[name="obstacle"]')?.value || '';
        return raw
          .split(',')
          .map((s) => s.trim())
          .filter(Boolean);
      };

      const setPriorityValues = (values) => {
        const joined = [...new Set(values)].join(',');
        const goalInput = qs('input[name="primary_goal"]');
        const obstacleInput = qs('input[name="obstacle"]');
        const hasWebsite = getHasWebsite();
        if (hasWebsite === 'no') {
          if (goalInput) goalInput.value = joined;
          if (obstacleInput) obstacleInput.value = '';
        } else if (hasWebsite === 'yes' || hasWebsite === 'old') {
          if (obstacleInput) obstacleInput.value = joined;
          if (goalInput) goalInput.value = '';
        }
      };

      const syncPriorityTileStyles = () => {
        const selected = new Set(getPriorityValues());
        root.querySelectorAll('.tile-option[data-tile-name="priority"]').forEach((tile) => {
          const value = tile.getAttribute('data-tile-value');
          const isOn = value && selected.has(value);
          tile.classList.toggle('border-gold/50', isOn);
          tile.classList.toggle('bg-gold/5', isOn);
          tile.classList.toggle('shadow-lg', isOn);
          tile.classList.toggle('shadow-gold/2', isOn);
          tile.classList.toggle('border-white/5', !isOn);
          tile.classList.toggle('bg-matte/45', !isOn);
          tile.setAttribute('aria-pressed', isOn ? 'true' : 'false');
        });
      };

      const togglePriorityValue = (value) => {
        const selected = getPriorityValues();
        const idx = selected.indexOf(value);
        if (idx >= 0) selected.splice(idx, 1);
        else selected.push(value);
        setPriorityValues(selected);
        syncPriorityTileStyles();
      };

      const syncPriorityTilesVisibility = () => {
        const showLaunch = getHasWebsite() === 'no';
        root.querySelectorAll('[data-priority-no-web-only]').forEach((tile) => {
          tile.classList.toggle('hidden', !showLaunch);
        });
      };

      const clearPrioritySelection = () => {
        setPriorityValues([]);
        syncPriorityTileStyles();
        qs('[data-wizard-priority-error]')?.classList.add('hidden');
        qs('[data-wizard-priority-group]')?.classList.remove('services-group--error');
      };

      const toggleBranchBlocks = (value) => {
        const priorityBlock = qs('[data-wizard-priority-block]');

        if (value) {
          priorityBlock?.classList.remove('hidden');
          priorityBlock?.classList.add('animate-sweep');
          clearPrioritySelection();
          syncPriorityTilesVisibility();
          scrollBranchBlockIntoView(priorityBlock);
        } else {
          priorityBlock?.classList.add('hidden');
          clearPrioritySelection();
        }

        toggleWebsiteUrl(value);
      };

      const applyServiceRecommendations = (options = {}) => {
        const { preserveChecked = false } = options;
        const priorityKeys = getPriorityValues();
        const grid = qs('[data-wizard-services-grid]');
        const hint = qs('[data-wizard-services-hint]');

        if (!grid) return;

        let visibleServices = ALL_SERVICES;
        let preselect = [];
        let order = ALL_SERVICES;

        if (priorityKeys.length > 0) {
          const preselectSet = new Set();
          let showAll = false;
          const visibleSet = new Set();

          priorityKeys.forEach((key) => {
            const cfg = PRIORITY_CONFIG[key];
            if (!cfg) return;
            cfg.preselect.forEach((s) => preselectSet.add(s));
            if (cfg.filter === null) showAll = true;
            else cfg.filter.forEach((s) => visibleSet.add(s));
          });

          preselect = [...preselectSet];
          visibleServices = showAll ? ALL_SERVICES : [...visibleSet];
          order = [...preselect, ...ALL_SERVICES.filter((s) => !preselect.includes(s))];

          if (hint) {
            hint.textContent =
              priorityKeys.includes('not_sure') || priorityKeys.length > 1
                ? 'Servicios sugeridos según lo que nos contaste. Puedes ajustar la selección.'
                : 'Servicios sugeridos según tu situación. Puedes seleccionar varias.';
          }
        } else if (hint) {
          hint.textContent = 'Puedes seleccionar varias opciones.';
        }

        ALL_SERVICES.forEach((service) => {
          const item = grid.querySelector(`[data-service-item="${service}"]`);
          if (item) {
            item.classList.toggle('hidden', !visibleServices.includes(service));
          }
        });

        order.forEach((service) => {
          const item = grid.querySelector(`[data-service-item="${service}"]`);
          if (item) grid.appendChild(item);
        });

        if (!preserveChecked) {
          root.querySelectorAll('input[name="services"]').forEach((cb) => {
            cb.checked = preselect.includes(cb.value);
          });
        } else {
          preselect.forEach((val) => {
            const cb = root.querySelector(`input[name="services"][value="${val}"]`);
            if (cb && !root.querySelectorAll('input[name="services"]:checked').length) {
              cb.checked = true;
            }
          });
        }

        validateServices();
      };

      // Handle interactive tile option clicks
      root.querySelectorAll('.tile-option').forEach(tile => {
        tile.addEventListener('click', (e) => {
          e.preventDefault();
          const name = tile.getAttribute('data-tile-name');
          const value = tile.getAttribute('data-tile-value');

          if (name === 'priority' && value) {
            togglePriorityValue(value);
            setFieldError(qs('input[name="primary_goal"]'), false);
            setFieldError(qs('input[name="obstacle"]'), false);
            qs('[data-wizard-priority-error]')?.classList.add('hidden');
            qs('[data-wizard-priority-group]')?.classList.remove('services-group--error');
            applyServiceRecommendations({ preserveChecked: true });
            return;
          }

          const hiddenInput = qs(`input[name="${name}"]`);
          if (hiddenInput) {
            hiddenInput.value = value;
            setFieldError(hiddenInput, false);

            const errEl = qs(`[data-wizard-${name}-error]`);
            if (errEl) errEl.classList.add('hidden');
            const group = qs(`[data-wizard-${name}-group]`);
            if (group) group.classList.remove('services-group--error');
          }

          root.querySelectorAll(`.tile-option[data-tile-name="${name}"]`).forEach(t => {
            t.classList.remove('border-gold/50', 'bg-gold/5', 'shadow-lg', 'shadow-gold/2');
            t.classList.add('border-white/5', 'bg-matte/45');
          });

          tile.classList.remove('border-white/5', 'bg-matte/45');
          tile.classList.add('border-gold/50', 'bg-gold/5', 'shadow-lg', 'shadow-gold/2');

          if (name === 'has_website') {
            toggleBranchBlocks(value);
            applyServiceRecommendations({ preserveChecked: true });
          }
        });
      });

      const validateServices = () => {
        const checked = root.querySelectorAll('input[name="services"]:checked');
        const errEl = qs('[data-wizard-services-error]');
        const group = qs('[data-wizard-services-group]');
        const valid = checked.length > 0;

        if (errEl) {
          if (!valid) {
            errEl.textContent = 'Seleccione al menos un servicio.';
            errEl.classList.remove('hidden');
          } else {
            errEl.classList.add('hidden');
          }
        }
        group?.classList.toggle('services-group--error', !valid);
        return valid;
      };

      const validateStep = (step) => {
        hideFormStatus();
        const stepContent = qs(`.step-content[data-step="${step}"]`);
        if (!stepContent) return false;

        let isValid = true;
        const fields = stepContent.querySelectorAll('input, select, textarea');

        fields.forEach((field) => {
          if (field.type === 'checkbox' && field.name === 'services') return;
          if (field.type === 'hidden' || field.classList.contains('honeypot-field')) return;

          const isRequired =
            field.hasAttribute('required') ||
            (field.name === 'current_website' && qs('input[name="has_website"]')?.value === 'yes');

          if (!isRequired) {
            setFieldError(field, false);
            return;
          }

          const fieldValid = field.checkValidity() && field.value !== '';
          setFieldError(field, !fieldValid);
          if (!fieldValid) isValid = false;
        });

        // Hidden input validations for step 1 router
        if (step === 1) {
          const hasWebInput = qs('input[name="has_website"]');
          const hasWebValue = hasWebInput?.value || '';
          const hasWebValid = hasWebValue !== '';
          const hasWebGroup = qs('[data-wizard-has_website-group]');
          const hasWebErr = qs('[data-wizard-has_website-error]');

          if (!hasWebValid) {
            isValid = false;
            hasWebGroup?.classList.add('services-group--error');
            if (hasWebErr) {
              hasWebErr.textContent = 'Seleccione una opción sobre su web.';
              hasWebErr.classList.remove('hidden');
            }
          } else {
            hasWebGroup?.classList.remove('services-group--error');
            hasWebErr?.classList.add('hidden');
          }

          const priorityValid = getPriorityValues().length > 0;
          const priorityGroup = qs('[data-wizard-priority-group]');
          const priorityErr = qs('[data-wizard-priority-error]');
          if (hasWebValue && !priorityValid) {
            isValid = false;
            priorityGroup?.classList.add('services-group--error');
            if (priorityErr) {
              priorityErr.textContent = 'Selecciona al menos una situación.';
              priorityErr.classList.remove('hidden');
            }
          } else {
            priorityGroup?.classList.remove('services-group--error');
            priorityErr?.classList.add('hidden');
          }

          const urlInput = qs('input[name="current_website"]');
          if (hasWebValue === 'yes' && urlInput) {
            const urlValid = urlInput.value.trim() !== '' && urlInput.checkValidity();
            setFieldError(urlInput, !urlValid);
            if (!urlValid) isValid = false;
          }
        }

        if (step === 2) {
          if (!validateServices()) isValid = false;
        }

        if (step === 3) {
          const urgencyInput = qs('input[name="urgency"]');
          const budgetInput = qs('input[name="budget"]');
          
          const urgencyValid = urgencyInput && urgencyInput.value !== '';
          const budgetValid = budgetInput && budgetInput.value !== '';
          
          if (!urgencyValid) {
            isValid = false;
            qs('[data-wizard-urgency-group]')?.classList.add('services-group--error');
            const err = qs('[data-wizard-urgency-error]');
            if (err) {
              err.textContent = 'Seleccione una fecha de inicio.';
              err.classList.remove('hidden');
            }
          }
          
          if (!budgetValid) {
            isValid = false;
            qs('[data-wizard-budget-group]')?.classList.add('services-group--error');
            const err = qs('[data-wizard-budget-error]');
            if (err) {
              err.textContent = 'Seleccione la escala actual de su operación.';
              err.classList.remove('hidden');
            }
          }
        }

        return isValid;
      };

      qs('[data-wizard-next]')?.addEventListener('click', () => {
        if (validateStep(currentStep) && currentStep < totalSteps) {
          if (currentStep === 1) {
            const hasExistingServices = root.querySelectorAll('input[name="services"]:checked').length > 0;
            applyServiceRecommendations({ preserveChecked: hasExistingServices });
          }
          currentStep++;
          updateUI(true);
        } else if (!validateStep(currentStep)) {
          showFormStatus('Revise los campos marcados antes de continuar.', 'error');
        }
      });

      qs('[data-wizard-prev]')?.addEventListener('click', () => {
        if (currentStep > 1) {
          currentStep--;
          hideFormStatus();
          updateUI(true);
        }
      });

      qs('[data-wizard-submit]')?.addEventListener('click', async () => {
        if (!validateStep(currentStep)) {
          showFormStatus('Revise los campos marcados antes de enviar.', 'error');
          return;
        }

        const form = qs('[data-wizard-form]');
        const formData = new FormData(form);
        const selectedServices = formData.getAll('services');

        const data = {
          name: formData.get('name'),
          email: formData.get('email'),
          company: formData.get('company'),
          role: formData.get('role') || 'No especificado',
          phone: formData.get('phone') || '',
          obstacle: formData.get('obstacle') || '',
          primary_goal: formData.get('primary_goal') || '',
          value_prop: formData.get('value_prop') || '',
          has_website: formData.get('has_website'),
          current_website: formData.get('current_website') || '',
          services: selectedServices,
          urgency: formData.get('urgency'),
          budget: formData.get('budget'),
          tool: 'none', // Hardcoded none since notion field is trimmed from UI
          consent: formData.get('consent') === '1',
          bot_field: formData.get('bot_field') || '',
          source_page: formData.get('source_page') || '',
          utm_source: formData.get('utm_source') || '',
          utm_medium: formData.get('utm_medium') || '',
          utm_campaign: formData.get('utm_campaign') || '',
          plan: formData.get('plan') || '',
          servicio: formData.get('servicio') || '',
          problem: formData.get('problem') || '',
          demo: formData.get('demo') || '',
          referrer: formData.get('referrer') || '',
        };

        const submitBtn = qs('[data-wizard-submit]');
        const originalHtml = submitBtn.innerHTML;
        submitBtn.innerHTML =
          '<i class="fa-solid fa-spinner fa-spin text-base" aria-hidden="true"></i> Enviando...';
        submitBtn.disabled = true;
        hideFormStatus();

        const MAKE_WEBHOOK_URL = 'https://hook.us2.make.com/px6jolmk7ekqxg5lyq9bq4x0l5uaj0ja';
        let submitSucceeded = false;

        try {
          // Paso 1: validar datos en el servidor
          const response = await fetch('/api/submit', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data),
          });

          let result = {};
          try {
            result = await response.json();
          } catch {
            /* respuesta no JSON */
          }

          if (!response.ok) {
            const serverMsg =
              typeof result.error === 'string' && result.error.trim()
                ? result.error.trim()
                : 'Hubo un problema al enviar. Intenta de nuevo o escríbeme por WhatsApp.';
            showFormStatus(serverMsg, 'error');
            return;
          }

          // Paso 2: enviar el payload estructurado al webhook de Make directamente desde el browser
          const webhookPayload = result.webhookPayload || {};
          const makeResponse = await fetch(MAKE_WEBHOOK_URL, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(webhookPayload),
          });

          if (!makeResponse.ok) {
            console.error('Make webhook error:', makeResponse.status);
            showFormStatus(
              'Hubo un problema al enviar. Intenta de nuevo o escríbeme por WhatsApp.',
              'error'
            );
            return;
          }

          // Éxito total
          submitSucceeded = true;
          submitBtn.innerHTML =
            '<i class="fa-solid fa-check text-base" aria-hidden="true"></i> Recibido';

          // Dispatch conversion custom event for analytics tracking
          window.dispatchEvent(new CustomEvent('lead_converted', { detail: { company: data.company || '' } }));

          setTimeout(() => {
            const form = qs('[data-wizard-form]');
            const progressTrack = qs('[data-wizard-scroll-anchor]');
            const successState = qs('[data-wizard-success-state]');

            if (form) form.classList.add('hidden');
            if (progressTrack) progressTrack.classList.add('hidden');

            if (successState) {
              const namePlaceholder = successState.querySelector('[data-user-name-placeholder]');
              if (namePlaceholder) {
                namePlaceholder.textContent = String(data.name || 'Invitado').trim();
              }

              const waLink = successState.querySelector('[data-wizard-success-wa-link]');
              if (waLink) {
                const userName = String(data.name || '').trim();
                const waBase = 'https://wa.me/5213324239103';
                const greetingMsg = userName ? `, me llamo ${userName} y acabo de` : ' y acabo de';
                const waText = encodeURIComponent(
                  `¡Hola Tap-IA! Acabo de enviar mi diagnóstico por la web${greetingMsg} enviar mi diagnóstico. Si andas por ahí, me gustaría que empecemos a rebotar ideas por aquí de una vez. ¡Gracias!`
                );
                waLink.href = `${waBase}?text=${waText}`;
              }

              successState.classList.remove('hidden');
              successState.focus();
            }

            scrollWizardIntoView();
          }, 400);

        } catch (err) {
          console.error(err);
          showFormStatus(
            'No pudimos conectar con el servidor. Intenta de nuevo o escríbeme por WhatsApp.',
            'error'
          );
        } finally {
          if (!submitSucceeded) {
            submitBtn.innerHTML = originalHtml;
            submitBtn.disabled = false;
          }
        }
      });

      const urlParams = new URLSearchParams(window.location.search);
      const getAttr = (key) => qs(`[data-attr="${key}"]`)?.value || '';

      const problemParam = urlParams.get('problem') || getAttr('problem');
      if (problemParam) {
        const mappedPriority = LEGACY_PRIORITY_MAP[problemParam] || problemParam;
        const hasWebTile = root.querySelector('.tile-option[data-tile-name="has_website"][data-tile-value="yes"]');
        if (hasWebTile && !qs('input[name="has_website"]')?.value) hasWebTile.click();
        if (!getPriorityValues().includes(mappedPriority)) {
          togglePriorityValue(mappedPriority);
        }
        applyServiceRecommendations({ preserveChecked: true });
      }

      const planParam = urlParams.get('plan') || getAttr('plan');
      if (planParam && PLAN_SERVICES[planParam]) {
        PLAN_SERVICES[planParam].forEach((val) => {
          const cb = root.querySelector(`input[name="services"][value="${val}"]`);
          if (cb) cb.checked = true;
        });
        
        // Match the pricing plan to the pre-selected scale (budget)
        let budgetVal = '';
        if (planParam === 'impulso_captacion') budgetVal = 'captacion';
        else if (planParam === 'sistema_web_inteligente') budgetVal = 'sistema';
        else if (planParam === 'arquitectura_ia_comercial') budgetVal = 'arquitectura';
        
        if (budgetVal) {
          const budgetTile = root.querySelector(`.tile-option[data-tile-name="budget"][data-tile-value="${budgetVal}"]`);
          if (budgetTile) budgetTile.click();
        }
      }

      const servicioParam = urlParams.get('servicio') || getAttr('servicio');
      const serviceVal = SERVICIO_MAP[servicioParam];
      if (serviceVal) {
        const cb = root.querySelector(`input[name="services"][value="${serviceVal}"]`);
        if (cb) cb.checked = true;
      }

      if (urlParams.get('demo') === 'agent-waitlist' || getAttr('demo') === 'agent-waitlist') {
        const cb = root.querySelector('input[name="services"][value="agents"]');
        if (cb) cb.checked = true;
      }

      const sourceEl = qs('[data-attr="source_page"]');
      if (sourceEl) sourceEl.value = window.location.pathname + window.location.search;
      const refEl = qs('[data-attr="referrer"]');
      if (refEl) refEl.value = document.referrer || '';

      ['utm_source', 'utm_medium', 'utm_campaign'].forEach((key) => {
        const val = urlParams.get(key);
        const el = qs(`[data-attr="${key}"]`);
        if (el && val) el.value = val;
      });

      updateUI();
      
      // Global interface hook to trigger options pre-selection on click of pricing CTA buttons
      window.addEventListener('selectContactWizardPlan', (e) => {
        const selectedPlan = e.detail?.plan;
        if (!selectedPlan) return;
        
        // Clean checks
        root.querySelectorAll('input[name="services"]').forEach(cb => cb.checked = false);
        
        // Auto check services
        if (PLAN_SERVICES[selectedPlan]) {
          PLAN_SERVICES[selectedPlan].forEach(val => {
            const cb = root.querySelector(`input[name="services"][value="${val}"]`);
            if (cb) cb.checked = true;
          });
        }
        
        // Set scale
        let budgetVal = '';
        if (selectedPlan === 'impulso_captacion') budgetVal = 'captacion';
        else if (selectedPlan === 'sistema_web_inteligente') budgetVal = 'sistema';
        else if (selectedPlan === 'arquitectura_ia_comercial') budgetVal = 'arquitectura';
        
        if (budgetVal) {
          const budgetTile = root.querySelector(`.tile-option[data-tile-name="budget"][data-tile-value="${budgetVal}"]`);
          if (budgetTile) budgetTile.click();
        }
      });
    });
  })();
</script>
