---
// src/components/TapIALiquidGradient.astro
// Efecto de gradiente líquido animado para el Hero de Tap-IA.
// Solo animación automática, sin interactividad de ratón/toque.
// Paleta: Charcoal #0a0b0e, Matte #16191f, Navy #1a2744 + #2563eb — profundidad tecnológica
---

<div id="liquid-gradient-container">
    <canvas id="webGLApp"></canvas>
</div>

<style>
    #liquid-gradient-container {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        z-index: -5;
        pointer-events: none;
        overflow: hidden;
        /* Promoción a capa de hardware (GPU) y contención de pintura */
        transform: translate3d(0, 0, 0);
        will-change: transform;
        contain: strict;
    }
    #webGLApp {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
    }
</style>

<script>
    import * as THREE from 'three';

    const initLiquidGradient = () => {
        try {
            if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

            const canvas = document.getElementById('webGLApp') as HTMLCanvasElement;
            if (!canvas) return;

            // Hex a RGB normalizado (0-1)
            const hex = (r: number, g: number, b: number) => new THREE.Vector3(r / 255, g / 255, b / 255);

            // Paleta Tap-IA — Rebalanceada para combinar Oro Premium y Azul Tecnológico B2B
            const CHARCOAL    = hex(10, 11, 14);      // #0a0b0e — fondo dominante de la marca
            const GOLD_DEEP   = hex(120, 95, 25);     // Oro profundo para profundidad cálida
            const GOLD_SOFT   = hex(212, 175, 55);    // #d4af37 — oro de marca (alta sofisticación)
            const SLATE_BLUE  = hex(30, 58, 105);     // #1e3a69 — azul pizarra para transición y volumen
            const NAVY_DEEP   = hex(26, 39, 68);      // #1a2744 — azul marino premium para autoridad B2B
            const TECH_BLUE   = hex(37, 99, 235);     // #2563eb — azul tecnológico vibrante
            const BLUE_GLOW   = hex(15, 40, 95);      // Brillo azul profundo de cierre

            const uniforms: Record<string, { value: any }> = {
                uTime:       { value: 0 },
                uResolution: { value: new THREE.Vector2(window.innerWidth, window.innerHeight) },
                // Mezcla balanceada a favor de azules/pizarra para profundidad visual premium
                uColor1:     { value: GOLD_DEEP.clone() },   // Halo oro principal (acento)
                uColor2:     { value: TECH_BLUE.clone() },   // Halo azul tecnológico vibrante
                uColor3:     { value: SLATE_BLUE.clone() },  // Azul pizarra de transición y volumen
                uColor4:     { value: NAVY_DEEP.clone() },   // Azul B2B de alta autoridad
                uColor5:     { value: GOLD_SOFT.clone() },   // Oro firma (acento puntual)
                uColor6:     { value: BLUE_GLOW.clone() },   // Glow azul profundo de cierre
                uBase:       { value: CHARCOAL.clone() },
                uSpeed:      { value: 0.15 },    // Calibrado a 0.15 para una fluidez premium majestuosa
                uIntensity:  { value: 0.48 },    // Reducido de 0.65 para evitar saturación y mantener contraste WCAG
                uGrain:      { value: 0.012 },   // Ruido sutil para textura
            };

        const vertexShader = `
            varying vec2 vUv;
            void main() {
                gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
                vUv = uv;
            }
        `;

        const fragmentShader = `
            precision mediump float;

            uniform float uTime;
            uniform vec2  uResolution;
            uniform vec3  uColor1;
            uniform vec3  uColor2;
            uniform vec3  uColor3;
            uniform vec3  uColor4;
            uniform vec3  uColor5;
            uniform vec3  uColor6;
            uniform vec3  uBase;
            uniform float uSpeed;
            uniform float uIntensity;
            uniform float uGrain;

            varying vec2 vUv;

            float hash(vec2 p) {
                return fract(sin(dot(p, vec2(12.9898, 78.233))) * 43758.5453);
            }

            void main() {
                vec2 uv = vUv;
                float t = uTime * uSpeed;

                // 6 centros con curvas de Lissajous complejas (frecuencias diferenciales y coprimas para evitar el movimiento mecánico circular)
                vec2 c1 = vec2(0.20 + sin(t * 0.45) * 0.12, 0.80 + cos(t * 0.32) * 0.12); // Top-Left Lissajous
                vec2 c2 = vec2(0.80 + cos(t * 0.38) * 0.12, 0.80 + sin(t * 0.50) * 0.12); // Top-Right Lissajous
                vec2 c3 = vec2(0.18 + sin(t * 0.28 + 1.57) * 0.10, 0.48 + cos(t * 0.42) * 0.10); // Mid-Left Lissajous
                vec2 c4 = vec2(0.82 + cos(t * 0.46 + 3.14) * 0.10, 0.48 + sin(t * 0.34) * 0.10); // Mid-Right Lissajous
                vec2 c5 = vec2(0.35 + sin(t * 0.52 + 4.71) * 0.11, 0.22 + cos(t * 0.36) * 0.11); // Bottom-Left-Center Lissajous
                vec2 c6 = vec2(0.65 + cos(t * 0.30 + 2.00) * 0.11, 0.22 + sin(t * 0.48) * 0.11); // Bottom-Right-Center Lissajous

                // Radios calibrados individualmente (azul domina el espacio volumétrico, oro es acento puntual)
                float r1 = 0.55; // Oro principal (acento focal concentrado)
                float r2 = 0.95; // Tech blue (amplio para teñir el fondo y dar vitalidad tech)
                float r3 = 0.85; // Slate blue de transición (amplio y suave)
                float r4 = 1.15; // Navy deep (muy amplio para establecer la atmósfera base B2B)
                float r5 = 0.45; // Oro firma (acento sutil muy puntual)
                float r6 = 0.90; // Blue glow (soporte amplio y profundo)

                float i1 = 1.0 - smoothstep(0.0, r1, length(uv - c1));
                float i2 = 1.0 - smoothstep(0.0, r2, length(uv - c2));
                float i3 = 1.0 - smoothstep(0.0, r3, length(uv - c3));
                float i4 = 1.0 - smoothstep(0.0, r4, length(uv - c4));
                float i5 = 1.0 - smoothstep(0.0, r5, length(uv - c5));
                float i6 = 1.0 - smoothstep(0.0, r6, length(uv - c6));

                // Modulación temporal de pesos balanceada para priorizar el ambiente azul (sesgo matemático 3.46x)
                float w1 = i1 * (0.35 + 0.35 * sin(t * 0.9)); // GOLD_DEEP (acento concentrado)
                float w2 = i2 * (0.65 + 0.65 * cos(t * 1.1)); // TECH_BLUE (soporte principal vibrante)
                float w3 = i3 * (0.50 + 0.50 * sin(t * 0.7)); // SLATE_BLUE (transición suave)
                float w4 = i4 * (0.65 + 0.65 * cos(t * 1.3)); // NAVY_DEEP (base volumétrica)
                float w5 = i5 * (0.28 + 0.28 * sin(t * 1.0)); // GOLD_SOFT (destello firma sutil)
                float w6 = i6 * (0.52 + 0.52 * cos(t * 0.8)); // BLUE_GLOW (soporte profundo)

                // Mezcla de colores normalizada para evitar sobre-saturación cuando se traslapan
                float totalWeight = w1 + w2 + w3 + w4 + w5 + w6 + 0.001;
                vec3 blendedGlow = (uColor1 * w1 + uColor2 * w2 + uColor3 * w3 + uColor4 * w4 + uColor5 * w5 + uColor6 * w6) / totalWeight;

                // Intensidad máxima local para el factor de mezcla (evita blowouts)
                float maxIntensity = max(max(max(w1, w2), max(w3, w4)), max(w5, w6));

                // Aureola central completamente dinámica: deriva del centro con frecuencias coprimas, rotación elíptica asimétrica y respiración de escala
                vec2 radialCenter = vec2(
                    0.50 + sin(t * 0.22) * 0.06,
                    0.50 + cos(t * 0.16) * 0.06
                );
                vec2 rv = uv - radialCenter;
                float a = t * 0.12;
                rv = vec2(rv.x * cos(a) - rv.y * sin(a), rv.x * sin(a) + rv.y * cos(a));
                
                // Ruptura de simetría (anisotropía): deformación elíptica para que la rotación sea visible y respire orgánicamente
                float breathingRatio = 1.25 + sin(t * 0.40) * 0.15;
                rv.x *= breathingRatio;
                
                float radialScale = 0.85 + sin(t * 0.30) * 0.08;
                float radial = 1.0 - smoothstep(0.0, radialScale, length(rv));

                // Mezcla calibrada: Charcoal domina pero los halos son visibles sin quemarse
                float mix_f = clamp(maxIntensity * uIntensity, 0.0, 0.50);
                vec3 color = mix(uBase, blendedGlow, mix_f);

                // Añadimos el toque de aureola radial de forma sutil usando azul tecnológico para contrastar el fondo
                color += uColor2 * radial * 0.035;

                // Film grain sutil
                float grain = hash(uv * uResolution + uTime) * 2.0 - 1.0;
                color += grain * uGrain;

                color = clamp(color, vec3(0.0), vec3(1.0));
                gl_FragColor = vec4(color, 1.0);
            }
        `;

        // Renderer
        const renderer = new THREE.WebGLRenderer({
            canvas,
            antialias: false,
            powerPreference: 'default',
            alpha: false,
        });
        renderer.setSize(window.innerWidth, window.innerHeight);
        // Lock pixel ratio a 1.0 para un rendimiento de fill-rate excepcional a 60fps (visualmente imperceptible en gradientes difuminados)
        renderer.setPixelRatio(Math.min(window.devicePixelRatio, 1.0));

        const camera = new THREE.PerspectiveCamera(45, window.innerWidth / window.innerHeight, 0.1, 100);
        camera.position.z = 50;

        const scene = new THREE.Scene();

        // Plano que ocupa toda la vista
        const fov = (camera.fov * Math.PI) / 180;
        const h = Math.abs(camera.position.z * Math.tan(fov / 2) * 2);
        const w = h * camera.aspect;
        const geometry = new THREE.PlaneGeometry(w, h, 1, 1);
        const material = new THREE.ShaderMaterial({ uniforms, vertexShader, fragmentShader });
        const mesh = new THREE.Mesh(geometry, material);
        scene.add(mesh);

        const clock = new THREE.Clock();

        // Render loop con pausa automática fuera del viewport
        const tick = () => {
            requestAnimationFrame(tick);

            if (window.scrollY > window.innerHeight * 1.5) return;

            const delta = Math.min(clock.getDelta(), 0.1);
            uniforms.uTime.value += delta;
            renderer.render(scene, camera);
        };

        tick();

        // Resize
        const onResize = () => {
            const width = window.innerWidth;
            const height = window.innerHeight;
            camera.aspect = width / height;
            camera.updateProjectionMatrix();
            renderer.setSize(width, height);
            uniforms.uResolution.value.set(width, height);

            const newH = Math.abs(camera.position.z * Math.tan(fov / 2) * 2);
            const newW = newH * camera.aspect;
            mesh.geometry.dispose();
            mesh.geometry = new THREE.PlaneGeometry(newW, newH, 1, 1);
        };

        window.addEventListener('resize', onResize, { passive: true });
        } catch (e) {
            console.warn("WebGL Gradient failed to initialize:", e);
        }
    };

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initLiquidGradient);
    } else {
        initLiquidGradient();
    }
</script>
