---
// src/components/WhatsAppFloat.astro
// Botón flotante premium de WhatsApp integrado con la identidad de marca Tap-IA.

const phoneNumber = "523324239103";
const message = "¡Hola Tap-IA! Vi tu página y me gustaría platicar contigo directamente para contarte de mi proyecto y ver cómo me puedes ayudar. ¡Gracias!";
const whatsappUrl = `https://wa.me/${phoneNumber}?text=${encodeURIComponent(message)}`;
---

<a 
  href={whatsappUrl}
  target="_blank"
  rel="noopener noreferrer"
  class="whatsapp-float group fixed bottom-6 right-6 z-[999] flex items-center justify-center w-14 h-14 rounded-full bg-[#25D366] border-2 border-[#1da851] shadow-[0_8px_30px_rgba(0,0,0,0.5),0_0_20px_rgba(37,211,102,0.3)] transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] hover:scale-110 hover:-translate-y-1 hover:bg-[#20c45c] hover:shadow-[0_0_35px_rgba(37,211,102,0.55)] focus:outline-none focus:ring-2 focus:ring-[#25D366]/70 focus:ring-offset-2 focus:ring-offset-[#0a0b0e]"
  aria-label="Platicar por WhatsApp con Tap-IA"
>
  <!-- Destello: contenedor con overflow recortado al círculo -->
  <span class="absolute inset-0 rounded-full overflow-hidden pointer-events-none z-0" aria-hidden="true">
    <span class="whatsapp-shine absolute inset-0"></span>
  </span>

  <!-- Tooltip Premium Estilo Tap-IA -->
  <span class="absolute right-16 px-4 py-2 rounded-lg bg-[#0a0b0e]/95 border border-[#25D366]/30 text-white text-sm font-medium tracking-wide whitespace-nowrap opacity-0 scale-95 origin-right translate-x-2 pointer-events-none transition-all duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:opacity-100 group-hover:scale-100 group-hover:translate-x-0 shadow-[0_4px_20px_rgba(0,0,0,0.5)]">
    ¿Tienes dudas? Escríbeme directo 📲
    <span class="absolute right-[-4px] top-1/2 -translate-y-1/2 w-2 h-2 rotate-45 bg-[#0a0b0e] border-t border-r border-[#25D366]/30"></span>
  </span>

  <!-- Icono de WhatsApp — blanco sobre verde, micro-rotación al hover -->
  <svg 
    class="w-7 h-7 text-white transition-transform duration-500 group-hover:rotate-[12deg] relative z-10" 
    fill="currentColor" 
    viewBox="0 0 24 24" 
    aria-hidden="true"
  >
    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L0 24l6.335-1.662c1.746.953 3.71 1.455 5.703 1.457h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
  </svg>
</a>

<style>
  .whatsapp-float {
    /* Entrada + pulso de anillo verde encadenados */
    animation: float-entrance 0.9s cubic-bezier(0.16, 1, 0.3, 1) 1.5s both,
               pulse-ring 3s ease-in-out infinite 2.5s;
  }

  /* Destello diagonal que cruza el círculo cada ~4 s */
  .whatsapp-shine::after {
    content: '';
    position: absolute;
    top: -20%;
    left: -80%;
    width: 50%;
    height: 140%;
    background: linear-gradient(
      105deg,
      transparent 20%,
      rgba(255, 255, 255, 0.38) 50%,
      transparent 80%
    );
    transform: skewX(-18deg);
    animation: destello 4s ease-in-out infinite 3s;
  }

  @keyframes destello {
    0%   { left: -80%; opacity: 0; }
    8%   { opacity: 1; }
    38%  { left: 130%; opacity: 1; }
    45%  { left: 130%; opacity: 0; }
    100% { left: 130%; opacity: 0; }
  }

  /* Pulso: anillo verde que se expande y desvanece */
  @keyframes pulse-ring {
    0% {
      box-shadow:
        0 0 0 0   rgba(37, 211, 102, 0.50),
        0 8px 30px rgba(0, 0, 0, 0.5),
        0 0 20px  rgba(37, 211, 102, 0.30);
    }
    60% {
      box-shadow:
        0 0 0 14px rgba(37, 211, 102, 0),
        0 8px 30px rgba(0, 0, 0, 0.5),
        0 0 30px  rgba(37, 211, 102, 0.45);
    }
    100% {
      box-shadow:
        0 0 0 0   rgba(37, 211, 102, 0),
        0 8px 30px rgba(0, 0, 0, 0.5),
        0 0 20px  rgba(37, 211, 102, 0.30);
    }
  }

  /* Entrada suave desde abajo */
  @keyframes float-entrance {
    from {
      opacity: 0;
      transform: scale(0.8) translateY(20px);
    }
    to {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }

  /* Respeto a prefers-reduced-motion */
  @media (prefers-reduced-motion: reduce) {
    .whatsapp-float {
      animation: float-entrance 0.9s cubic-bezier(0.16, 1, 0.3, 1) 1.5s both;
    }
    .whatsapp-shine::after {
      display: none;
    }
  }
</style>
