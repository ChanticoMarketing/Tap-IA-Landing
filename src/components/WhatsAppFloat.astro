---
// src/components/WhatsAppFloat.astro
// Botón flotante premium de WhatsApp integrado con la identidad de marca Tap-IA.

const phoneNumber = "523324239103";
const message = "¡Hola Tap-IA! Vi tu página y me gustaría platicar contigo directamente para contarte de mi proyecto y ver cómo me puedes ayudar. ¡Gracias!";
const whatsappUrl = `https://wa.me/${phoneNumber}?text=${encodeURIComponent(message)}`;
---

<a 
  href={whatsappUrl}
  target="_blank"
  rel="noopener noreferrer"
  class="whatsapp-float group fixed bottom-6 right-6 z-[999] flex items-center justify-center w-14 h-14 rounded-full bg-matte border border-[#25D366]/40 shadow-[0_8px_30px_rgba(0,0,0,0.8),0_0_15px_rgba(37,211,102,0.15)] transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] hover:scale-110 hover:-translate-y-1 hover:border-[#25D366] hover:shadow-[0_0_30px_rgba(37,211,102,0.4)] focus:outline-none focus:ring-2 focus:ring-[#25D366]/50"
  aria-label="Platicar por WhatsApp con Tap-IA"
>
  <!-- Glow Atmosférico en Hover -->
  <span class="absolute inset-0 rounded-full bg-radial-glow opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"></span>

  <!-- Tooltip Premium Estilo Tap-IA -->
  <span class="absolute right-16 px-4 py-2 rounded-lg bg-matte/95 border border-[#25D366]/30 text-offwhite text-sm font-medium tracking-wide whitespace-nowrap opacity-0 scale-95 origin-right translate-x-2 pointer-events-none transition-all duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:opacity-100 group-hover:scale-100 group-hover:translate-x-0 shadow-[0_4px_20px_rgba(0,0,0,0.5)]">
    ¿Tienes dudas? Escríbeme directo 📲
    <span class="absolute right-[-4px] top-1/2 -translate-y-1/2 w-2 h-2 rotate-45 bg-matte border-t border-r border-[#25D366]/30"></span>
  </span>

  <!-- Icono de WhatsApp con micro-rotación al hover -->
  <svg 
    class="w-7 h-7 text-offwhite transition-transform duration-500 group-hover:rotate-[12deg] group-hover:text-[#25D366] relative z-10" 
    fill="currentColor" 
    viewBox="0 0 24 24" 
    aria-hidden="true"
  >
    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L0 24l6.335-1.662c1.746.953 3.71 1.455 5.703 1.457h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
  </svg>
</a>

<style>
  .whatsapp-float {
    background-image: linear-gradient(180deg, rgba(22, 25, 31, 0.95) 0%, rgba(10, 11, 14, 0.99) 100%);
    backdrop-filter: blur(12px);
  }
  
  .bg-radial-glow {
    background: radial-gradient(circle, rgba(37, 211, 102, 0.25) 0%, rgba(37, 211, 102, 0) 70%);
  }

  /* Animación sutil de entrada para captar atención sin ser invasiva */
  @keyframes float-entrance {
    from {
      opacity: 0;
      transform: scale(0.8) translateY(20px);
    }
    to {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }

  .whatsapp-float {
    animation: float-entrance 1s cubic-bezier(0.16, 1, 0.3, 1) 1.5s both;
  }
</style>
