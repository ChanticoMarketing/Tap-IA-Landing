---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CtaWhatsApp from '../components/CtaWhatsApp.astro';
import SchemaService from '../components/SchemaService.astro';
---

<Layout 
    title="Consultoría en Inteligencia Artificial | Estrategia y Diagnóstico | TAP-IA"
    description="Consultoría de IA para empresas. Diagnóstico de madurez, roadmap de implementación y estrategia con criterio de negocio."
>
    <Header />
    <SchemaService 
        name="Consultoría de Inteligencia Artificial"
        description="Consultoría de IA para empresas. Diagnóstico de madurez, roadmap de implementación y estrategia con criterio de negocio."
        url="/consultoria-inteligencia-artificial"
        serviceType="AI Consulting"
    />

    <section class="relative min-h-[60vh] pt-36 pb-10 px-6 flex flex-col items-center justify-center overflow-hidden">
        <div class="absolute top-20 left-1/2 -translate-x-1/2 w-[600px] h-[600px] bg-gold/5 rounded-full blur-[120px] pointer-events-none -z-10"></div>
        
        <div class="max-w-4xl mx-auto text-center relative z-10">
            <span class="editorial-label text-gold mb-6 block">Consultoría Estratégica</span>
            <h1 class="font-serif text-4xl md:text-6xl mb-6 text-white leading-tight">
                No necesitas más herramientas de IA. <span class="italic font-light text-white/60">Necesitas criterio de negocio.</span>
            </h1>
            <h2 class="text-xl text-subtle font-light max-w-2xl mx-auto mb-10 leading-relaxed">
                Ayudamos a empresas a detectar dónde la IA es una ventaja competitiva y dónde es solo ruido. Diagnóstico, estrategia y acompañamiento técnico para una implementación con pies y cabeza.
            </h2>
            <CtaWhatsApp text="Solicitar diagnóstico estratégico" microcopy="Hablamos de tu negocio, no solo de tecnología." />
        </div>
    </section>

    <!-- PROPUESTA: ESTRATEGIA ANTES QUE HERRAMIENTA -->
    <section class="py-24 px-6 relative border-t border-white/5 bg-white/[0.01]">
        <div class="max-w-5xl mx-auto">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-16 items-center">
                <div>
                    <h3 class="text-3xl md:text-4xl text-white font-light mb-8">El problema no es la tecnología, es el <span class="text-gold italic">roadmap</span>.</h3>
                    <p class="text-subtle mb-6 leading-relaxed">La mayoría de las empresas están "probando" IA de forma aislada: un chatbot por aquí, un generador de imágenes por allá. El resultado suele ser frustración, falta de retorno de inversión y equipos confundidos.</p>
                    <p class="text-subtle mb-8 leading-relaxed">Nuestra consultoría se enfoca en integrar la IA en el núcleo de tu operación y marketing para resolver problemas reales: eficiencia, escalabilidad y toma de decisiones basada en datos.</p>
                </div>
                <div class="matte-card p-10 rounded-2xl border border-gold/10">
                    <h4 class="text-xl text-white mb-6 font-medium">Lo que resolvemos:</h4>
                    <ul class="space-y-4 text-subtle">
                        <li class="flex items-start gap-3">
                            <span class="text-gold mt-1">◆</span>
                            <span>Falta de claridad sobre qué procesos automatizar primero.</span>
                        </li>
                        <li class="flex items-start gap-3">
                            <span class="text-gold mt-1">◆</span>
                            <span>Inversión en herramientas que nadie usa en el equipo.</span>
                        </li>
                        <li class="flex items-start gap-3">
                            <span class="text-gold mt-1">◆</span>
                            <span>Miedo a la seguridad de datos y privacidad con IA.</span>
                        </li>
                        <li class="flex items-start gap-3">
                            <span class="text-gold mt-1">◆</span>
                            <span>Brecha de conocimiento técnico para supervisar implementaciones.</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </section>

    <!-- ENTREGABLES -->
    <section class="py-24 px-6 relative border-t border-white/5">
        <div class="max-w-7xl mx-auto">
            <div class="text-center mb-16">
                <span class="editorial-label block mb-3">Entregables</span>
                <div class="gold-rule mx-auto mb-6"></div>
                <h3 class="text-3xl text-white">Nuestro modelo de acompañamiento</h3>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <div class="p-8 rounded-2xl border border-white/5 bg-[#0a0b0e] hover:border-gold/30 transition-all group">
                    <div class="w-12 h-12 rounded-lg bg-gold/10 border border-gold/20 flex items-center justify-center mb-6 group-hover:bg-gold/20 transition-colors">
                        <i class="fa-solid fa-clipboard-check text-gold"></i>
                    </div>
                    <h4 class="text-white text-xl mb-4 font-light">1. Auditoría Operativa</h4>
                    <p class="text-subtle text-sm leading-relaxed">Mapeamos tus flujos actuales para identificar fricciones que la IA puede eliminar hoy mismo.</p>
                </div>
                <div class="p-8 rounded-2xl border border-white/5 bg-[#0a0b0e] hover:border-gold/30 transition-all group">
                    <div class="w-12 h-12 rounded-lg bg-gold/10 border border-gold/20 flex items-center justify-center mb-6 group-hover:bg-gold/20 transition-colors">
                        <i class="fa-solid fa-map-location-dot text-gold"></i>
                    </div>
                    <h4 class="text-white text-xl mb-4 font-light">2. Roadmap de IA</h4>
                    <p class="text-subtle text-sm leading-relaxed">Un plan paso a paso, priorizado por impacto y facilidad de implementación, para tu equipo.</p>
                </div>
                <div class="p-8 rounded-2xl border border-white/5 bg-[#0a0b0e] hover:border-gold/30 transition-all group">
                    <div class="w-12 h-12 rounded-lg bg-gold/10 border border-gold/20 flex items-center justify-center mb-6 group-hover:bg-gold/20 transition-colors">
                        <i class="fa-solid fa-user-gear text-gold"></i>
                    </div>
                    <h4 class="text-white text-xl mb-4 font-light">3. Acompañamiento Técnico</h4>
                    <p class="text-subtle text-sm leading-relaxed">No te dejamos solo con el plan. Supervisamos que la tecnología se instale y se use correctamente.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- ÚLTIMO CTA -->
    <section class="py-24 px-6 relative border-t border-white/5 bg-[#0a0b0e]">
        <div class="max-w-4xl mx-auto text-center">
            <h3 class="mb-8 text-white font-light text-3xl">Deja de adivinar y empieza a implementar con <span class="text-gold italic">estrategia</span>.</h3>
            <p class="text-xl text-subtle mb-12">Agenda una sesión de 30 minutos para evaluar tu situación actual y definir el primer paso de tu transformación con IA.</p>
            <CtaWhatsApp text="Agendar Sesión Estratégica" />
        </div>
    </section>

    <!-- Schema FAQPage para Answer Engine Optimization -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Qué es una consultoría en Inteligencia Artificial?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Es un servicio de acompañamiento experto donde analizamos tu empresa, identificamos cuellos de botella y diseñamos un mapa de ruta técnico para integrar soluciones de IA que generen un retorno de inversión real, evitando gastos innecesarios en software genérico."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuánto tarda un proceso de consultoría e implementación?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "El diagnóstico de madurez y diseño de solución inicial toma entre 1 a 3 semanas. La implementación técnica depende de la complejidad de la arquitectura, pero nos enfocamos en entregar un MVP funcional (Producto Mínimo Viable) en menos de 30 días para iterar rápido."
          }
        },
        {
          "@type": "Question",
          "name": "¿Necesito un equipo técnico interno para adoptar IA?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Nuestro servicio 'Done For You' incluye el desarrollo técnico, despliegue y mantenimiento de los sistemas. Te entregamos la solución lista para operar y capacitamos a tu equipo en el uso final de las herramientas."
          }
        }
      ]
    })} />

    <Footer />
</Layout>

