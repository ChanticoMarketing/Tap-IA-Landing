---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CtaWhatsApp from '../components/CtaWhatsApp.astro';
import SchemaService from '../components/SchemaService.astro';
import KeyTakeaways from '../components/KeyTakeaways.astro';
import ShareButton from '../components/ShareButton.astro';
---

<Layout 
    title="Consultoría de Inteligencia Artificial para Empresas | TAP-IA"
    description="Consultoría de IA para empresas. Diagnóstico de madurez tecnológica, roadmap de implementación y evaluación de ROI con criterio estratégico."
>
    <Header />
    <SchemaService 
        name="Consultoría de Inteligencia Artificial"
        description="Consultoría de IA para empresas. Diagnóstico de madurez, roadmap de implementación y estrategia con criterio de negocio."
        url="/consultoria-inteligencia-artificial"
        serviceType="AI Consulting"
    />

    <section class="relative min-h-0 md:min-h-[70vh] flex flex-col justify-center pt-36 pb-16 px-6 overflow-hidden">
        <!-- Background Orb decoration -->
        <div class="absolute top-20 right-0 w-[600px] h-[600px] bg-gold/5 rounded-full blur-[120px] pointer-events-none -z-10"></div>
        
        <div class="max-w-7xl mx-auto w-full relative z-10 flex flex-col lg:flex-row items-center justify-between gap-12 lg:gap-8">
            <!-- Text Column (Left) -->
            <div class="w-full lg:w-[58%] flex flex-col items-start text-left relative">
                <span class="editorial-label text-gold mb-4 block">Consultoría Estratégica</span>
                <h1 class="font-playfair text-3xl md:text-4xl lg:text-5xl mb-5 text-offwhite leading-[1.1]">
                    Consultoría de inteligencia artificial para empresas que necesitan claridad, estrategia y resultados
                </h1>
                <div class="gold-rule mb-6"></div>

                <!-- Respuesta Directa a la Intención de Búsqueda -->
                <p class="text-base md:text-lg text-offwhite/90 font-light max-w-xl mb-4 leading-relaxed">
                    La consultoría de IA de Tap-IA es un acompañamiento estratégico y técnico integral que ayuda a directores y equipos B2B a identificar cuellos de botella operativos, priorizar casos de uso viables y desplegar sistemas con retorno de inversión medible, evitando el gasto improductivo en herramientas aisladas.
                </p>

                <!-- Resumen TL;DR / 5 Puntos Clave -->
                <KeyTakeaways 
                    points={[
                        "Diagnóstico de Madurez: Analizamos tus procesos y calidad de datos antes de recomendar cualquier desarrollo.",
                        "Roadmap Priorizado: Diseñamos un plan de ejecución por fases enfocado en impacto financiero y facilidad de adopción.",
                        "Selección de Stack: Elegimos modelos (OpenAI, Anthropic, Gemini, OSS) y arquitecturas (RAG, agentes) adecuadas a tu caso.",
                        "Gobernanza y Privacidad: Garantizamos que tus datos confidenciales no se usen para entrenar modelos públicos.",
                        "Acompañamiento en Producción: Supervisamos el despliegue técnico y capacitamos a tu equipo operativo."
                    ]}
                    class="w-full max-w-xl my-4"
                />

                <!-- CTA Inmediato -->
                <div class="w-full flex flex-col sm:flex-row items-start sm:items-center gap-4 mt-2">
                    <CtaWhatsApp align="start" text="Solicitar diagnóstico estratégico" microcopy="Hablamos de tu negocio, no solo de tecnología." />
                    <ShareButton title="Consultoría de Inteligencia Artificial para Empresas" text="Estrategia y roadmap de IA con criterio de negocio por Tap-IA:" url="https://tap-ia.tech/consultoria-inteligencia-artificial" />
                </div>
            </div>

            <!-- Visual Column (Right) -->
            <div class="w-full lg:w-[38%] flex justify-center lg:justify-end items-center">
                <div class="relative w-full max-w-[360px] md:max-w-[400px]">
                    <div class="absolute inset-0 bg-gold/10 rounded-full blur-[80px] pointer-events-none -z-10"></div>
                    <img
                        src="/images/soluciones/consultoria-ia.webp"
                        alt="Consultoría de Inteligencia Artificial para empresas B2B y directivos"
                        class="relative z-10 block w-full h-auto object-contain drop-shadow-[0_0_50px_rgba(212,175,55,0.15)] animate-float"
                        width="500"
                        height="500"
                        fetchpriority="high"
                        loading="eager"
                        decoding="async"
                    />
                </div>
            </div>
        </div>
    </section>

    <!-- PROPUESTA: ESTRATEGIA ANTES QUE HERRAMIENTA -->
    <section class="py-24 px-6 relative border-t border-white/5 bg-white/[0.01]">
        <div class="max-w-5xl mx-auto">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-16 items-center">
                <div>
                    <h2 class="text-3xl md:text-4xl text-white font-light mb-8">El problema no es la tecnología, es el <span class="text-gold italic">roadmap</span>.</h2>
                    <p class="text-subtle mb-6 leading-relaxed">La mayoría de las empresas están probando IA de forma fragmentada: licencias de ChatGPT sin protocolo, chatbots rígidos o herramientas de generación de contenido sin estrategia. El resultado es frustración, costos dispersos y nula tracción comercial.</p>
                    <p class="text-subtle mb-8 leading-relaxed">Nuestra consultoría conecta la IA con el núcleo de tu operación, marketing y <a href="/servicios/seo-geo" class="text-gold hover:underline">posicionamiento SEO/GEO</a> para resolver fricciones reales: velocidad de respuesta, calidad analítica y escalabilidad.</p>
                </div>
                <div class="matte-card p-10 rounded-2xl border border-gold/10">
                    <h3 class="text-xl text-white mb-6 font-medium">Fricciones críticas que eliminamos:</h3>
                    <ul class="space-y-4 text-subtle">
                        <li class="flex items-start gap-3">
                            <span class="text-gold mt-1">◆</span>
                            <span>Incertidumbre sobre qué proceso automatizar primero con mayor retorno.</span>
                        </li>
                        <li class="flex items-start gap-3">
                            <span class="text-gold mt-1">◆</span>
                            <span>Gasto en suscripciones y licencias SaaS que nadie en el equipo utiliza.</span>
                        </li>
                        <li class="flex items-start gap-3">
                            <span class="text-gold mt-1">◆</span>
                            <span>Riesgos de seguridad, fuga de datos corporativos o alucinaciones en clientes.</span>
                        </li>
                        <li class="flex items-start gap-3">
                            <span class="text-gold mt-1">◆</span>
                            <span>Falta de liderazgo técnico para auditar proveedores o agencias externas.</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </section>

    <!-- TABLA COMPARATIVA: Consultoría Tradicional vs Tap-IA -->
    <section class="py-20 px-6 relative border-t border-white/5 bg-[#0a0b0e]/70">
        <div class="max-w-5xl mx-auto">
            <div class="text-center mb-12">
                <span class="editorial-label block mb-3">Comparativa de Enfoque</span>
                <div class="gold-rule mx-auto mb-6"></div>
                <h2 class="text-3xl text-white">Consultoría Tradicional vs Enfoque Tap-IA</h2>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm text-subtle border-collapse border border-white/10 rounded-xl overflow-hidden matte-card">
                    <thead class="bg-white/5 text-offwhite uppercase tracking-wider font-mono text-xs">
                        <tr>
                            <th class="p-4 border-b border-white/10">Criterio</th>
                            <th class="p-4 border-b border-white/10">Consultora Genérica</th>
                            <th class="p-4 border-b border-white/10 text-gold font-bold">Tap-IA Estratega Técnico</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-white/5">
                        <tr>
                            <td class="p-4 font-medium text-white">Entregables</td>
                            <td class="p-4">Presentaciones teóricas y reportes PDF estáticos.</td>
                            <td class="p-4 text-offwhite font-medium">Roadmaps operables, prototipos MVP y arquitecturas listas para desplegar.</td>
                        </tr>
                        <tr>
                            <td class="p-4 font-medium text-white">Evaluación de ROI</td>
                            <td class="p-4">Estimaciones genéricas sin validación de costos de cómputo.</td>
                            <td class="p-4 text-offwhite font-medium">Cálculo de ahorro de horas, costo por token y <a href="/recursos/calculadora-roi-ia" class="text-gold hover:underline">ROI financiero proyectado</a>.</td>
                        </tr>
                        <tr>
                            <td class="p-4 font-medium text-white">Integración Técnica</td>
                            <td class="p-4">Subcontratan o delegan la programación sin supervisión.</td>
                            <td class="p-4 text-offwhite font-medium">Diseño de APIs, arquitectura RAG y conexión directa a tu CRM/ERP.</td>
                        </tr>
                        <tr>
                            <td class="p-4 font-medium text-white">Seguridad de Datos</td>
                            <td class="p-4">Uso de interfaces públicas sin auditoría de privacidad.</td>
                            <td class="p-4 text-offwhite font-medium">Entornos empresariales con acuerdos de no entrenamiento de modelos.</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </section>

    <!-- ENTREGABLES -->
    <section class="py-24 px-6 relative border-t border-white/5">
        <div class="max-w-7xl mx-auto">
            <div class="text-center mb-16">
                <span class="editorial-label block mb-3">Entregables</span>
                <div class="gold-rule mx-auto mb-6"></div>
                <h2 class="text-3xl text-white">Nuestro modelo de acompañamiento</h2>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <div class="p-8 rounded-2xl border border-white/5 bg-[#0a0b0e] hover:border-gold/30 transition-all group">
                    <div class="w-12 h-12 rounded-lg bg-gold/10 border border-gold/20 flex items-center justify-center mb-6 group-hover:bg-gold/20 transition-colors">
                        <i class="fa-solid fa-clipboard-check text-gold"></i>
                    </div>
                    <h3 class="text-white text-xl mb-4 font-light">1. Auditoría de Madurez</h3>
                    <p class="text-subtle text-sm leading-relaxed">Mapeamos tus flujos de marketing y operaciones para identificar cuellos de botella y verificar la salud de tus datos.</p>
                </div>
                <div class="p-8 rounded-2xl border border-white/5 bg-[#0a0b0e] hover:border-gold/30 transition-all group">
                    <div class="w-12 h-12 rounded-lg bg-gold/10 border border-gold/20 flex items-center justify-center mb-6 group-hover:bg-gold/20 transition-colors">
                        <i class="fa-solid fa-map-location-dot text-gold"></i>
                    </div>
                    <h3 class="text-white text-xl mb-4 font-light">2. Roadmap de IA</h3>
                    <p class="text-subtle text-sm leading-relaxed">Un plan paso a paso con priorización clara, estimación de presupuestos y definición de arquitecturas recomendadas.</p>
                </div>
                <div class="p-8 rounded-2xl border border-white/5 bg-[#0a0b0e] hover:border-gold/30 transition-all group">
                    <div class="w-12 h-12 rounded-lg bg-gold/10 border border-gold/20 flex items-center justify-center mb-6 group-hover:bg-gold/20 transition-colors">
                        <i class="fa-solid fa-user-gear text-gold"></i>
                    </div>
                    <h3 class="text-white text-xl mb-4 font-light">3. Acompañamiento Técnico</h3>
                    <p class="text-subtle text-sm leading-relaxed">Supervisamos la integración de <a href="/agentes-ia-a-medida" class="text-gold hover:underline">agentes IA</a> y <a href="/webapps-ia-a-medida" class="text-gold hover:underline">WebApps personalizadas</a> para asegurar su adopción efectiva.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- PREGUNTAS FRECUENTES (FAQ) -->
    <section class="py-20 px-6 relative border-t border-white/5 bg-charcoal">
        <div class="max-w-4xl mx-auto">
            <div class="text-center mb-12">
                <span class="editorial-label block mb-3">FAQ</span>
                <div class="gold-rule mx-auto mb-6"></div>
                <h2 class="text-3xl text-white">Preguntas Frecuentes sobre Consultoría IA</h2>
            </div>

            <div class="space-y-4">
                <details class="matte-card p-6 rounded-2xl border border-white/5 group cursor-pointer">
                    <summary class="flex justify-between items-center text-white font-medium text-lg list-none select-none">
                        <span>¿Qué es exactamente una consultoría en Inteligencia Artificial?</span>
                        <i class="fa-solid fa-chevron-down text-gold group-open:rotate-180 transition-transform text-sm"></i>
                    </summary>
                    <p class="mt-4 text-subtle text-sm md:text-base leading-relaxed font-light">
                        Es un servicio de asesoramiento estratégico y técnico donde diagnosticamos tus operaciones, identificamos oportunidades reales de automatización y diseñamos la arquitectura técnica para integrar IA con retorno de inversión comprobable.
                    </p>
                </details>

                <details class="matte-card p-6 rounded-2xl border border-white/5 group cursor-pointer">
                    <summary class="flex justify-between items-center text-white font-medium text-lg list-none select-none">
                        <span>¿Cuánto tarda un proceso de diagnóstico y roadmap de IA?</span>
                        <i class="fa-solid fa-chevron-down text-gold group-open:rotate-180 transition-transform text-sm"></i>
                    </summary>
                    <p class="mt-4 text-subtle text-sm md:text-base leading-relaxed font-light">
                        El diagnóstico de madurez y diseño de roadmap inicial toma entre 1 y 3 semanas. La implementación de un Producto Mínimo Viable (MVP) se ejecuta habitualmente en menos de 30 días.
                    </p>
                </details>

                <details class="matte-card p-6 rounded-2xl border border-white/5 group cursor-pointer">
                    <summary class="flex justify-between items-center text-white font-medium text-lg list-none select-none">
                        <span>¿Necesito un equipo técnico interno para adoptar IA en mi empresa?</span>
                        <i class="fa-solid fa-chevron-down text-gold group-open:rotate-180 transition-transform text-sm"></i>
                    </summary>
                    <p class="mt-4 text-subtle text-sm md:text-base leading-relaxed font-light">
                        No. Ofrecemos modalidades llave en mano (Done-For-You) donde desarrollamos la infraestructura y capacitamos a tu equipo comercial y operativo en el uso de los sistemas.
                    </p>
                </details>

                <details class="matte-card p-6 rounded-2xl border border-white/5 group cursor-pointer">
                    <summary class="flex justify-between items-center text-white font-medium text-lg list-none select-none">
                        <span>¿Cómo garantizan la privacidad y confidencialidad de nuestros datos?</span>
                        <i class="fa-solid fa-chevron-down text-gold group-open:rotate-180 transition-transform text-sm"></i>
                    </summary>
                    <p class="mt-4 text-subtle text-sm md:text-base leading-relaxed font-light">
                        Firmamos acuerdos de confidencialidad (NDA) e implementamos modelos a través de endpoints empresariales (Enterprise API) donde los proveedores garantizan por contrato que los datos no son utilizados para entrenamiento.
                    </p>
                </details>
            </div>
        </div>
    </section>

    <!-- ÚLTIMO CTA -->
    <section class="py-24 px-6 relative border-t border-white/5 bg-[#0a0b0e]">
        <div class="max-w-4xl mx-auto text-center">
            <h2 class="mb-8 text-white font-light text-3xl">Deja de adivinar y empieza a implementar con <span class="text-gold italic">estrategia</span>.</h2>
            <p class="text-xl text-subtle mb-12">Agenda una sesión de 30 minutos para evaluar tu situación actual y definir el primer paso de tu transformación con IA.</p>
            <CtaWhatsApp text="Agendar Sesión Estratégica" />
        </div>
    </section>

    <!-- Schema FAQPage para Answer Engine Optimization -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Qué es exactamente una consultoría en Inteligencia Artificial?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Es un servicio de asesoramiento estratégico y técnico donde diagnosticamos tus operaciones, identificamos oportunidades reales de automatización y diseñamos la arquitectura técnica para integrar IA con retorno de inversión comprobable."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuánto tarda un proceso de diagnóstico y roadmap de IA?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "El diagnóstico de madurez y diseño de roadmap inicial toma entre 1 y 3 semanas. La implementación de un Producto Mínimo Viable (MVP) se ejecuta habitualmente en menos de 30 días."
          }
        },
        {
          "@type": "Question",
          "name": "¿Necesito un equipo técnico interno para adoptar IA en mi empresa?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Ofrecemos modalidades llave en mano (Done-For-You) donde desarrollamos la infraestructura y capacitamos a tu equipo comercial y operativo en el uso de los sistemas."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cómo garantizan la privacidad y confidencialidad de nuestros datos?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Firmamos acuerdos de confidencialidad (NDA) e implementamos modelos a través de endpoints empresariales (Enterprise API) donde los proveedores garantizan por contrato que los datos no son utilizados para entrenamiento."
          }
        }
      ]
    })} />

    <Footer />
</Layout>
