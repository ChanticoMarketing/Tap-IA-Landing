---
import ZapaEliteDemo from '../../components/demos/ZapaEliteDemo.jsx';
---

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Demo: Zapa-Elite | Portafolio TAP-IA</title>
    <meta name="description" content="Demo interactiva de Zapa-Elite para mostrar metodología, navegación y enfoque visual de TAP-IA." />
    <meta name="robots" content="noindex, follow" />
    <link rel="canonical" href="https://tap-ia.tech/portafolio/sitios-web" />
    <link rel="icon" href="/favicon.ico" />
</head>
<body class="bg-zinc-950 m-0 overflow-x-hidden">
    <!-- Full-Width Return Header -->
    <div class="fixed top-0 left-0 w-full h-12 bg-stone-950 z-[100] border-b border-stone-800 flex justify-between items-center px-6 md:px-12">
        <div class="flex items-center gap-4">
            <img src="/logo.png" alt="TAP-IA Logo" width="120" height="36" class="h-5 w-auto" />
            <span class="text-stone-500 text-[10px] font-bold uppercase tracking-[0.2em] hidden md:inline-block border-l border-stone-800 pl-4 ml-2">Modo Demostración</span>
        </div>
        <a href="/portafolio/sitios-web" class="group flex items-center gap-3 text-stone-400 hover:text-white transition-colors text-[10px] font-bold uppercase tracking-[0.2em]">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="group-hover:-translate-x-1 transition-transform"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
            Volver a TAP-IA
        </a>
    </div>

    <!-- El componente React de Zapa Elite maneja su propia navegación interna -->
    <div class="pt-12">
        <ZapaEliteDemo client:only="react" />
    </div>
</body>
</html>


<style is:global>
    @import 'tailwindcss';
    
    @theme {
        --color-charcoal: #0f1115;
        --color-matte: #16191f;
        --color-gold: #d4af37;
        --color-royal: #3b82f6;
        --color-offwhite: #e2e4e9;
        --color-subtle: #9ca3af;
    }
</style>
