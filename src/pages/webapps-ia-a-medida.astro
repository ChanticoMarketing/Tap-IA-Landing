---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CtaWhatsApp from '../components/CtaWhatsApp.astro';
import SchemaService from '../components/SchemaService.astro';
---

<Layout 
    title="WebApps con IA | Software a Medida | TAP-IA"
    description="Desarrollo de aplicaciones web con IA integrada. Sistemas internos, portales y herramientas a medida para resolver fricciones de negocio."
>

    <Header />
    <SchemaService 
        name="WebApps con IA a Medida"
        description="Desarrollo de aplicaciones web con IA integrada. Sistemas internos, portales y herramientas a medida para resolver fricciones de negocio."
        url="/webapps-ia-a-medida"
        serviceType="Custom AI Web Application Development"
    />

    <section class="relative min-h-0 md:min-h-[70vh] flex flex-col justify-center pt-36 pb-16 px-6 overflow-hidden">
        <!-- Background Orb decoration -->
        <div class="absolute top-20 right-0 w-[600px] h-[600px] bg-gold/5 rounded-full blur-[120px] pointer-events-none -z-10"></div>
        
        <div class="max-w-7xl mx-auto w-full relative z-10 flex flex-col lg:flex-row items-center justify-between gap-12 lg:gap-8">
            <!-- Text Column (Left) -->
            <div class="w-full lg:w-[58%] flex flex-col items-start text-left relative">
                <span class="editorial-label text-gold mb-4 block">Sistemas Personalizados</span>
                <h1 class="font-playfair text-3xl md:text-4xl lg:text-5xl mb-5 text-offwhite leading-[1.1]">
                    Software con cerebro. <span class="italic font-light text-white/60 block mt-2">Soluciones para procesos complejos.</span>
                </h1>
                <div class="gold-rule mb-6"></div>
                <p class="text-base md:text-lg text-subtle font-light max-w-xl mb-8 leading-relaxed">
                    Cuando el software comercial (SaaS) se queda corto, construimos aplicaciones web a medida potenciadas con IA para resolver procesos específicos de tu negocio.
                </p>
                <CtaWhatsApp align="start" text="Consultar por mi proyecto" microcopy="Evaluamos la viabilidad técnica de tu idea en 48h." />
            </div>

            <!-- Visual Column (Right) -->
            <div class="w-full lg:w-[38%] flex justify-center lg:justify-end items-center">
                <div class="relative w-full max-w-[360px] md:max-w-[400px]">
                    <div class="absolute inset-0 bg-gold/10 rounded-full blur-[80px] pointer-events-none -z-10"></div>
                    <img
                        src="/images/soluciones/webapps-ia.webp"
                        alt="WebApps con Inteligencia Artificial"
                        class="relative z-10 block w-full h-auto object-contain drop-shadow-[0_0_50px_rgba(212,175,55,0.15)] animate-float"
                        width="500"
                        height="500"
                        fetchpriority="high"
                        loading="eager"
                        decoding="async"
                    />
                </div>
            </div>
        </div>
    </section>

    <!-- QUÉ ES UNA WEBAPP CON IA -->
    <section class="py-24 px-6 relative border-t border-white/5 bg-white/[0.01]">
        <div class="max-w-5xl mx-auto">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-16 items-center">
                <div>
                    <h2 class="text-3xl md:text-4xl text-white font-light mb-8">No es solo una web. <span class="text-gold italic">Es una herramienta de trabajo.</span></h2>
                    <p class="text-subtle mb-6 leading-relaxed">Las WebApps con IA permiten procesar grandes volúmenes de información, generar reportes automáticos, predecir tendencias o crear interfaces inteligentes que guían al usuario en tareas complejas.</p>
                    <p class="text-subtle mb-8 leading-relaxed">Desde dashboards internos hasta portales de clientes que utilizan LLMs para el análisis de datos, creamos la infraestructura que tu operación necesita para escalar.</p>
                </div>
                <div class="grid grid-cols-2 gap-4">
                    <div class="p-6 rounded-xl border border-white/5 bg-[#0a0b0e] flex flex-col items-center text-center">
                        <i class="fa-solid fa-database text-gold mb-4 text-2xl"></i>
                        <span class="text-xs text-subtle uppercase">Análisis de Datos</span>
                    </div>
                    <div class="p-6 rounded-xl border border-white/5 bg-[#0a0b0e] flex flex-col items-center text-center">
                        <i class="fa-solid fa-wand-magic-sparkles text-gold mb-4 text-2xl"></i>
                        <span class="text-xs text-subtle uppercase">Generación de Contenido</span>
                    </div>
                    <div class="p-6 rounded-xl border border-white/5 bg-[#0a0b0e] flex flex-col items-center text-center">
                        <i class="fa-solid fa-chart-line text-gold mb-4 text-2xl"></i>
                        <span class="text-xs text-subtle uppercase">Predicción B2B</span>
                    </div>
                    <div class="p-6 rounded-xl border border-white/5 bg-[#0a0b0e] flex flex-col items-center text-center">
                        <i class="fa-solid fa-shield-halved text-gold mb-4 text-2xl"></i>
                        <span class="text-xs text-subtle uppercase">Seguridad & Privacidad</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- CASOS DE USO / ENFOQUE -->
    <section class="py-20 px-6 relative border-t border-white/5 bg-charcoal">
        <div class="max-w-4xl mx-auto">
            <h3 class="font-serif text-2xl md:text-3xl text-white mb-8 text-center">Soluciones reales para tu operación</h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 text-subtle text-sm leading-relaxed">
                <div>
                    <h4 class="text-white font-medium mb-2"><i class="fa-solid fa-file-contract text-gold mr-2"></i>Procesamiento Documental Automático</h4>
                    <p>Desarrollamos sistemas capaces de leer, clasificar y extraer información estructurada de contratos, facturas, cotizaciones o correos electrónicos. Tu equipo ya no pasará horas copiando datos manualmente; el sistema los procesa en segundos y los inyecta en tus bases de datos.</p>
                </div>
                <div>
                    <h4 class="text-white font-medium mb-2"><i class="fa-solid fa-chart-pie text-gold mr-2"></i>Asistentes Analíticos Internos</h4>
                    <p>Creamos portales web privados donde tu equipo puede conversar directamente con tus datos de negocio. Utilizando arquitecturas RAG seguras, tus líderes pueden hacer preguntas complejas sobre ventas, inventarios o productividad y recibir respuestas analíticas inmediatas.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- CAPACIDADES -->
    <section class="py-24 px-6 relative border-t border-white/5">
        <div class="max-w-7xl mx-auto">
            <div class="text-center mb-16">
                <span class="editorial-label block mb-3">Capacidades Técnicas</span>
                <div class="gold-rule mx-auto mb-6"></div>
                <h2 class="text-white">Lo que podemos construir juntos</h2>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                <div class="p-8 rounded-2xl border border-white/5 bg-[#0a0b0e] group hover:border-gold/20 transition-all">
                    <h4 class="text-white text-lg mb-3">Dashboards Inteligentes</h4>
                    <p class="text-subtle text-sm">Visualización de datos que no solo muestra gráficos, sino que te explica qué significan mediante lenguaje natural.</p>
                </div>
                <div class="p-8 rounded-2xl border border-white/5 bg-[#0a0b0e] group hover:border-gold/20 transition-all">
                    <h4 class="text-white text-lg mb-3">Herramientas de Autor</h4>
                    <p class="text-subtle text-sm">Software que ayuda a tus expertos a crear contenido técnico, legal o comercial siguiendo tus propios estándares de calidad.</p>
                </div>
                <div class="p-8 rounded-2xl border border-white/5 bg-[#0a0b0e] group hover:border-gold/20 transition-all">
                    <h4 class="text-white text-lg mb-3">Sistemas de Recomendación</h4>
                    <p class="text-subtle text-sm">Motores que analizan el comportamiento de tus usuarios para ofrecerles exactamente lo que necesitan en el momento preciso.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- ÚLTIMO CTA -->
    <section class="py-24 px-6 relative border-t border-white/5 bg-[#0a0b0e]">
        <div class="max-w-4xl mx-auto text-center">
            <h2 class="mb-8 text-white font-light">Tu visión, <span class="text-gold italic">nuestra ejecución técnica.</span></h2>
            <p class="text-xl text-subtle mb-12">Hablemos sobre ese proceso que hoy es manual o ineficiente. Lo transformamos en una ventaja competitiva con software a medida.</p>
            <CtaWhatsApp text="Solicitar Cotización de Proyecto" />
        </div>
    </section>

    <Footer />
</Layout>
