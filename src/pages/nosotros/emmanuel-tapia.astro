---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import SchemaPerson from '../../components/SchemaPerson.astro';
import KeyTakeaways from '../../components/KeyTakeaways.astro';
import ShareButton from '../../components/ShareButton.astro';
---

<Layout
    title="Emmanuel Tapia | Fundador y Estratega Técnico en IA | TAP-IA"
    description="Biografía profesional, trayectoria y credenciales de Emmanuel Tapia, fundador de TAP-IA y especialista en IA aplicada a negocios y optimización GEO."
>
    <Header />
    <SchemaPerson />

    <main class="relative overflow-hidden pt-36 pb-24 px-6 z-10">
        <!-- Luces cinemáticas de fondo -->
        <div class="absolute top-1/4 left-1/4 w-[500px] h-[500px] bg-gold/5 rounded-full blur-[100px] pointer-events-none -z-10"></div>
        <div class="absolute bottom-1/4 right-1/4 w-[400px] h-[400px] bg-royal/5 rounded-full blur-[100px] pointer-events-none -z-10"></div>

        <div class="max-w-6xl mx-auto">
            <!-- Breadcrumbs -->
            <nav class="flex mb-8 text-xs font-mono tracking-widest uppercase text-subtle/70" aria-label="Breadcrumb">
                <ol class="inline-flex items-center space-x-1 md:space-x-3">
                    <li class="inline-flex items-center">
                        <a href="/" class="hover:text-gold transition-colors">Inicio</a>
                    </li>
                    <li>
                        <div class="flex items-center">
                            <span class="mx-2 text-white/20">/</span>
                            <a href="/nosotros" class="hover:text-gold transition-colors">Sobre</a>
                        </div>
                    </li>
                    <li aria-current="page">
                        <div class="flex items-center">
                            <span class="mx-2 text-white/20">/</span>
                            <span class="text-offwhite">Emmanuel Tapia</span>
                        </div>
                    </li>
                </ol>
            </nav>

            <div class="grid grid-cols-1 lg:grid-cols-[1fr_2fr] gap-12 lg:gap-16 items-start">
                
                <!-- Columna Izquierda: Tarjeta de Presentación / Foto -->
                <div class="w-full lg:sticky lg:top-28">
                    <div class="relative card-glow p-6 md:p-8 rounded-2xl bg-gradient-to-b from-[#161922]/90 to-[#0a0b0e]/95 backdrop-blur-md border border-white/10 text-center">
                        <div class="absolute inset-0 bg-noise opacity-[0.02] rounded-2xl pointer-events-none"></div>
                        
                        <div class="relative w-48 h-48 mx-auto mb-6 rounded-full overflow-hidden border-2 border-gold/40 shadow-[0_0_30px_rgba(212,175,55,0.15)] bg-[#12141a]">
                            <img 
                                src="/assets/emmanuel_tapia.jpg" 
                                alt="Emmanuel Tapia" 
                                class="w-full h-full object-cover"
                                width="300"
                                height="300"
                            />
                        </div>

                        <h1 class="font-serif text-2xl md:text-3xl text-white mb-2 font-light">
                            Emmanuel Tapia
                        </h1>
                        <p class="text-gold text-xs font-mono tracking-widest uppercase mb-4">
                            Founder & AI Strategist
                        </p>
                        <div class="gold-rule mb-6 mx-auto"></div>
                        
                        <p class="text-sm text-subtle mb-6 leading-relaxed">
                            "La IA no viene a reemplazar tu criterio. Viene a expandirlo y a automatizar la fricción operativa para que lideres con claridad."
                        </p>

                        <div class="flex justify-center gap-4">
                            <a 
                                href="https://www.linkedin.com/in/emmanuel-tapia-ia" 
                                target="_blank"
                                rel="noopener noreferrer"
                                class="inline-flex items-center gap-2 text-xs font-mono tracking-widest uppercase text-slate-300 hover:text-gold transition-colors focus-visible:outline-none"
                                aria-label="LinkedIn de Emmanuel Tapia"
                            >
                                <span class="w-6 h-6 rounded-full bg-white/5 flex items-center justify-center text-sm">
                                    <i class="fa-brands fa-linkedin-in"></i>
                                </span>
                                LinkedIn
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Columna Derecha: Contenido Biográfico / Experticia -->
                <div class="space-y-12">
                    
                    <!-- Sobre Mí -->
                    <section aria-labelledby="heading-bio">
                        <h2 id="heading-bio" class="text-xs font-mono tracking-widest uppercase text-gold mb-4 select-none">
                            Biografía Profesional & E-E-A-T
                        </h2>
                        <div class="space-y-6 text-lg text-subtle font-light leading-relaxed">
                            <p>
                                Soy un estratega técnico enfocado en la convergencia de la <strong>Inteligencia Artificial aplicada a negocios y el Marketing Digital B2B</strong>. Fundé <a href="/" class="text-gold hover:underline font-normal">Tap-IA</a> bajo una tesis fundamental: las empresas actuales no sufren por falta de acceso a la tecnología, sino por falta de criterio estratégico para integrarla a sus operaciones.
                            </p>
                            <p>
                                A lo largo de mi trayectoria profesional, me he especializado en transformar arquitecturas de información y procesos de adquisición B2B. Trabajo directamente con directores generales, CMOs y líderes de tecnología para diseñar hojas de ruta (roadmaps) claras de adopción de IA, eliminando la moda tecnológica para priorizar el retorno de inversión y la eficiencia de los márgenes.
                            </p>

                            <KeyTakeaways 
                                points={[
                                    "Especialidad: Consultoría estratégica de IA, desarrollo de agentes y optimización SEO/GEO.",
                                    "Metodología: Diagnóstico técnico riguroso antes de cualquier implementación de software.",
                                    "Enfoque GEO: Arquitecturas semánticas que permiten a las marcas ser citadas por ChatGPT, Claude y Perplexity.",
                                    "Gobernanza: Implementación de directrices de seguridad de datos para empresas B2B consolidadas.",
                                    "Filosofía: La inteligencia artificial como herramienta de claridad ejecutiva, no de volumen vacío."
                                ]}
                            />

                            <div class="pt-4">
                                <ShareButton title="Emmanuel Tapia — Fundador y Estratega Técnico en IA" text="Conoce el perfil profesional de Emmanuel Tapia, fundador de Tap-IA:" url="https://tap-ia.tech/nosotros/emmanuel-tapia" />
                            </div>
                        </div>
                    </section>

                    <!-- Filosofía y Enfoque -->
                    <section aria-labelledby="heading-philosophy">
                        <h2 id="heading-philosophy" class="text-xs font-mono tracking-widest uppercase text-gold mb-4 select-none">
                            Filosofía de Trabajo
                        </h2>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            <div class="p-6 rounded-xl border border-white/5 bg-[#161922]/30 backdrop-blur-md">
                                <h3 class="font-playfair text-lg text-white mb-2 font-light">Estrategia antes de código</h3>
                                <p class="text-sm text-subtle font-light leading-relaxed">
                                    Ningún agente o automatización resolverá un proceso roto. Primero diagnosticamos y ordenamos la lógica del negocio; después seleccionamos y entrenamos la tecnología.
                                </p>
                            </div>
                            <div class="p-6 rounded-xl border border-white/5 bg-[#161922]/30 backdrop-blur-md">
                                <h3 class="font-playfair text-lg text-white mb-2 font-light">SEO/GEO de Nueva Generación</h3>
                                <p class="text-sm text-subtle font-light leading-relaxed">
                                    Google ya no lee el contenido como palabras clave aisladas. Entendemos el procesamiento del lenguaje y los modelos de IA para que tu marca destaque en ChatGPT, Gemini y Perplexity.
                                </p>
                            </div>
                        </div>
                    </section>

                    <!-- Áreas de Expertise -->
                    <section aria-labelledby="heading-expertise">
                        <h2 id="heading-expertise" class="text-xs font-mono tracking-widest uppercase text-gold mb-4 select-none">
                            Especialidades Técnicas
                        </h2>
                        <div class="flex flex-wrap gap-3">
                            {[
                                "IA Aplicada a Negocios",
                                "Generative Engine Optimization (GEO)",
                                "Estrategias de Adquisición B2B",
                                "Integración de Sistemas de IA (make, n8n)",
                                "Desarrollo de Agentes Inteligentes",
                                "Arquitectura Web de Alta Conversión",
                                "E-E-A-T & Señales de Confianza",
                                "Auditoría Tecnológica de Marketing"
                            ].map(tag => (
                                <span class="text-xs px-4 py-2 rounded-full border border-white/10 bg-white/5 text-slate-300 font-mono">
                                    {tag}
                                </span>
                            ))}
                        </div>
                    </section>

                    <!-- CTA -->
                    <section class="p-8 rounded-2xl border border-gold/20 bg-gradient-to-r from-gold/[0.03] to-royal/[0.03] text-center md:text-left flex flex-col md:flex-row items-center justify-between gap-6">
                        <div class="max-w-md">
                            <h3 class="font-serif text-xl md:text-2xl text-white mb-2 font-light">
                                ¿Necesitas un diagnóstico técnico?
                            </h3>
                            <p class="text-sm text-subtle font-light leading-relaxed">
                                Evaluemos juntos cómo optimizar tu visibilidad orgánica para motores clásicos y generativos con IA.
                            </p>
                        </div>
                        <a 
                            href="/contacto" 
                            class="inline-flex px-6 py-3 bg-gold text-charcoal text-xs font-mono tracking-widest uppercase font-medium rounded hover:bg-white transition-colors duration-500 shrink-0"
                        >
                            Agendar Llamada
                        </a>
                    </section>

                </div>
            </div>
        </div>
    </main>

    <Footer />
</Layout>
