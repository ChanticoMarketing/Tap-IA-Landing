---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const waBase = 'https://wa.me/5213324239103';
const waText = encodeURIComponent(
  '¡Hola Tap-IA! Acabo de enviarte mi diagnóstico por la web. Si andas por ahí, me gustaría que empecemos a rebotar ideas por aquí de una vez. ¡Gracias!'
);
const waHref = `${waBase}?text=${waText}`;
---

<Layout
  title="Solicitud recibida | TAP-IA"
  description="Tu solicitud de diagnóstico fue recibida. TAP-IA te contactará en 1 día hábil con el siguiente paso."
>
  <Header />

  <section class="min-h-screen py-32 px-6 relative flex flex-col justify-center">
    <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-[600px] h-[600px] bg-gold/15 rounded-full blur-[90px] pointer-events-none animate-pulse-slow"></div>

    <div class="max-w-2xl mx-auto w-full relative z-10 text-center">
      <div class="matte-card rounded-2xl border border-white/10 p-10 md:p-14">
        <div
          class="w-16 h-16 mx-auto mb-8 rounded-full border border-gold/40 bg-gold/10 flex items-center justify-center text-gold text-2xl"
          aria-hidden="true"
        >
          <i class="fa-solid fa-check"></i>
        </div>

        <h1 class="mb-4 text-white" id="gracias-title">Solicitud recibida</h1>
        <p class="text-subtle text-lg mb-6" id="gracias-greeting"></p>

        <p class="text-subtle text-sm mb-10 max-w-md mx-auto">
          Reviso tu caso y te contacto en <strong class="text-offwhite">1 día hábil</strong> con el siguiente paso.
          Si tu proyecto es urgente, puedes escribirme directamente por WhatsApp.
        </p>

        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href={waHref}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 px-8 py-4 rounded-full font-bold text-xs uppercase tracking-wider bg-green-600 hover:bg-green-500 text-white transition-colors"
          >
            <i class="fa-brands fa-whatsapp text-xl"></i>
            Prefiero que lo platiquemos por WhatsApp
          </a>
          <a
            href="/"
            class="inline-flex items-center justify-center px-8 py-4 rounded-full font-bold text-sm uppercase tracking-wider border border-white/20 text-offwhite hover:border-gold/40 hover:text-gold transition-colors"
          >
            Volver al inicio
          </a>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const name = sessionStorage.getItem('tap_contact_name');
    const greeting = document.getElementById('gracias-greeting');
    if (name && greeting) {
      greeting.textContent = `Gracias, ${name}. Tu diagnóstico de encaje está en revisión.`;
    } else if (greeting) {
      greeting.textContent = 'Tu diagnóstico de encaje está en revisión.';
    }
    sessionStorage.removeItem('tap_contact_name');
  });
</script>
