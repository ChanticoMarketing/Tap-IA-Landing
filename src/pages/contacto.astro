---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactWizard from '../components/ContactWizard.astro';

const url = Astro.url;
const plan = url.searchParams.get('plan') ?? '';
const problem = url.searchParams.get('problem') ?? '';
const servicio = url.searchParams.get('servicio') ?? '';
const demo = url.searchParams.get('demo') ?? '';

const PLAN_LABELS: Record<string, string> = {
  venta_rapida: 'Paquete Venta Rápida',
  autoridad_google: 'Paquete Autoridad Google',
  dominio_total: 'Paquete Dominio Total',
};

const SERVICIO_LABELS: Record<string, string> = {
  'agentes-ia': 'Agentes IA',
  'ai-marketing': 'AI Marketing',
  webapps: 'WebApps con IA',
  'avatares-ia': 'Avatares IA',
  'seo-geo': 'SEO/GEO',
  web: 'Diseño Web',
};

let pageTitle = 'Solicitar diagnóstico de encaje';
let pageSubtitle =
  'En 3–4 minutos me cuentas tu caso. Respondo en 1 día hábil con el siguiente paso claro.';

if (plan && PLAN_LABELS[plan]) {
  pageTitle = `Quiero avanzar con ${PLAN_LABELS[plan]}`;
  pageSubtitle =
    'Reviso si el paquete encaja con tu situación antes de comprometer producción.';
} else if (problem) {
  pageTitle = 'Reconozco este reto en mi negocio';
  pageSubtitle = 'Partimos de tu obstáculo; el resto del formulario adapta la propuesta.';
} else if (servicio && SERVICIO_LABELS[servicio]) {
  pageTitle = `Consulta sobre ${SERVICIO_LABELS[servicio]}`;
  pageSubtitle = 'Cuéntame tu contexto y priorizo una respuesta alineada a ese servicio.';
} else if (demo === 'agent-waitlist') {
  pageTitle = 'Lista de espera — Agentes IA';
  pageSubtitle = 'Te aviso del lanzamiento y evalúo tu caso con prioridad.';
}

const waText = encodeURIComponent('¡Hola Tap-IA! Estoy en tu web y prefiero platicarte mi idea directamente por chat para ver cómo lo ves. ¿Platicamos? 📲');
const waHref = `https://wa.me/5213324239103?text=${waText}`;
---

<Layout
  title="Contacto B2B | TAP-IA"
  description="Solicita un diagnóstico de encaje con TAP-IA. Evaluamos tu caso de IA, marketing y visibilidad digital sin compromiso."
>
  <Header />

  <section class="min-h-screen py-24 md:py-32 px-6 relative flex flex-col justify-center">
    <div
      class="absolute bottom-0 left-1/2 -translate-x-1/2 w-[600px] h-[600px] bg-gold/15 rounded-full blur-[90px] pointer-events-none animate-pulse-slow"
    ></div>

    <div class="max-w-3xl mx-auto w-full relative z-10">
      <h1 class="mb-4 text-center text-white">{pageTitle}</h1>
      <p class="text-subtle mb-8 text-center text-base md:text-lg max-w-xl mx-auto">
        {pageSubtitle}
      </p>

      <ContactWizard
        wizardId="contact"
        plan={plan}
        problem={problem}
        servicio={servicio}
        demo={demo}
        showMobileWa={true}
        showDesktopWaLink={true}
      />
    </div>
  </section>

  <a
    href={waHref}
    target="_blank"
    rel="noopener noreferrer"
    class="hidden md:flex fixed bottom-8 right-8 bg-green-600 text-white p-4 rounded-full shadow-[0_0_20px_rgba(34,197,94,0.25)] hover:scale-110 transition-transform z-50 items-center justify-center"
    aria-label="Contactar por WhatsApp"
  >
    <i class="fa-brands fa-whatsapp text-3xl" aria-hidden="true"></i>
  </a>

  <Footer />
</Layout>
