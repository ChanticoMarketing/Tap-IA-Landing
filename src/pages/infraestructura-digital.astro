---
import Layout from '../layouts/Layout.astro';
import ContactWizard from '../components/ContactWizard.astro';
import RoiCalculator from '../components/RoiCalculator';

// Metadatos optimizados para B2B
const title = "Infraestructura Digital de Alta Conversión con IA | TAP-IA";
const description = "No tengas solo una página web. Diseña una infraestructura digital premium que atraiga clientes, califique leads en piloto automático y te posicione en la era de la inteligencia artificial.";
---

<Layout title={title} description={description}>
  <!-- Minimalist Custom Header to prevent traffic leaks -->
  <header class="fixed top-0 left-0 w-full z-50 bg-charcoal/80 backdrop-blur-md border-b border-white/5 py-4">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex justify-between items-center">
      <div class="flex items-center space-x-3">
        <span class="font-playfair text-xl md:text-2xl font-bold tracking-wider text-offwhite">
          TAP<span class="text-gold font-jakarta font-semibold text-sm align-super ml-1">IA</span>
        </span>
      </div>
      <a 
        href="#diagnostico" 
        class="font-jakarta text-xs md:text-sm font-semibold text-charcoal bg-gold hover:bg-gold/90 px-4 py-2 rounded-lg transition-all duration-300 shadow-lg shadow-gold/15 active:scale-95"
      >
        Cotizar Infraestructura
      </a>
    </div>
  </header>

  <main class="relative z-10 pt-24 overflow-hidden">
    
    <!-- ========================================== -->
    <!-- SECTION 1: HERO (ATTENTION) -->
    <!-- ========================================== -->
    <section class="relative min-h-[90vh] flex items-center justify-center py-20 lg:py-32">
      <!-- Background orbs -->
      <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] bg-gold/10 rounded-full blur-[120px] pointer-events-none" />
      <div class="absolute bottom-1/4 left-1/3 w-[400px] h-[400px] bg-royal/5 rounded-full blur-[100px] pointer-events-none" />

      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
        <span class="editorial-label text-xs md:text-sm inline-block mb-6 animate-pulse-slow">
          Exclusivo para Líderes de Negocio y CEOs B2B
        </span>
        <h1 class="font-playfair text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold text-offwhite leading-[1.1] tracking-tight">
          No tengas solo una web.<br />
          Crea una <span class="text-transparent bg-clip-text bg-gradient-to-r from-gold via-gold/80 to-white">Infraestructura Digital</span>.
        </h1>
        <p class="font-jakarta text-subtle text-base sm:text-lg md:text-xl max-w-3xl mx-auto mt-8 leading-relaxed">
          Las webs estáticas tradicionales ya no venden. Diseña un ecosistema premium de alta conversión que califique prospectos en piloto automático, se posicione en motores de búsqueda con IA y optimice tus operaciones comerciales.
        </p>

        <div class="mt-12 flex flex-col sm:flex-row justify-center items-center gap-4 sm:gap-6">
          <a 
            href="#paquetes" 
            class="w-full sm:w-auto font-jakarta text-sm font-semibold text-charcoal bg-gold hover:bg-gold/90 px-8 py-4 rounded-xl transition-all duration-300 shadow-xl shadow-gold/10 text-center active:scale-95"
          >
            Ver Planes de Infraestructura
          </a>
          <a 
            href="#dolor" 
            class="w-full sm:w-auto font-jakarta text-sm font-semibold text-offwhite border border-white/10 hover:border-white/20 bg-white/5 hover:bg-white/10 px-8 py-4 rounded-xl transition-all duration-300 text-center active:scale-95"
          >
            ¿Por qué tu web actual pierde dinero?
          </a>
        </div>
      </div>
    </section>

    <!-- ========================================== -->
    <!-- SECTION 2: THE PROBLEM (INTEREST) -->
    <!-- ========================================== -->
    <section id="dolor" class="py-24 bg-charcoal relative">
      <div class="absolute inset-x-0 bottom-0 h-1/2 bg-matte/40 pointer-events-none" />
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        
        <div class="text-center max-w-3xl mx-auto mb-16 md:mb-20">
          <span class="editorial-label text-xs block mb-3">La Realidad del Mercado</span>
          <h2 class="font-playfair text-3xl md:text-4xl lg:text-5xl text-offwhite font-bold leading-tight">
            La Fuga Silenciosa de Conversión Web
          </h2>
          <p class="text-subtle text-base md:text-lg mt-4 font-jakarta leading-relaxed">
            El 95% de las empresas cometen el error de tratar su página web como un folleto digital estático. Mientras tanto, están perdiendo hasta un 40% de prospectos debido a estos tres bloqueos invisibles:
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <!-- Card 1: GEO -->
          <div class="matte-card p-8 rounded-2xl border border-white/5 relative overflow-hidden flex flex-col justify-between group hover:border-gold/20 transition-all duration-300">
            <div>
              <div class="w-12 h-12 rounded-xl bg-gold/10 border border-gold/20 flex items-center justify-center text-gold mb-6 group-hover:scale-105 transition-all duration-300">
                <i class="fa-solid fa-brain text-xl"></i>
              </div>
              <h3 class="font-playfair text-xl text-offwhite font-bold mb-4">
                Invisibilidad en Buscadores de IA (GEO)
              </h3>
              <p class="text-subtle text-sm font-jakarta leading-relaxed">
                Las búsquedas en Google están cambiando hacia resúmenes con IA. Si tu marca no está estructurada y optimizada semánticamente, **ChatGPT, Gemini y Perplexity no te citarán como opción**, volviéndote invisible para la nueva generación de clientes.
              </p>
            </div>
            <span class="text-xs text-gold/60 font-semibold uppercase tracking-wider font-jakarta mt-8 block">
              Pérdida estimada: ~50% visibilidad futura
            </span>
          </div>

          <!-- Card 2: Passive Pages -->
          <div class="matte-card p-8 rounded-2xl border border-white/5 relative overflow-hidden flex flex-col justify-between group hover:border-gold/20 transition-all duration-300">
            <div>
              <div class="w-12 h-12 rounded-xl bg-gold/10 border border-gold/20 flex items-center justify-center text-gold mb-6 group-hover:scale-105 transition-all duration-300">
                <i class="fa-solid fa-hand-pointer text-xl"></i>
              </div>
              <h3 class="font-playfair text-xl text-offwhite font-bold mb-4">
                Páginas Pasivas sin Calificación
              </h3>
              <p class="text-subtle text-sm font-jakarta leading-relaxed">
                Tener visitas no sirve de nada si se van sin dejar datos. Las webs tradicionales fatigan con formularios aburridos o un botón de WhatsApp sin filtros, atrayendo leads no calificados que consumen el tiempo valioso de tus vendedores.
              </p>
            </div>
            <span class="text-xs text-gold/60 font-semibold uppercase tracking-wider font-jakarta mt-8 block">
              Pérdida estimada: ~35% tasa de conversión
            </span>
          </div>

          <!-- Card 3: No Automation -->
          <div class="matte-card p-8 rounded-2xl border border-white/5 relative overflow-hidden flex flex-col justify-between group hover:border-gold/20 transition-all duration-300">
            <div>
              <div class="w-12 h-12 rounded-xl bg-gold/10 border border-gold/20 flex items-center justify-center text-gold mb-6 group-hover:scale-105 transition-all duration-300">
                <i class="fa-solid fa-bolt text-xl"></i>
              </div>
              <h3 class="font-playfair text-xl text-offwhite font-bold mb-4">
                Cero Automatización de Procesos
              </h3>
              <p class="text-subtle text-sm font-jakarta leading-relaxed">
                Si un prospecto te contacta un viernes por la noche y recibe una respuesta hasta el lunes por la mañana, la tasa de cierre se desploma un 80%. La falta de agentes de IA y flujos automáticos destruye la inmediatez comercial.
              </p>
            </div>
            <span class="text-xs text-gold/60 font-semibold uppercase tracking-wider font-jakarta mt-8 block">
              Pérdida estimada: ~80% efectividad de contacto
            </span>
          </div>
        </div>

      </div>
    </section>

    <!-- ========================================== -->
    <!-- SECTION 3: THE FORMULA (DESIRE) -->
    <!-- ========================================== -->
    <section class="py-24 bg-matte relative">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
          <div>
            <span class="editorial-label text-xs block mb-3">La Solución de TAP-IA</span>
            <h2 class="font-playfair text-3xl md:text-4xl lg:text-5xl text-offwhite font-bold leading-[1.15]">
              La Fórmula de la Infraestructura Digital Avanzada
            </h2>
            <p class="text-subtle text-base font-jakarta mt-6 leading-relaxed">
              No construimos páginas web genéricas. Creamos un **sistema digital unificado de tres capas** diseñado específicamente para captar prospectos, cualificarlos de inmediato y optimizar tus operaciones usando Inteligencia Artificial.
            </p>

            <div class="mt-8 space-y-6">
              <div class="flex gap-4">
                <div class="flex-shrink-0 w-8 h-8 rounded-full bg-gold/10 border border-gold/20 flex items-center justify-center text-gold font-bold font-jakarta text-xs">1</div>
                <div>
                  <h4 class="text-offwhite font-bold font-jakarta">Diseño Visual Premium e Persuasivo</h4>
                  <p class="text-subtle text-sm font-jakarta mt-1">Interfaces oscuras, elegantes y ultra-rápidas diseñadas con base en la psicología de conversión B2B.</p>
                </div>
              </div>
              <div class="flex gap-4">
                <div class="flex-shrink-0 w-8 h-8 rounded-full bg-gold/10 border border-gold/20 flex items-center justify-center text-gold font-bold font-jakarta text-xs">2</div>
                <div>
                  <h4 class="text-offwhite font-bold font-jakarta">Optimización de Motores de IA (SEO/GEO)</h4>
                  <p class="text-subtle text-sm font-jakarta mt-1">Inyectamos microdatos estructurados JSON-LD y optimizamos semánticamente tu contenido para que ChatGPT y Google AI te recomienden de inmediato.</p>
                </div>
              </div>
              <div class="flex gap-4">
                <div class="flex-shrink-0 w-8 h-8 rounded-full bg-gold/10 border border-gold/20 flex items-center justify-center text-gold font-bold font-jakarta text-xs">3</div>
                <div>
                  <h4 class="text-offwhite font-bold font-jakarta">Agentes y Automatizaciones de IA Integrados</h4>
                  <p class="text-subtle text-sm font-jakarta mt-1">Cuestionarios de pre-cualificación táctil y agentes inteligentes que capturan y nutren prospectos las 24 horas del día.</p>
                </div>
              </div>
            </div>
          </div>

          <div class="relative">
            <!-- Ambient glows behind the block -->
            <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-80 h-80 bg-gold/5 rounded-full blur-[80px]" />
            
            <div class="matte-card p-8 rounded-2xl border border-white/5 relative z-10 shadow-2xl">
              <div class="space-y-6">
                <div class="border-l-2 border-gold pl-4 py-2">
                  <span class="text-xs text-subtle font-jakarta uppercase font-semibold">Conversión Promedio</span>
                  <div class="text-2xl font-bold text-offwhite font-playfair mt-1">+250% más leads calificados</div>
                </div>
                <div class="border-l-2 border-gold pl-4 py-2">
                  <span class="text-xs text-subtle font-jakarta uppercase font-semibold">Tasa de Aprobación de TI</span>
                  <div class="text-2xl font-bold text-offwhite font-playfair mt-1">Arquitectura SSR Server-side limpia</div>
                </div>
                <div class="border-l-2 border-gold pl-4 py-2">
                  <span class="text-xs text-subtle font-jakarta uppercase font-semibold">Recomendabilidad IA</span>
                  <div class="text-2xl font-bold text-offwhite font-playfair mt-1">Optimización GEO Nativa en Schema</div>
                </div>
              </div>
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- ========================================== -->
    <!-- SECTION 4: PACKAGES & PRICING -->
    <!-- ========================================== -->
    <section id="paquetes" class="py-24 bg-charcoal relative">
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-gold/5 rounded-full blur-[150px] pointer-events-none" />

      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        
        <div class="text-center max-w-3xl mx-auto mb-16 md:mb-20">
          <span class="editorial-label text-xs block mb-3">Precios Claros y Empaquetados</span>
          <h2 class="font-playfair text-3xl md:text-4xl lg:text-5xl text-offwhite font-bold leading-tight">
            Nuestros Planes de Infraestructura
          </h2>
          <p class="text-subtle text-base md:text-lg mt-4 font-jakarta">
            Invierte en activos digitales diseñados para durar. Elige el paquete que mejor se adapte al nivel operativo actual de tu negocio:
          </p>
        </div>

        <!-- Pricing Cards Grid -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-stretch">
          
          <!-- Package 1 -->
          <div class="matte-card p-8 rounded-2xl border border-white/5 flex flex-col justify-between h-full relative group hover:border-white/10 transition-all duration-300">
            <div>
              <span class="editorial-label text-[10px] text-subtle block mb-1">LANDING + ACTIVACIÓN IA</span>
              <h3 class="font-playfair text-2xl text-offwhite font-bold mb-2">Impulso de Captación</h3>
              <div class="text-3xl font-playfair text-gold font-bold my-4">$8,900 <span class="text-xs text-subtle font-jakarta font-normal">MXN</span></div>
              <p class="text-subtle text-sm font-jakarta leading-relaxed mb-6">
                Para negocios que necesitan validar rápidamente su oferta, captar prospectos filtrados y arrancar con IA sin construir sistemas robustos aún.
              </p>
              
              <div class="w-full h-px bg-white/5 my-6" />
              
              <ul class="space-y-4">
                <li class="flex items-start text-xs text-offwhite font-jakarta">
                  <i class="fa-solid fa-check text-gold mr-3 mt-0.5"></i>
                  Landing Page de Alta Conversión
                </li>
                <li class="flex items-start text-xs text-offwhite font-jakarta">
                  <i class="fa-solid fa-check text-gold mr-3 mt-0.5"></i>
                  Auditoría Express de Captación
                </li>
                <li class="flex items-start text-xs text-offwhite font-jakarta">
                  <i class="fa-solid fa-check text-gold mr-3 mt-0.5"></i>
                  Copywriting Comercial Base
                </li>
                <li class="flex items-start text-xs text-offwhite font-jakarta">
                  <i class="fa-solid fa-check text-gold mr-3 mt-0.5"></i>
                  Formulario o WhatsApp Integrado
                </li>
                <li class="flex items-start text-xs text-offwhite font-jakarta">
                  <i class="fa-solid fa-check text-gold mr-3 mt-0.5"></i>
                  Sesión de Activación IA
                </li>
              </ul>
            </div>

            <div class="mt-8">
              <a 
                href="#diagnostico" 
                class="block w-full py-3 text-center text-xs font-semibold text-offwhite border border-white/10 hover:border-gold/30 hover:bg-gold/5 rounded-xl transition-all duration-300 font-jakarta active:scale-95"
              >
                Activar Captación
              </a>
            </div>
          </div>

          <!-- Package 2 - Highlighted -->
          <div class="card-glow p-8 rounded-2xl border border-gold/25 bg-matte flex flex-col justify-between h-full relative group shadow-xl shadow-gold/5">
            <div class="absolute top-0 right-8 -translate-y-1/2 bg-gold text-charcoal text-[9px] uppercase tracking-widest font-extrabold px-3 py-1 rounded-full font-jakarta">
              Recomendado
            </div>
            
            <div>
              <span class="editorial-label text-[10px] text-gold block mb-1">WEB + SEO/GEO + ROADMAP IA</span>
              <h3 class="font-playfair text-2xl text-offwhite font-bold mb-2">Sistema Web Inteligente</h3>
              <div class="text-3xl font-playfair text-gold font-bold my-4">$15,900 <span class="text-xs text-subtle font-jakarta font-normal">MXN</span></div>
              <p class="text-subtle text-sm font-jakarta leading-relaxed mb-6">
                Para empresas que demandan una presencia B2B premium: web completa de múltiples páginas, indexación semántica en IA y un plan de automatización.
              </p>
              
              <div class="w-full h-px bg-white/5 my-6" />
              
              <ul class="space-y-4">
                <li class="flex items-start text-xs text-offwhite font-jakarta">
                  <i class="fa-solid fa-check text-gold mr-3 mt-0.5"></i>
                  Página Web Corporativa Completa
                </li>
                <li class="flex items-start text-xs text-offwhite font-jakarta">
                  <i class="fa-solid fa-check text-gold mr-3 mt-0.5"></i>
                  Auditoría AI Marketing + SEO/GEO
                </li>
                <li class="flex items-start text-xs text-offwhite font-jakarta">
                  <i class="fa-solid fa-check text-gold mr-3 mt-0.5"></i>
                  Inyección SEO/GEO en Schema.org
                </li>
                <li class="flex items-start text-xs text-offwhite font-jakarta">
                  <i class="fa-solid fa-check text-gold mr-3 mt-0.5"></i>
                  Copywriting Premium Conversión
                </li>
                <li class="flex items-start text-xs text-offwhite font-jakarta">
                  <i class="fa-solid fa-check text-gold mr-3 mt-0.5"></i>
                  Roadmap de Implementación IA
                </li>
                <li class="flex items-start text-xs text-offwhite font-jakarta">
                  <i class="fa-solid fa-check text-gold mr-3 mt-0.5"></i>
                  Sesión de Entrega Estratégica
                </li>
              </ul>
            </div>

            <div class="mt-8">
              <a 
                href="#diagnostico" 
                class="block w-full py-3 text-center text-xs font-semibold text-charcoal bg-gold hover:bg-gold/90 rounded-xl transition-all duration-300 font-jakarta active:scale-95 shadow-md shadow-gold/15"
              >
                Construir mi Sistema
              </a>
            </div>
          </div>

          <!-- Package 3 -->
          <div class="matte-card p-8 rounded-2xl border border-white/5 flex flex-col justify-between h-full relative group hover:border-white/10 transition-all duration-300">
            <div>
              <span class="editorial-label text-[10px] text-subtle block mb-1">WEB + MARKETING IA + AGENTE</span>
              <h3 class="font-playfair text-2xl text-offwhite font-bold mb-2">Arquitectura IA Comercial</h3>
              <div class="text-3xl font-playfair text-gold font-bold my-4"><span class="text-xs text-subtle font-jakarta font-normal">Desde</span> $34,900 <span class="text-xs text-subtle font-jakarta font-normal">MXN</span></div>
              <p class="text-subtle text-sm font-jakarta leading-relaxed mb-6">
                Para negocios que buscan integrar presencia web premium de alta gama con un agente de IA entrenado a medida para automatizar operaciones de ventas.
              </p>
              
              <div class="w-full h-px bg-white/5 my-6" />
              
              <ul class="space-y-4">
                <li class="flex items-start text-xs text-offwhite font-jakarta">
                  <i class="fa-solid fa-check text-gold mr-3 mt-0.5"></i>
                  Todo lo del Sistema Web Inteligente
                </li>
                <li class="flex items-start text-xs text-offwhite font-jakarta">
                  <i class="fa-solid fa-check text-gold mr-3 mt-0.5"></i>
                  AI Digital Marketing Inicial
                </li>
                <li class="flex items-start text-xs text-offwhite font-jakarta">
                  <i class="fa-solid fa-check text-gold mr-3 mt-0.5"></i>
                  Consultoría Estratégica en IA
                </li>
                <li class="flex items-start text-xs text-offwhite font-jakarta">
                  <i class="fa-solid fa-check text-gold mr-3 mt-0.5"></i>
                  Agente IA Comercial Entrenado a Medida
                </li>
                <li class="flex items-start text-xs text-offwhite font-jakarta">
                  <i class="fa-solid fa-check text-gold mr-3 mt-0.5"></i>
                  Soporte Inicial del Agente (30 días)
                </li>
                <li class="flex items-start text-xs text-offwhite font-jakarta">
                  <i class="fa-solid fa-check text-gold mr-3 mt-0.5"></i>
                  Roadmap Estratégico 60/90 días
                </li>
              </ul>
            </div>

            <div class="mt-8">
              <a 
                href="#diagnostico" 
                class="block w-full py-3 text-center text-xs font-semibold text-offwhite border border-white/10 hover:border-gold/30 hover:bg-gold/5 rounded-xl transition-all duration-300 font-jakarta active:scale-95"
              >
                Solicitar Propuesta
              </a>
            </div>
          </div>

        </div>

      </div>
    </section>

    <!-- ========================================== -->
    <!-- SECTION 5: INTERACTIVE ROI CALCULATOR -->
    <!-- ========================================== -->
    <section class="py-24 bg-matte relative">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <div class="text-center max-w-3xl mx-auto mb-16">
          <span class="editorial-label text-xs block mb-3">Simulación de Retorno Comercial</span>
          <h2 class="font-playfair text-3xl md:text-4xl text-offwhite font-bold leading-tight">
            ¿Por qué la Infraestructura Digital es una inversión autoliquidable?
          </h2>
          <p class="text-subtle text-sm md:text-base mt-4 font-jakarta leading-relaxed">
            Una infraestructura digital no es un gasto, es un activo financiero. Utiliza nuestro simulador interactivo para ver lo rápido que recuperas tu inversión (payback) según el volumen y ticket de tu negocio.
          </p>
        </div>

        <!-- React Component for ROI -->
        <RoiCalculator client:load />

      </div>
    </section>

    <!-- ========================================== -->
    <!-- SECTION 6: DETAILED SPECIFICATIONS GRID -->
    <!-- ========================================== -->
    <section class="py-24 bg-charcoal relative">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <div class="text-center max-w-3xl mx-auto mb-16">
          <span class="editorial-label text-xs block mb-3">Transparencia al 100%</span>
          <h2 class="font-playfair text-3xl md:text-4xl text-offwhite font-bold leading-tight">
            Tabla Comparativa de Especificaciones
          </h2>
          <p class="text-subtle text-sm font-jakarta mt-3">
            Compara de forma clara el alcance, los entregables y las tecnologías de cada uno de nuestros paquetes.
          </p>
        </div>

        <!-- Responsive Table Grid -->
        <div class="matte-card rounded-2xl border border-white/5 overflow-hidden shadow-xl">
          <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
              <thead>
                <tr class="border-b border-white/10 bg-charcoal/40 text-xs font-jakarta uppercase font-semibold text-offwhite tracking-wider">
                  <th class="p-6">Especificaciones y Entregables</th>
                  <th class="p-6">Impulso de Captación</th>
                  <th class="p-6 text-gold">Sistema Web Inteligente</th>
                  <th class="p-6">Arquitectura IA Comercial</th>
                </tr>
              </thead>
              <tbody class="text-sm font-jakarta text-subtle divide-y divide-white/5">
                <tr>
                  <td class="p-6 font-semibold text-offwhite">Alcance de Páginas</td>
                  <td class="p-6">1 Landing Page Estratégica</td>
                  <td class="p-6 text-offwhite font-medium">Multidisciplinaria (3 a 5 páginas)</td>
                  <td class="p-6">Estructura Corporativa Completa</td>
