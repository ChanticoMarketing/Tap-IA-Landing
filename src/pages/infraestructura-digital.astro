---
import Layout from '../layouts/Layout.astro';
import ContactWizard from '../components/ContactWizard.astro';
import KeyTakeaways from '../components/KeyTakeaways.astro';
import ShareButton from '../components/ShareButton.astro';

// Metadatos optimizados para B2B
const title = "Infraestructura Digital con IA para Empresas B2B | TAP-IA";
const description = "Diseña una infraestructura digital premium con IA que atraiga clientes, califique leads en piloto automático y te posicione en la era de la inteligencia artificial.";
---

<Layout title={title} description={description}>
  <!-- Minimalist Custom Header to prevent traffic leaks -->
  <header class="fixed top-0 left-0 w-full z-50 bg-charcoal/80 backdrop-blur-md border-b border-white/5 py-3 md:py-2.5">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex justify-between items-center">
      <div class="flex items-center">
        <a href="/">
          <img src="/Logo-No-Background.png" alt="TAP-IA Logo" width="578" height="432" class="h-10 md:h-12 w-auto" />
        </a>
      </div>
      <a 
        href="#diagnostico" 
        class="font-jakarta text-xs md:text-sm font-semibold text-charcoal bg-gold hover:bg-gold/90 px-4 py-2 rounded-lg transition-all duration-300 shadow-lg shadow-gold/15 active:scale-95"
      >
        Cotizar Infraestructura
      </a>
    </div>
  </header>

  <main class="relative z-10 pt-24 overflow-hidden">
    
    <!-- ========================================== -->
    <!-- SECTION 1: HERO (ATTENTION) -->
    <!-- ========================================== -->
    <section class="relative min-h-[90vh] flex items-center justify-center py-20 lg:py-32">
      <!-- Background orbs -->
      <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] bg-gold/10 rounded-full blur-[120px] pointer-events-none" />
      <div class="absolute bottom-1/4 left-1/3 w-[400px] h-[400px] bg-royal/5 rounded-full blur-[100px] pointer-events-none" />

      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
        <span class="editorial-label text-xs md:text-sm inline-block mb-6 animate-pulse-slow">
          Exclusivo para Líderes de Negocio y CEOs B2B
        </span>
        <h1 class="font-playfair text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold text-offwhite leading-[1.1] tracking-tight" id="hero-title" aria-label="Infraestructura digital con inteligencia artificial para convertir visitas en clientes calificados">
          <span id="typewriter-base">No tengas solo una web.</span><span id="cursor-base" class="inline-block w-[3px] md:w-[4px] h-[0.9em] bg-gold ml-1 align-middle opacity-0" aria-hidden="true"></span><br />
          <span id="typewriter-accent" class="text-transparent bg-clip-text bg-gradient-to-r from-gold via-gold/80 to-white">Crea una Infraestructura Digital.</span><span id="cursor-accent" class="inline-block w-[3px] md:w-[4px] h-[0.9em] bg-gold ml-1 align-middle opacity-0" aria-hidden="true"></span>
        </h1>
        <p class="font-jakarta text-subtle text-base sm:text-lg md:text-xl max-w-3xl mx-auto mt-8 leading-relaxed">
          Las webs estáticas tradicionales ya no venden. Diseña un ecosistema premium de alta conversión que califique prospectos en piloto automático, se posicione en motores de búsqueda con IA y optimice tus operaciones comerciales.
        </p>

        <!-- Resumen TL;DR / 5 Puntos Clave -->
        <div class="max-w-3xl mx-auto text-left my-8">
          <KeyTakeaways 
            points={[
              "Ecosistema Completo: Unificamos landing de alta conversión, precalificación con IA y sincronización con tu CRM.",
              "Posicionamiento Dual: Diseñada para indexar en Google y alimentar respuestas en ChatGPT, Perplexity y Claude.",
              "Automatización Comercial: Los prospectos son atendidos en segundos sin esperar a un SDR humano.",
              "Rendimiento Extremo: Arquitectura web con tiempos de carga ultrarrápidos y diseño editorial premium.",
              "Propiedad Total: Sin costos por usuario abusivos; la infraestructura y los datos son de tu empresa."
            ]}
          />
        </div>

        <div class="mt-8 flex flex-col sm:flex-row justify-center items-center gap-4 sm:gap-6">
          <a 
            href="#paquetes" 
            class="w-full sm:w-auto font-jakarta text-sm font-semibold text-charcoal bg-gold hover:bg-gold/90 px-8 py-4 rounded-xl transition-all duration-300 shadow-xl shadow-gold/10 text-center active:scale-95 cta-shine-sweep cta-magnetic"
          >
            <span class="cta-magnetic-inner inline-block">Ver Planes de Infraestructura</span>
          </a>
          <ShareButton title="Infraestructura Digital con IA para Empresas B2B" text="Conoce el servicio de Infraestructura Digital de Tap-IA:" url="https://tap-ia.tech/infraestructura-digital" />
        </div>
      </div>
    </section>

    <!-- ========================================== -->
    <!-- SECTION 2: THE PROBLEM (INTEREST) -->
    <!-- ========================================== -->
    <section id="dolor" class="py-12 md:py-16 bg-transparent relative">
    <div class="absolute inset-x-0 bottom-0 h-1/2 bg-matte/40 pointer-events-none" />
    <!-- Atmosphere backlights for borderless flow -->
    <div class="absolute top-1/3 left-1/4 w-[350px] h-[350px] bg-royal/5 rounded-full blur-[110px] pointer-events-none" />
    <div class="absolute bottom-1/4 right-1/4 w-[300px] h-[300px] bg-gold/5 rounded-full blur-[100px] pointer-events-none" />
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        
        <div class="text-center max-w-3xl mx-auto mb-16 md:mb-20">
          <span class="editorial-label text-xs block mb-3">La Realidad del Mercado</span>
          <h2 class="font-playfair text-3xl md:text-4xl lg:text-5xl text-offwhite font-bold leading-tight">
            La Fuga Silenciosa de Conversión Web
          </h2>
          <p class="text-subtle text-base md:text-lg mt-4 font-jakarta leading-relaxed">
            El 95% de las empresas cometen el error de tratar su página web como un folleto digital estático. Mientras tanto, están perdiendo hasta un 40% de prospectos debido a estos tres bloqueos invisibles:
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-12 relative">
          <!-- Column 1: GEO (Borderless, Floating) -->
          <div class="relative flex flex-col justify-between group py-6 transition-all duration-300">
            <div>
              <!-- Float icon without box -->
              <div class="text-gold mb-6 flex items-center gap-3">
                <i class="fa-solid fa-brain text-2xl animate-pulse-slow"></i>
                <div class="h-[1px] w-8 bg-gold/30"></div>
              </div>
              <h3 class="font-playfair text-2xl text-offwhite font-bold mb-4 tracking-tight group-hover:text-gold transition-colors duration-300">
                Invisibilidad en Buscadores de IA (GEO)
              </h3>
              <p class="text-subtle text-sm font-jakarta leading-relaxed">
                Las búsquedas en Google están cambiando hacia resúmenes con IA. Si tu marca no está estructurada y optimizada semánticamente, <strong class="text-offwhite font-semibold">ChatGPT, Gemini y Perplexity no te citarán como opción</strong>, volviéndote invisible para la nueva generación de clientes.
              </p>
            </div>
            <span class="text-xs text-gold font-semibold uppercase tracking-wider font-jakarta mt-8 block border-l-2 border-gold pl-3">
              Pérdida estimada: ~50% visibilidad futura
            </span>
          </div>

          <!-- Column 2: Passive Pages (Borderless, Floating) -->
          <div class="relative flex flex-col justify-between group py-6 transition-all duration-300">
            <!-- Subtle left-side borderless divider (Desktop only) -->
            <div class="absolute -left-6 top-0 bottom-0 w-px bg-gradient-to-b from-white/5 via-white/5 to-transparent hidden md:block"></div>
            <div>
              <div class="text-gold mb-6 flex items-center gap-3">
                <i class="fa-solid fa-hand-pointer text-2xl animate-pulse-slow"></i>
                <div class="h-[1px] w-8 bg-gold/30"></div>
              </div>
              <h3 class="font-playfair text-2xl text-offwhite font-bold mb-4 tracking-tight group-hover:text-gold transition-colors duration-300">
                Páginas Pasivas sin Calificación
              </h3>
              <p class="text-subtle text-sm font-jakarta leading-relaxed">
                Tener visitas no sirve de nada si se van sin dejar datos. Las webs tradicionales fatigan con formularios aburridos o un botón de WhatsApp sin filtros, atrayendo leads no calificados que consumen el tiempo valioso de tus vendedores.
              </p>
            </div>
            <span class="text-xs text-gold font-semibold uppercase tracking-wider font-jakarta mt-8 block border-l-2 border-gold pl-3">
              Pérdida estimada: ~35% tasa de conversión
            </span>
          </div>

          <!-- Column 3: No Automation (Borderless, Floating) -->
          <div class="relative flex flex-col justify-between group py-6 transition-all duration-300">
            <!-- Subtle left-side borderless divider (Desktop only) -->
            <div class="absolute -left-6 top-0 bottom-0 w-px bg-gradient-to-b from-white/5 via-white/5 to-transparent hidden md:block"></div>
            <div>
              <div class="text-gold mb-6 flex items-center gap-3">
                <i class="fa-solid fa-bolt text-2xl animate-pulse-slow"></i>
                <div class="h-[1px] w-8 bg-gold/30"></div>
              </div>
              <h3 class="font-playfair text-2xl text-offwhite font-bold mb-4 tracking-tight group-hover:text-gold transition-colors duration-300">
                Cero Automatización de Procesos
              </h3>
              <p class="text-subtle text-sm font-jakarta leading-relaxed">
                Si un prospecto te contacta un viernes por la noche y recibe una respuesta hasta el lunes por la mañana, la tasa de cierre se desploma un 80%. La falta de agentes de IA y flujos automáticos destruye la inmediatez comercial.
              </p>
            </div>
            <span class="text-xs text-gold font-semibold uppercase tracking-wider font-jakarta mt-8 block border-l-2 border-gold pl-3">
              Pérdida estimada: ~80% efectividad de contacto
            </span>
          </div>
        </div>

      </div>
    </section>

    <!-- ========================================== -->
    <!-- SECTION 3: THE FORMULA (DESIRE) -->
    <!-- ========================================== -->
    <section class="py-12 md:py-16 bg-transparent relative">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
          <div>
            <span class="editorial-label text-xs block mb-3">La Solución de TAP-IA</span>
            <h2 class="font-playfair text-3xl md:text-4xl lg:text-5xl text-offwhite font-bold leading-[1.15]">
              La Fórmula de la Infraestructura Digital Avanzada
            </h2>
            <p class="text-subtle text-base font-jakarta mt-6 leading-relaxed">
              No construimos páginas web genéricas. Creamos un <strong class="text-offwhite font-semibold">sistema digital unificado de tres capas</strong> diseñado específicamente para captar prospectos, cualificarlos de inmediato y optimizar tus operaciones usando Inteligencia Artificial.
            </p>

            <div class="mt-8 space-y-6">
              <div class="flex gap-4">
                <div class="flex-shrink-0 w-8 h-8 rounded-full bg-gold/10 border border-gold/20 flex items-center justify-center text-gold font-bold font-jakarta text-xs">1</div>
                <div>
                  <h3 class="text-offwhite font-bold font-jakarta text-base">Diseño Visual Premium e Persuasivo</h3>
                  <p class="text-subtle text-sm font-jakarta mt-1">Interfaces oscuras, elegantes y ultra-rápidas diseñadas con base en la psicología de conversión B2B.</p>
                </div>
              </div>
              <div class="flex gap-4">
                <div class="flex-shrink-0 w-8 h-8 rounded-full bg-gold/10 border border-gold/20 flex items-center justify-center text-gold font-bold font-jakarta text-xs">2</div>
                <div>
                  <h3 class="text-offwhite font-bold font-jakarta text-base">Optimización de Motores de IA (SEO/GEO)</h3>
                  <p class="text-subtle text-sm font-jakarta mt-1">Inyectamos microdatos estructurados JSON-LD y optimizamos semánticamente tu contenido para que ChatGPT y Google AI te recomienden de inmediato.</p>
                </div>
              </div>
              <div class="flex gap-4">
                <div class="flex-shrink-0 w-8 h-8 rounded-full bg-gold/10 border border-gold/20 flex items-center justify-center text-gold font-bold font-jakarta text-xs">3</div>
                <div>
                  <h3 class="text-offwhite font-bold font-jakarta text-base">Agentes y Automatizaciones de IA Integrados</h3>
                  <p class="text-subtle text-sm font-jakarta mt-1">Cuestionarios de pre-cualificación táctil y agentes inteligentes que capturan y nutren prospectos las 24 horas del día.</p>
                </div>
              </div>
            </div>
          </div>

          <div class="relative py-8 pl-8 flex flex-col justify-center">
            <!-- Ambient glow behind floating metrics -->
            <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-96 h-96 bg-gold/5 rounded-full blur-[100px] pointer-events-none" />
            
            <div class="space-y-10 relative z-10">
              <div class="border-l-2 border-gold pl-6 py-2 hover:translate-x-1.5 transition-transform duration-300">
                <span class="ui-caption block text-[10px]">Conversión Promedio</span>
                <div class="text-3xl font-bold text-offwhite font-playfair mt-1 tracking-tight">+<span class="metric-number" data-target="250">0</span>% más leads calificados</div>
              </div>
              <div class="border-l-2 border-gold pl-6 py-2 hover:translate-x-1.5 transition-transform duration-300">
                <span class="ui-caption block text-[10px]">Tasa de Aprobación de TI</span>
                <div class="text-3xl font-bold text-offwhite font-playfair mt-1 tracking-tight">Arquitectura SSR Server-side limpia</div>
              </div>
              <div class="border-l-2 border-gold pl-6 py-2 hover:translate-x-1.5 transition-transform duration-300">
                <span class="ui-caption block text-[10px]">Recomendabilidad IA</span>
                <div class="text-3xl font-bold text-offwhite font-playfair mt-1 tracking-tight">Optimización GEO Nativa en Schema</div>
              </div>
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- ========================================== -->
    <!-- SECTION 4: PACKAGES & PRICING -->
    <!-- ========================================== -->
    <section id="paquetes" class="py-12 md:py-16 bg-transparent relative">
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-gold/5 rounded-full blur-[150px] pointer-events-none" />

      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        
        <div class="text-center max-w-3xl mx-auto mb-16 md:mb-20">
          <span class="editorial-label text-xs block mb-3">Precios Claros y Empaquetados</span>
          <h2 class="font-playfair text-3xl md:text-4xl lg:text-5xl text-offwhite font-bold leading-tight">
            Nuestros Planes de Infraestructura
          </h2>
          <p class="text-subtle text-base md:text-lg mt-4 font-jakarta">
            Invierte en activos digitales diseñados para durar. Elige el paquete que mejor se adapte al nivel operativo actual de tu negocio:
          </p>
        </div>

        <!-- Pricing Cards Grid -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-stretch">
          
          <!-- Package 1 (Subtle borderless relief on hover) -->
          <div class="card-glow p-8 rounded-2xl border border-white/5 bg-matte flex flex-col justify-between h-full relative group">
            <div>
              <span class="ui-caption text-[10px] block mb-1">LANDING + ACTIVACIÓN IA</span>
              <h3 class="font-playfair text-2xl text-offwhite font-bold mb-2">Impulso de Captación</h3>
              <div class="text-3xl font-playfair text-gold font-bold my-4">$8,900 <span class="text-xs text-subtle font-jakarta font-normal">MXN</span></div>
              <p class="text-subtle text-sm font-jakarta leading-relaxed mb-6">
                Para negocios que necesitan validar rápidamente su oferta, captar prospectos filtrados y arrancar con IA sin construir sistemas robustos aún.
              </p>
              
              <div class="gold-rule my-6" />
              
              <ul class="space-y-4">
                <li class="flex items-start text-xs text-offwhite font-jakarta">
                  <i class="fa-solid fa-check text-gold mr-3 mt-0.5" aria-hidden="true"></i>
                  Landing Page de Alta Conversión
                </li>
                <li class="flex items-start text-xs text-offwhite font-jakarta">
                  <i class="fa-solid fa-check text-gold mr-3 mt-0.5" aria-hidden="true"></i>
                  Auditoría Express de Captación
                </li>
                <li class="flex items-start text-xs text-offwhite font-jakarta">
                  <i class="fa-solid fa-check text-gold mr-3 mt-0.5" aria-hidden="true"></i>
                  Copywriting Comercial Base
                </li>
                <li class="flex items-start text-xs text-offwhite font-jakarta">
                  <i class="fa-solid fa-check text-gold mr-3 mt-0.5" aria-hidden="true"></i>
                  Formulario o WhatsApp Integrado
                </li>
                <li class="flex items-start text-xs text-offwhite font-jakarta">
                  <i class="fa-solid fa-check text-gold mr-3 mt-0.5" aria-hidden="true"></i>
                  Sesión de Activación IA
                </li>
              </ul>
            </div>

            <div class="mt-8">
              <a 
                href="#diagnostico" 
                data-pricing-cta="impulso_captacion"
                class="pricing-cta-btn block w-full py-3 text-center text-xs font-semibold text-offwhite border border-white/10 hover:border-gold/30 hover:bg-gold/5 rounded-xl transition-all duration-300 font-jakarta active:scale-95"
              >
                Activar Captación
              </a>
            </div>
          </div>

          <!-- Package 2 - Highlighted -->
          <div class="card-glow p-8 rounded-2xl border border-gold/25 bg-matte flex flex-col justify-between h-full relative group shadow-xl shadow-gold/5">
            
            <!-- Badge centrado dentro de la tarjeta -->
            <div class="flex justify-center mb-6">
              <span class="bg-gold text-charcoal text-[11px] uppercase tracking-widest font-extrabold px-5 py-1.5 rounded-full font-jakarta shadow-md shadow-gold/20">
                ✦ Recomendado
              </span>
            </div>

            <div>
              <span class="editorial-label text-[10px] text-gold block mb-1">WEB + SEO/GEO + ROADMAP IA</span>
              <h3 class="font-playfair text-2xl text-offwhite font-bold mb-2">Sistema Web Inteligente</h3>
              <div class="text-3xl font-playfair text-gold font-bold my-4">$15,900 <span class="text-xs text-subtle font-jakarta font-normal">MXN</span></div>
              <p class="text-subtle text-sm font-jakarta leading-relaxed mb-6">
                Para empresas que demandan una presencia B2B premium: web completa de múltiples páginas, indexación semántica en IA y un plan de automatización.
              </p>
              
              <div class="w-full h-px bg-white/5 my-6" />
              
              <ul class="space-y-4">
                <li class="flex items-start text-xs text-offwhite font-jakarta">
                  <i class="fa-solid fa-check text-gold mr-3 mt-0.5"></i>
                  Página Web Corporativa Completa
                </li>
                <li class="flex items-start text-xs text-offwhite font-jakarta">
                  <i class="fa-solid fa-check text-gold mr-3 mt-0.5"></i>
                  Auditoría AI Marketing + SEO/GEO
                </li>
                <li class="flex items-start text-xs text-offwhite font-jakarta">
                  <i class="fa-solid fa-check text-gold mr-3 mt-0.5"></i>
                  Inyección SEO/GEO en Schema.org
                </li>
                <li class="flex items-start text-xs text-offwhite font-jakarta">
                  <i class="fa-solid fa-check text-gold mr-3 mt-0.5"></i>
                  Copywriting Premium Conversión
                </li>
                <li class="flex items-start text-xs text-offwhite font-jakarta">
                  <i class="fa-solid fa-check text-gold mr-3 mt-0.5"></i>
                  Roadmap de Implementación IA
                </li>
                <li class="flex items-start text-xs text-offwhite font-jakarta">
                  <i class="fa-solid fa-check text-gold mr-3 mt-0.5"></i>
                  Sesión de Entrega Estratégica
                </li>
              </ul>
            </div>

            <div class="mt-8">
              <a 
                href="#diagnostico" 
                data-pricing-cta="sistema_web_inteligente"
                class="pricing-cta-btn block w-full py-3 text-center text-xs font-semibold text-charcoal bg-gold hover:bg-gold/90 rounded-xl transition-all duration-300 font-jakarta active:scale-95 shadow-md shadow-gold/15"
              >
                Construir mi Sistema
              </a>
            </div>
          </div>


          <!-- Package 3 (Subtle borderless relief on hover) -->
          <div class="card-glow p-8 rounded-2xl border border-white/5 bg-matte flex flex-col justify-between h-full relative group">
            <div>
              <span class="ui-caption text-[10px] block mb-1">WEB + MARKETING IA + AGENTE</span>
              <h3 class="font-playfair text-2xl text-offwhite font-bold mb-2">Arquitectura IA Comercial</h3>
              <div class="text-3xl font-playfair text-gold font-bold my-4"><span class="text-xs text-subtle font-jakarta font-normal">Desde</span> $34,900 <span class="text-xs text-subtle font-jakarta font-normal">MXN</span></div>
              <p class="text-subtle text-sm font-jakarta leading-relaxed mb-6">
                Para negocios que buscan integrar presencia web premium de alta gama con un agente de IA entrenado a medida para automatizar operaciones de ventas.
              </p>
              
              <div class="gold-rule my-6" />
              
              <ul class="space-y-4">
                <li class="flex items-start text-xs text-offwhite font-jakarta">
                  <i class="fa-solid fa-check text-gold mr-3 mt-0.5" aria-hidden="true"></i>
                  Todo lo del Sistema Web Inteligente
                </li>
                <li class="flex items-start text-xs text-offwhite font-jakarta">
                  <i class="fa-solid fa-check text-gold mr-3 mt-0.5" aria-hidden="true"></i>
                  AI Digital Marketing Inicial
                </li>
                <li class="flex items-start text-xs text-offwhite font-jakarta">
                  <i class="fa-solid fa-check text-gold mr-3 mt-0.5" aria-hidden="true"></i>
                  Consultoría Estratégica en IA
                </li>
                <li class="flex items-start text-xs text-offwhite font-jakarta">
                  <i class="fa-solid fa-check text-gold mr-3 mt-0.5" aria-hidden="true"></i>
                  Agente IA Comercial Entrenado a Medida
                </li>
                <li class="flex items-start text-xs text-offwhite font-jakarta">
                  <i class="fa-solid fa-check text-gold mr-3 mt-0.5" aria-hidden="true"></i>
                  Soporte Inicial del Agente (30 días)
                </li>
                <li class="flex items-start text-xs text-offwhite font-jakarta">
                  <i class="fa-solid fa-check text-gold mr-3 mt-0.5" aria-hidden="true"></i>
                  Roadmap Estratégico 60/90 días
                </li>
              </ul>
            </div>

            <div class="mt-8">
              <a 
                href="#diagnostico" 
                data-pricing-cta="arquitectura_ia_comercial"
                class="pricing-cta-btn block w-full py-3 text-center text-xs font-semibold text-offwhite border border-white/10 hover:border-gold/30 hover:bg-gold/5 rounded-xl transition-all duration-300 font-jakarta active:scale-95"
              >
                Solicitar Propuesta
              </a>
            </div>
          </div>

        </div>

      </div>
    </section>





    <!-- ========================================== -->
    <!-- SECTION 7: LEAD CONVERSION WIZARD -->
    <!-- ========================================== -->
    <section id="diagnostico" class="py-12 md:py-16 bg-transparent relative">
