<!-- PREMIUM GSAP ENTRY & SCROLL-TRIGGER ANIMATION SYSTEM       -->
<!-- ========================================================== -->
<script>
  // @ts-nocheck
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  // Double-check ScrollTrigger registration in Astro bundle
  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener("DOMContentLoaded", () => {
    // 1. ENVIRONMENT AUDIT (Accessibility & Device Responsive Constraints)
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const isMobile = window.matchMedia('(max-width: 767px)').matches;
    const hasFinePointer = window.matchMedia('(pointer: fine)').matches;

    // 2. DRY ACCESSIBILITY NORMALIZER
    const getAnimProps = (originalProps) => {
      if (prefersReducedMotion) {
        const { y, x, scale, rotationY, rotateX, rotateY, skewX, skewY, ...rest } = originalProps;
        return {
          ...rest,
          opacity: 0,
          duration: 0.35,
          ease: "sine.out",
          stagger: originalProps.stagger ? 0.05 : 0
        };
      }

      if (isMobile) {
        const simplified = { ...originalProps };
        if (typeof simplified.y === 'number') simplified.y *= 0.4;
        if (typeof simplified.x === 'number') simplified.x *= 0.4;
        delete simplified.rotationY;
        delete simplified.rotateX;
        delete simplified.rotateY;
        if (typeof simplified.scale === 'number') simplified.scale = 0.98;
        return simplified;
      }

      return originalProps;
    };

    // 3. PREMIUM CARD-GLOW RADIAL LIGHT ACTIVATION
    if (hasFinePointer) {
      const glowCards = document.querySelectorAll('.card-glow');
      glowCards.forEach((card) => {
        card.addEventListener('mousemove', (e) => {
          const rect = card.getBoundingClientRect();
          const x = ((e.clientX - rect.left) / rect.width) * 100;
          const y = ((e.clientY - rect.top) / rect.height) * 100;
          card.style.setProperty('--mouse-x', `${x}%`);
          card.style.setProperty('--mouse-y', `${y}%`);
        });
      });
    }

    // 4. MASTER MOTION CHOREOGRAPHY INITIALIZATION
    const initAllAnimations = () => {
      if (window.__animationsInitialized) return;
      window.__animationsInitialized = true;

      // STAGE 1: HERO ENTRY ANIMATION (Triggered on Preloader End)
      const heroTl = gsap.timeline({
        defaults: { ease: "power4.out", duration: 1.2 }
      });

      // Animate Header Nav Down
      heroTl.from("header", getAnimProps({
        y: -40,
        opacity: 0,
        duration: 1
      }));

      // Animate Hero Tagline
      heroTl.from("main > section:nth-of-type(1) .editorial-label", getAnimProps({
        scale: 1.15,
        opacity: 0,
        duration: 0.8
      }), "-=0.6");

      // Animate Hero Heading (H1)
      heroTl.from("main > section:nth-of-type(1) h1", getAnimProps({
        y: 45,
        opacity: 0,
        duration: 1.2
      }), "-=0.6");

      // Animate Hero Paragraph Subtitle
      heroTl.from("main > section:nth-of-type(1) p", getAnimProps({
        y: 30,
        opacity: 0,
        duration: 1.4
      }), "-=0.8");

      // Animate Hero CTA Buttons
      heroTl.from("main > section:nth-of-type(1) a", getAnimProps({
        y: 20,
        opacity: 0,
        stagger: 0.12,
        duration: 1
      }), "-=1.1");


      // STAGE 2: SCROLLTRIGGER REVEALS (Sequential Section Entrances)

      // SECTION 2: THE PROBLEM (id="dolor")
      const dolorTl = gsap.timeline({
        scrollTrigger: {
          trigger: "#dolor",
          start: "top 82%",
          toggleActions: "play none none none"
        }
      });
      dolorTl.from("#dolor .text-center", getAnimProps({
        y: 30,
        opacity: 0,
        duration: 0.8
      }))
      .from("#dolor .grid > div", getAnimProps({
        y: 45,
        opacity: 0,
        stagger: 0.15,
        duration: 1,
        ease: "power3.out"
      }), "-=0.4");

      // SECTION 3: THE FORMULA (main > section:nth-of-type(3))
      const formulaSection = document.querySelector("main > section:nth-of-type(3)");
      if (formulaSection) {
        const formulaTl = gsap.timeline({
          scrollTrigger: {
            trigger: formulaSection,
            start: "top 82%",
            toggleActions: "play none none none"
          }
        });
        
        if (!prefersReducedMotion && !isMobile) {
          gsap.set(formulaSection.querySelector(".grid"), { perspective: 1000 });
        }

        formulaTl.from(formulaSection.querySelectorAll("h2, p:first-of-type"), getAnimProps({
          y: 30,
          opacity: 0,
          stagger: 0.15,
          duration: 0.8
        }))
        .from(formulaSection.querySelectorAll(".mt-8 > div"), getAnimProps({
          x: -40,
          opacity: 0,
          stagger: 0.18,
          duration: 0.9,
          ease: "power2.out"
        }), "-=0.5")
        .from(formulaSection.querySelector(".relative"), getAnimProps({
          x: 40,
          rotationY: -12,
          opacity: 0,
          duration: 1.3,
          ease: "power4.out"
        }), "-=0.8");
      }

      // SECTION 4: PACKAGES & PRICING (id="paquetes")
      const paquetesTl = gsap.timeline({
        scrollTrigger: {
          trigger: "#paquetes",
          start: "top 82%",
          toggleActions: "play none none none"
        }
      });
      paquetesTl.from("#paquetes .text-center", getAnimProps({
        y: 30,
        opacity: 0,
        duration: 0.8
      }))
      .from("#paquetes .grid > div", getAnimProps({
        y: 50,
        opacity: 0,
        stagger: 0.18,
        duration: 1.2,
        ease: "power4.out"
      }), "-=0.4");

      // SECTION 5: ROI CALCULATOR (main > section:nth-of-type(5))
      const roiSection = document.querySelector("main > section:nth-of-type(5)");
      if (roiSection) {
        const roiTl = gsap.timeline({
          scrollTrigger: {
            trigger: roiSection,
            start: "top 82%",
            toggleActions: "play none none none"
          }
        });
        roiTl.from(roiSection.querySelector(".text-center"), getAnimProps({
          y: 30,
          opacity: 0,
          duration: 0.8
        }))
        .from(roiSection.querySelector("div:last-child"), getAnimProps({
          scale: 0.97,
          y: 35,
          opacity: 0,
          duration: 1.1,
          ease: "back.out(1.15)"
        }), "-=0.4");
      }

      // SECTION 6: SPECIFICATIONS (main > section:nth-of-type(6))
      const specsSection = document.querySelector("main > section:nth-of-type(6)");
      if (specsSection) {
        const specsTl = gsap.timeline({
          scrollTrigger: {
            trigger: specsSection,
            start: "top 82%",
            toggleActions: "play none none none"
          }
        });
        specsTl.from(specsSection.querySelector(".text-center"), getAnimProps({
          y: 30,
          opacity: 0,
          duration: 0.8
        }))
        .from(specsSection.querySelector(".overflow-x-auto"), getAnimProps({
          y: 35,
          opacity: 0,
          duration: 1,
          ease: "power3.out"
        }), "-=0.4");
      }

      // SECTION 7: LEAD CONVERSION WIZARD (id="diagnostico")
      const diagnosticoTl = gsap.timeline({
        scrollTrigger: {
          trigger: "#diagnostico",
          start: "top 82%",
          toggleActions: "play none none none"
        }
      });
      diagnosticoTl.from("#diagnostico .text-center", getAnimProps({
        y: 30,
        opacity: 0,
        duration: 0.8
      }))
      .from("#diagnostico .shadow-2xl", getAnimProps({
        y: 45,
        opacity: 0,
        scale: 0.98,
        duration: 1.2,
        ease: "power3.out"
      }), "-=0.4");

      // SECTION 8: FAQ & OBJECTIONS (main > section:nth-of-type(8))
      const faqSection = document.querySelector("main > section:nth-of-type(8)");
      if (faqSection) {
        const faqTl = gsap.timeline({
          scrollTrigger: {
            trigger: faqSection,
            start: "top 82%",
            toggleActions: "play none none none"
          }
        });
        faqTl.from(faqSection.querySelector(".text-center"), getAnimProps({
          y: 30,
          opacity: 0,
          duration: 0.8
        }))
        .from(faqSection.querySelectorAll(".divide-y > div"), getAnimProps({
          y: 20,
          opacity: 0,
          stagger: 0.12,
          duration: 0.8,
          ease: "power2.out"
        }), "-=0.4");
      }
    };

    // 5. SYNCHRONIZED LAUNCH CONTROLLER
    window.addEventListener('preloaderComplete', initAllAnimations);

    if (document.readyState === 'complete' || document.readyState === 'interactive') {
      const preloader = document.getElementById('preloader');
      if (!preloader || preloader.style.display === 'none' || preloader.style.transform.includes('-100%')) {
        initAllAnimations();
      }
    }

    setTimeout(initAllAnimations, 3000);
  });
</script>

<style>
  @keyframes sweep-shine {
    0% { transform: translateX(-100%) skewX(-12deg); }
    100% { transform: translateX(200%) skewX(-12deg); }
  }
  .cta-shine-sweep {
    position: relative;
    overflow: hidden;
  }
  .cta-shine-sweep::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 35%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.25), transparent);
    transform: translateX(-100%) skewX(-12deg);
    pointer-events: none;
  }
  .cta-shine-sweep:hover::after {
    animation: sweep-shine 0.85s cubic-bezier(0.16, 1, 0.3, 1);
  }
</style>

