  </main>

  <footer class="bg-transparent border-t border-white/5 py-12 relative z-10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center text-xs text-subtle font-jakarta leading-normal">
      <p class="mb-2">© {new Date().getFullYear()} TAP-IA. Todos los derechos reservados. Infraestructura Digital Premium.</p>
      <p class="text-[10px]">Estrategia y Copywriting diseñado de nivel senior por TAP-TEAM.</p>
    </div>
  </footer>
