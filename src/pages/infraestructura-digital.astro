<script>
  // @ts-nocheck
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { TextPlugin } from "gsap/TextPlugin";

  // Register plugins
  gsap.registerPlugin(ScrollTrigger, TextPlugin);

  document.addEventListener("DOMContentLoaded", () => {
    // 1. DYNAMIC ENVIRONMENT AUDIT
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const isMobile = window.matchMedia('(max-width: 767px)').matches;
    const hasFinePointer = window.matchMedia('(pointer: fine)').matches;

    // 2. ACCESSIBILITY NORMALIZER
    const getAnimProps = (originalProps) => {
      if (prefersReducedMotion) {
        const { y, x, scale, rotationY, rotateX, rotateY, skewX, skewY, ...rest } = originalProps;
        return {
          ...rest,
          opacity: 0,
          duration: 0.35,
          ease: "sine.out",
          stagger: originalProps.stagger ? 0.05 : 0
        };
      }

      if (isMobile) {
        const simplified = { ...originalProps };
        if (typeof simplified.y === 'number') simplified.y *= 0.4;
        if (typeof simplified.x === 'number') simplified.x *= 0.4;
        delete simplified.rotationY;
        delete simplified.rotateX;
        delete simplified.rotateY;
        if (typeof simplified.scale === 'number') simplified.scale = 0.98;
        return simplified;
      }

      return originalProps;
    };

    // 3. SMOOTH RADIAL CARD GLOW & SUBTLE 3D TILT
    if (hasFinePointer && !prefersReducedMotion) {
      const glowCards = document.querySelectorAll('.card-glow, .pricing-cta-btn, .tile-option');
      
      glowCards.forEach((card) => {
        // Fast, interpolated setters for custom properties
        const setX = gsap.quickTo(card, "--mouse-x", { duration: 0.25, ease: "power2.out" });
        const setY = gsap.quickTo(card, "--mouse-y", { duration: 0.25, ease: "power2.out" });
        
        // 3D Tilt Setters
        const tiltX = gsap.quickTo(card, "rotateX", { duration: 0.3, ease: "power2.out" });
        const tiltY = gsap.quickTo(card, "rotateY", { duration: 0.3, ease: "power2.out" });
        const setScale = gsap.quickTo(card, "scale", { duration: 0.3, ease: "power2.out" });

        // Set high 3D perspective on parent
        if (card.parentElement) {
          card.parentElement.style.perspective = "1200px";
        }

        card.addEventListener('mousemove', (e) => {
          const rect = card.getBoundingClientRect();
          const cardWidth = rect.width;
          const cardHeight = rect.height;
          
          const x = e.clientX - rect.left;
          const y = e.clientY - rect.top;
          
          const percentX = (x / cardWidth) * 100;
          const percentY = (y / cardHeight) * 100;

          // Map mouse coordinates to tilt rotations (max tilt +/- 4 degrees)
          const rotX = -((y - cardHeight / 2) / (cardHeight / 2)) * 4;
          const rotY = ((x - cardWidth / 2) / (cardWidth / 2)) * 4;

          setX(`${percentX}%`);
          setY(`${percentY}%`);
          tiltX(rotX);
          tiltY(rotY);
          setScale(1.02);
        });

        card.addEventListener('mouseleave', () => {
          tiltX(0);
          tiltY(0);
          setScale(1);
        });
      });
    }

    // 4. THE MAGNETIC CTA SPRING MICROINTERACTION
    if (hasFinePointer && !prefersReducedMotion) {
      const magneticCTAs = document.querySelectorAll('.cta-magnetic');
      
      magneticCTAs.forEach((btn) => {
        const innerText = btn.querySelector('.cta-magnetic-inner');
        
        btn.addEventListener('mousemove', (e) => {
          const rect = btn.getBoundingClientRect();
          const btnWidth = rect.width;
          const btnHeight = rect.height;
          
          const mx = e.clientX - rect.left - btnWidth / 2;
          const my = e.clientY - rect.top - btnHeight / 2;

          // Magnet strength: pull button 15px max, inner text 6px max
          gsap.to(btn, {
            x: mx * 0.35,
            y: my * 0.35,
            duration: 0.3,
            ease: "power2.out"
          });
          
          if (innerText) {
            gsap.to(innerText, {
              x: mx * 0.15,
              y: my * 0.15,
              duration: 0.3,
              ease: "power2.out"
            });
          }
        });

        btn.addEventListener('mouseleave', () => {
          // Elastic spring-back to resting position
          gsap.to(btn, {
            x: 0,
            y: 0,
            duration: 0.8,
            ease: "elastic.out(1.1, 0.45)"
          });
          
          if (innerText) {
            gsap.to(innerText, {
              x: 0,
              y: 0,
              duration: 0.8,
              ease: "elastic.out(1.1, 0.45)"
            });
          }
        });
      });
    }

    // 5. MASTER MOTION CHOREOGRAPHY INITIALIZATION
    const initAllAnimations = () => {
      if (window.__animationsInitialized) return;
      window.__animationsInitialized = true;

      // STAGE 1: HERO ENTRY ANIMATION
      const heroTl = gsap.timeline({
        defaults: { ease: "expo.out", duration: 1.4 }
      });

      // Animate Header Nav Down
      heroTl.from("header", getAnimProps({
        y: -40,
        opacity: 0,
        duration: 1
      }));

      // Animate Hero Tagline
      heroTl.from("main > section:nth-of-type(1) .editorial-label", getAnimProps({
        scale: 1.15,
        opacity: 0,
        duration: 0.9
      }), "-=0.8");

      // Typewriter del título (using TextPlugin)
      const titleBase = document.getElementById('typewriter-base');
      const titleAccent = document.getElementById('typewriter-accent');
      const cursorBase = document.getElementById('cursor-base');
      const cursorAccent = document.getElementById('cursor-accent');

      const textBase = "No tengas solo una web.";
      const textAccent = "Crea una Infraestructura Digital.";

      if (!prefersReducedMotion && !isMobile && titleBase && titleAccent && cursorBase && cursorAccent) {
        heroTl.set(cursorBase, { opacity: 1 }, "-=0.5")
          .to(titleBase, {
            text: textBase,
            duration: 1.8,
            ease: "none"
          })
          .set(cursorBase, { opacity: 0 })
          .set(cursorAccent, { opacity: 1 }, "+=0.15")
          .to(titleAccent, {
            text: textAccent,
            duration: 1.8,
            ease: "none"
          }, "+=0.1")
          .call(() => {
            gsap.to(cursorAccent, {
              opacity: 0,
              duration: 0.45,
              repeat: -1,
              ease: "steps(1)",
              yoyo: true
            });
          });
      } else {
        if (titleBase) titleBase.textContent = textBase;
        if (titleAccent) titleAccent.textContent = textAccent;
        if (cursorBase) cursorBase.style.display = 'none';
        if (cursorAccent) cursorAccent.style.display = 'none';

        heroTl.from("main > section:nth-of-type(1) h1", getAnimProps({
          y: 60,
          opacity: 0,
          duration: 1.5,
          ease: "expo.out"
        }), "-=0.7");
      }

      // Animate Hero Paragraph Subtitle
      heroTl.from("main > section:nth-of-type(1) p", getAnimProps({
        y: 35,
        opacity: 0,
        duration: 1.4,
        ease: "power3.out"
      }), "-=1.1");

      // Animate Hero CTA Buttons
      heroTl.from("main > section:nth-of-type(1) a", getAnimProps({
        y: 25,
        opacity: 0,
        stagger: 0.12,
        duration: 1.1,
        ease: "power2.out"
      }), "-=1.2");


      // STAGE 2: SCROLL-DRIVEN BACKGROUND PARALLAX ORBS
      if (!prefersReducedMotion && !isMobile) {
        gsap.to("main .absolute.rounded-full.blur-\\[120px\\], main .absolute.rounded-full.blur-\\[100px\\], main .absolute.rounded-full.blur-\\[150px\\]", {
          yPercent: -45,
          ease: "none",
          scrollTrigger: {
            trigger: "main",
            start: "top top",
            end: "bottom bottom",
            scrub: 1.5
          }
        });
      }

      // STAGE 3: SCROLLTRIGGER SECTION ENTRIES

      // SECTION 2: THE PROBLEM (id="dolor")
      const dolorTl = gsap.timeline({
        scrollTrigger: {
          trigger: "#dolor",
          start: "top 80%",
          toggleActions: "play none none none"
        }
      });
      dolorTl.from("#dolor .text-center", getAnimProps({
        y: 30,
        opacity: 0,
        duration: 0.8
      }))
      .from("#dolor .grid > div", getAnimProps({
        y: 45,
        opacity: 0,
        stagger: 0.15,
        duration: 1.1,
        ease: "power3.out"
      }), "-=0.55");

      // SECTION 3: THE FORMULA
      const formulaSection = document.querySelector("main > section:nth-of-type(3)");
      if (formulaSection) {
        const formulaTl = gsap.timeline({
          scrollTrigger: {
            trigger: formulaSection,
            start: "top 80%",
            toggleActions: "play none none none"
          }
        });
        
        if (!prefersReducedMotion && !isMobile) {
          gsap.set(formulaSection.querySelector(".grid"), { perspective: 1200 });
        }

        formulaTl.from(formulaSection.querySelectorAll("h2, p:first-of-type"), getAnimProps({
          y: 30,
          opacity: 0,
          stagger: 0.12,
          duration: 0.8
        }))
        .from(formulaSection.querySelectorAll(".mt-8 > div"), getAnimProps({
          x: -35,
          opacity: 0,
          stagger: 0.15,
          duration: 0.9,
          ease: "power2.out"
        }), "-=0.5")
        .from(formulaSection.querySelector(".relative"), getAnimProps({
          x: 40,
          rotationY: -8,
          opacity: 0,
          duration: 1.2,
          ease: "power4.out"
        }), "-=0.8")
        .from(formulaSection.querySelectorAll(".space-y-10 > div"), getAnimProps({
          opacity: 0,
          x: 20,
          stagger: 0.12,
          duration: 0.7,
          ease: "power2.out"
        }), "-=0.4");

        // TRIGGER NUMERICAL METRIC COUNT-UP TWEENING
        if (!prefersReducedMotion) {
          const metricNumbers = formulaSection.querySelectorAll('.metric-number');
          metricNumbers.forEach((num) => {
            const targetVal = parseFloat(num.getAttribute('data-target') || '0');
            const counterObj = { val: 0 };
            
            gsap.to(counterObj, {
              val: targetVal,
              duration: 2.2,
              ease: "power4.out",
              scrollTrigger: {
                trigger: num,
                start: "top 88%"
              },
              onUpdate: () => {
                num.textContent = Math.floor(counterObj.val).toString();
              }
            });
          });
        } else {
          formulaSection.querySelectorAll('.metric-number').forEach((num) => {
            num.textContent = num.getAttribute('data-target') || '0';
          });
        }
      }

      // SECTION 4: PACKAGES & PRICING (id="paquetes")
      const paquetesTl = gsap.timeline({
        scrollTrigger: {
          trigger: "#paquetes",
          start: "top 80%",
          toggleActions: "play none none none"
        }
      });
      
      paquetesTl.from("#paquetes .text-center", getAnimProps({
        y: 35,
        opacity: 0,
        duration: 0.8
      }));

      const cards = document.querySelectorAll("#paquetes .grid > div");
      cards.forEach((card, index) => {
        const isHighlighted = card.classList.contains('card-glow');
        const customProps = getAnimProps({
          y: 60,
          scale: isHighlighted ? 0.94 : 1,
          opacity: 0,
          duration: 1.3,
          ease: isHighlighted ? "back.out(1.15)" : "expo.out"
        });

        paquetesTl.from(card, customProps, index === 0 ? "-=0.4" : "-=1.1");
      });





      // SECTION 7: LEAD CONVERSION WIZARD
      const diagnosticoTl = gsap.timeline({
        scrollTrigger: {
          trigger: "#diagnostico",
          start: "top 95%",
          toggleActions: "play none none none"
        }
      });
      diagnosticoTl.from("#diagnostico .text-center", getAnimProps({
        y: 30,
        opacity: 0,
        duration: 0.8
      }))
      .from("#diagnostico .matte-card", getAnimProps({
        y: 40,
        opacity: 0,
        scale: 0.99,
        duration: 1.1,
        ease: "power3.out"
      }), "-=0.4");

      // SECTION 8: FAQ & OBJECTIONS
      const faqSection = document.querySelector("#faq");
      if (faqSection) {
        const faqTl = gsap.timeline({
          scrollTrigger: {
            trigger: faqSection,
            start: "top 95%",
            toggleActions: "play none none none"
          }
        });
        faqTl.from(faqSection.querySelector(".text-center"), getAnimProps({
          y: 30,
          opacity: 0,
          duration: 0.8
        }))
        .from(faqSection.querySelectorAll("details"), getAnimProps({
          y: 20,
          opacity: 0,
          stagger: 0.12,
          duration: 0.8,
          ease: "power2.out"
        }), "-=0.45");
      }
    };

    // 6. SYNCHRONIZED LAUNCH CONTROLLER
    window.addEventListener('preloaderComplete', initAllAnimations);

    if (document.readyState === 'complete' || document.readyState === 'interactive') {
      const preloader = document.getElementById('preloader');
      if (!preloader || preloader.style.display === 'none' || preloader.style.transform.includes('-100%')) {
        initAllAnimations();
      }
    }

    setTimeout(initAllAnimations, 3000);

    // 7. PRICING CTA INTERCEPT & DISPATCH WIZARD EVENT
    document.querySelectorAll('.pricing-cta-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const plan = btn.getAttribute('data-pricing-cta');
        if (plan) {
          const selectPlanEvent = new CustomEvent('selectContactWizardPlan', {
            detail: { plan: plan }
          });
          window.dispatchEvent(selectPlanEvent);
        }
      });
    });
  });
</script>

<style>
  /* 1. PREMIUM GOLD SHINE SWEEP */
  @keyframes sweep-shine {
    0% { transform: translateX(-100%) skewX(-12deg); }
    100% { transform: translateX(220%) skewX(-12deg); }
  }
  .cta-shine-sweep {
    position: relative;
    overflow: hidden;
  }
  .cta-shine-sweep::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 40%;
    height: 100%;
    background: linear-gradient(90deg, 
      rgba(212, 175, 55, 0) 0%, 
      rgba(212, 175, 55, 0.22) 50%, 
      rgba(212, 175, 55, 0) 100%
    );
    transform: translateX(-100%) skewX(-12deg);
    pointer-events: none;
    will-change: transform;
  }
  .cta-shine-sweep:hover::after {
    animation: sweep-shine 0.9s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* 2. HARDWARE ACCELERATION CLASS */
  .card-glow, .pricing-cta-btn, .tile-option, .cta-magnetic {
    will-change: transform, opacity;
    transform-style: preserve-3d;
    backface-visibility: hidden;
  }
</style>
