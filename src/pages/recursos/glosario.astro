---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PremiumSectionHeader from '../../components/PremiumSectionHeader.astro';

// Definición de los términos del glosario para renderizado dinámico
const terms = [
  {
    id: "geo",
    title: "GEO (Generative Engine Optimization)",
    shortDef: "Optimización para motores generativos de IA.",
    fullDef: "Es el conjunto de técnicas y estrategias diseñadas para optimizar la estructura, el contenido y las señales de autoridad de un sitio web, con el fin de maximizar la probabilidad de que la marca sea entendida, recuperada y citada en las respuestas generadas por inteligencias artificiales como ChatGPT, Gemini, Claude y Perplexity.",
    citationTip: "Para optimizar GEO, utiliza fuentes primarias, incluye datos estadísticos en tablas claras, define conceptos de forma directa al inicio del párrafo y mantén un archivo llms.txt actualizado."
  },
  {
    id: "rag",
    title: "RAG (Retrieval-Augmented Generation)",
    shortDef: "Generación aumentada por recuperación de datos.",
    fullDef: "Una arquitectura de software que permite a un modelo de lenguaje (LLM) consultar fuentes de información externas y autorizadas (como tu sitio web o base de datos interna) antes de formular una respuesta. Esto garantiza que las respuestas del modelo sean precisas, actualizadas y no dependan únicamente de sus datos de entrenamiento.",
    citationTip: "Los sistemas RAG buscan bases de conocimiento estructuradas. Facilitar el rastreo de tus datos con formatos limpios y estructurados en JSON-LD simplifica su consumo."
  },
  {
    id: "aeo",
    title: "AEO (Answer Engine Optimization)",
    shortDef: "Optimización para motores de respuestas directas.",
    fullDef: "Estrategia de posicionamiento que consiste en estructurar el contenido web para dar respuestas directas, concisas y estructuradas a preguntas específicas de los usuarios. Es el precursor del GEO y se enfoca en optimizar fragmentos destacados (Featured Snippets), asistentes de voz y cuadros de respuesta de motores de búsqueda clásicos.",
    citationTip: "Escribe títulos en formato de pregunta directa (H2 o H3) seguidos inmediatamente por una respuesta de un solo párrafo de menos de 50 palabras."
  },
  {
    id: "llms-txt",
    title: "LLMs.txt",
    shortDef: "Estándar de descubrimiento y contexto para agentes de IA.",
    fullDef: "Un archivo de texto plano localizado en el directorio raíz de un dominio (/llms.txt) que proporciona un mapa y resumen estructurado en formato Markdown. Ayuda a los rastreadores y agentes autónomos de IA a comprender rápidamente la arquitectura, servicios y recursos de un sitio web sin necesidad de rastrear el HTML completo.",
    citationTip: "El archivo llms.txt debe ser conciso, contener enlaces limpios a las páginas más importantes de tu dominio y estar enlazado desde tu robots.txt."
  },
  {
    id: "eeat",
    title: "E-E-A-T (Experience, Expertise, Authoritativeness, Trustworthiness)",
    shortDef: "Directrices de calidad de Google enfocadas en la confianza.",
    fullDef: "Es el acrónimo en inglés de Experiencia, Expertez, Autoridad y Confianza. Es el marco conceptual que utilizan los evaluadores humanos de Google (y sus algoritmos) para evaluar la calidad y veracidad del contenido en la web. Las IAs generativas heredan estos principios para filtrar contenido de baja calidad o generado de forma masiva sin supervisión humana.",
    citationTip: "Establece la autoría física de tus contenidos mediante perfiles de autor reales, enlaces a credenciales profesionales externas y el uso del esquema estructurado Person."
  },
  {
    id: "agentes-ia",
    title: "Agentes IA (AI Agents)",
    shortDef: "Sistemas autónomos multitarea orientados a objetivos.",
    fullDef: "Programas de software autónomos que utilizan modelos de lenguaje como motor de razonamiento. A diferencia de los chatbots tradicionales que solo responden mensajes, los agentes de IA pueden planificar pasos, utilizar herramientas externas (como APIs, CRMs y bases de datos) y ejecutar flujos de trabajo complejos para alcanzar un objetivo de negocio sin intervención humana constante.",
    citationTip: "En marketing, los agentes IA permiten calificar prospectos en tiempo real, nutrir CRM y automatizar la recopilación de datos de analítica digital."
  }
];

// Generación de FAQs de Schema para optimizar GEO e indexación de respuestas directas
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": terms.map(term => ({
    "@type": "Question",
    "name": `¿Qué es ${term.title}?`,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": term.fullDef
    }
  }))
};
---

<Layout
    title="Glosario IA Aplicada a Negocios | Recursos Tap-IA"
    description="Glosario de conceptos técnicos de Inteligencia Artificial, SEO/GEO, y automatización explicados con criterio y orientados a resultados de negocio."
>
    <Header />
    
    <!-- FAQ Schema inline for search engine ingestion -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />

    <main class="relative overflow-hidden pt-36 pb-24 px-6 z-10">
        <!-- Fondos decorativos premium -->
        <div class="absolute top-1/4 right-0 w-[500px] h-[500px] bg-royal/5 rounded-full blur-[110px] pointer-events-none -z-10"></div>
        <div class="absolute bottom-1/4 left-0 w-[600px] h-[600px] bg-gold/5 rounded-full blur-[110px] pointer-events-none -z-10"></div>

        <div class="max-w-5xl mx-auto">
            <!-- Breadcrumbs -->
            <nav class="flex mb-8 text-xs font-mono tracking-widest uppercase text-subtle/70" aria-label="Breadcrumb">
                <ol class="inline-flex items-center space-x-1 md:space-x-3">
                    <li class="inline-flex items-center">
                        <a href="/" class="hover:text-gold transition-colors">Inicio</a>
                    </li>
                    <li>
                        <div class="flex items-center">
                            <span class="mx-2 text-white/20">/</span>
                            <a href="/recursos" class="hover:text-gold transition-colors">Recursos</a>
                        </div>
                    </li>
                    <li aria-current="page">
                        <div class="flex items-center">
                            <span class="mx-2 text-white/20">/</span>
                            <span class="text-offwhite">Glosario IA</span>
                        </div>
                    </li>
                </ol>
            </nav>

            <PremiumSectionHeader 
                label="Activo de Citabilidad" 
                title="Glosario de Inteligencia <br/><span class='italic text-white/60'>Artificial Aplicada</span>" 
                subtitle="Definiciones concisas y orientadas a la práctica de términos clave en la era de la búsqueda y la automatización inteligente."
                centered={false}
            />

            <!-- INTRODUCCIÓN ESTÁTICA -->
            <div class="mt-8 mb-12 max-w-3xl text-subtle text-sm leading-relaxed space-y-4">
                <p>
                    El ecosistema de la inteligencia artificial evoluciona a un ritmo sin precedentes, trayendo consigo una serie de términos técnicos y acrónimos que a menudo se malinterpretan o se usan como tácticas de mercadotecnia vacías. Este glosario ha sido diseñado para líderes de negocio, directores de marketing y fundadores que buscan claridad conceptual y operativa.
                </p>
                <p>
                    Aquí definimos con rigor técnico y comercial términos clave como GEO (Generative Engine Optimization), RAG (Retrieval-Augmented Generation) y AEO (Answer Engine Optimization). Nuestro objetivo es dotarte del criterio necesario para supervisar implementaciones de software, comprender los cambios de algoritmo en los motores de búsqueda de IA, y estructurar el conocimiento propietario de tu marca para que sea citable y recuperable por modelos de lenguaje avanzados.
                </p>
                <p>
                    Además de las definiciones conceptuales, incluimos recomendaciones prácticas de optimización de citabilidad para cada concepto. Esto permite que tu equipo de contenidos y desarrollo de sistemas aplique de inmediato buenas prácticas que aumenten la visibilidad digital orgánica de tu marca frente a los rastreadores automatizados de inteligencias artificiales. Consulta este glosario de manera regular para alinear tus estrategias con los estándares técnicos más recientes.
                </p>
            </div>

            <!-- Contenedor del Glosario -->
            <div class="mt-16 space-y-8">
                {terms.map((term, index) => (
                    <article 
                        id={term.id} 
                        class="p-6 md:p-8 rounded-2xl bg-[#161922]/20 border border-white/5 backdrop-blur-md hover:border-gold/25 transition-all duration-500 group relative"
                    >
                        <div class="absolute inset-0 bg-noise opacity-[0.01] pointer-events-none rounded-2xl"></div>
                        <div class="absolute top-6 right-6 text-gold/30 font-mono text-sm md:text-base select-none">
                            {String(index + 1).padStart(2, '0')}
                        </div>

                        <div class="max-w-3xl space-y-4">
                            <span class="text-gold text-[10px] font-mono tracking-widest uppercase block">
                                {term.shortDef}
                            </span>
                            <h2 class="font-serif text-2xl md:text-3xl text-white font-light tracking-tight group-hover:text-gold transition-colors duration-300">
                                {term.title}
                            </h2>
                            <p class="text-subtle font-light text-base md:text-lg leading-relaxed">
                                {term.fullDef}
                            </p>
                            
                            <!-- Tip de Citación GEO -->
                            <div class="pt-4 border-t border-white/5 flex gap-3 items-start">
                                <span class="w-1.5 h-1.5 rounded-full bg-gold shrink-0 mt-2"></span>
                                <p class="text-xs text-slate-400 font-mono italic">
                                    <strong class="text-gold font-normal">Tip GEO:</strong> {term.citationTip}
                                </p>
                            </div>
                        </div>
                    </article>
                ))}
            </div>

            <!-- Footer CTA -->
            <section class="mt-16 p-8 rounded-2xl border border-white/5 bg-[#161922]/10 backdrop-blur-sm text-center">
                <h3 class="font-serif text-xl md:text-2xl text-white mb-2 font-light">¿Quieres profundizar en cómo aplicar estas tecnologías?</h3>
                <p class="text-sm text-subtle max-w-xl mx-auto mb-6 font-light">
                    Agenda un diagnóstico express para evaluar el ecosistema tecnológico de tu marca y diseñar un plan personalizado de visibilidad e IA.
                </p>
                <div class="flex justify-center gap-4 flex-wrap">
                    <a href="/contacto" class="px-6 py-3 bg-gold text-charcoal font-medium text-xs font-mono tracking-widest uppercase rounded hover:bg-white transition-colors duration-500">
                        Solicitar Diagnóstico
                    </a>
                    <a href="/soluciones/seo-geo" class="px-6 py-3 border border-white/20 text-white font-medium text-xs font-mono tracking-widest uppercase rounded hover:bg-white/5 transition-colors duration-500">
                        Ver Servicio SEO/GEO
                    </a>
                </div>
            </section>
        </div>
    </main>

    <Footer />
</Layout>
