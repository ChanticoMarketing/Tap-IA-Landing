---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<Layout title="Recursos TAP-IA | Plantillas y Guías">
    <Header />

    <section class="min-h-[40vh] pt-36 pb-12 px-6 relative border-b border-white/5 bg-charcoal">
        <div class="absolute top-20 right-1/4 w-[400px] h-[400px] bg-gold/5 rounded-full blur-[80px] pointer-events-none -z-10"></div>
        <div class="max-w-7xl mx-auto text-center">
            <h1 class="font-serif text-5xl md:text-6xl text-white mb-6">Biblioteca de Recursos</h1>
            <p class="text-subtle text-lg max-w-2xl mx-auto">Múltiples plantillas, playbooks y guías para directores y founders que buscan resultados predecibles.</p>
        </div>
    </section>

    <section class="py-20 px-6">
        <div class="max-w-7xl mx-auto">
            
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                <!-- RECURSO 1 -->
                <div class="matte-card rounded-2xl overflow-hidden flex flex-col h-full border border-white/5 hover:border-gold/30 transition-colors">
                    <div class="bg-matte h-48 border-b border-white/10 flex items-center justify-center relative overflow-hidden">
                        <i class="fa-solid fa-file-invoice text-6xl text-white/5"></i>
                        <div class="absolute bottom-4 left-4 bg-charcoal/80 backdrop-blur px-3 py-1 rounded text-xs font-bold uppercase tracking-wider text-gold">Plantilla</div>
                    </div>
                    
                    <div class="p-8 flex flex-col flex-grow">
                        <h3 class="text-xl text-white font-serif mb-3">Auditoría SEO-GEO (Checklist)</h3>
                        <p class="text-sm text-subtle mb-8 flex-grow">25 puntos críticos que tu sitio debe cumplir para no desaparecer de Google AI.</p>
                        
                        <button disabled class="w-full text-center py-3 bg-white/5 text-subtle rounded text-sm font-medium border border-white/10 cursor-not-allowed opacity-60">
                            Próximamente
                        </button>
                    </div>
                </div>

                <!-- RECURSO 2 -->
                <div class="matte-card rounded-2xl overflow-hidden flex flex-col h-full border border-white/5 hover:border-gold/30 transition-colors">
                    <div class="bg-matte h-48 border-b border-white/10 flex items-center justify-center relative overflow-hidden">
                        <i class="fa-solid fa-book-open text-6xl text-white/5"></i>
                        <div class="absolute bottom-4 left-4 bg-charcoal/80 backdrop-blur px-3 py-1 rounded text-xs font-bold uppercase tracking-wider text-gold">Playbook</div>
                    </div>
                    
                    <div class="p-8 flex flex-col flex-grow">
                        <h3 class="text-xl text-white font-serif mb-3">El Framework de Ventas Zero-JS</h3>
                        <p class="text-sm text-subtle mb-8 flex-grow">Por qué Astro está reemplazando a Wordpress en sitios B2B de alto margen operativo.</p>
                        
                        <button disabled class="w-full text-center py-3 bg-white/5 text-subtle rounded text-sm font-medium border border-white/10 cursor-not-allowed opacity-60">
                            Próximamente
                        </button>
                    </div>
                </div>

            </div>
        </div>
    </section>

    <Footer />
</Layout>
