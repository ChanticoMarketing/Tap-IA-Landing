---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CtaWhatsApp from '../../components/CtaWhatsApp.astro';
---

<Layout title="Portafolio Tap-IA | Entregables Visuales">
    <Header />

    <main>

    <section class="min-h-[50vh] pt-40 pb-20 px-6 relative">
        <div class="absolute top-20 right-1/4 w-[350px] h-[350px] bg-gold/8 rounded-full blur-[80px] pointer-events-none -z-10"></div>
        <div class="max-w-7xl mx-auto text-center">
            <h1 class="mb-8 text-white leading-tight">Portafolio (Demos)<br><span class="italic text-gold font-light text-[0.7em]">metodología + entregables</span></h1>
            
            <!-- Disclaimer requerido -->
            <div class="mt-10 mb-16 inline-block max-w-2xl bg-white/5 border border-white/10 p-6 rounded-xl">
                <p class="text-sm text-subtle italic leading-relaxed">
                    <i class="fa-solid fa-circle-info text-gold mr-2 text-xs"></i> 
                    Para proteger los Acuerdos de Confidencialidad (NDA) de nuestros clientes Enterprise, los proyectos mostrados son Demos Demostrativos construidos para exhibir nuestro proceso, precisión en entregables y calidad sin comprometer data sensible.
                </p>
            </div>
            
            <div class="mt-6 text-center">
                <CtaWhatsApp text="Quiero implementar esta calidad" />
            </div>
        </div>
    </section>

    <!-- EXPLORAR POR SOLUCIÓN — Interactive Showcase Grid -->
    <section class="solutions-showcase py-32 px-6 relative border-t border-white/5">
        <div class="max-w-7xl mx-auto">
            <h2 class="mb-16 text-white">Explorar por Solución</h2>
            
            <!-- Featured Card (full width) -->
            <a href="/portafolio/sitios-web" class="showcase-card group relative flex flex-col md:flex-row items-stretch rounded-2xl overflow-hidden border border-white/[0.06] hover:border-gold/30 transition-all duration-500 bg-gradient-to-r from-[#1a1d24] to-[#12141a] mb-8">
                <div class="flex-[3] p-10 md:p-16 flex flex-col justify-center relative z-10">
                    <span class="ui-caption text-gold/60 mb-4 block"><i class="fa-solid fa-laptop-code mr-2"></i>Interfaz & Conversión</span>
                    <h3 class="text-white/90 group-hover:text-white transition-colors mb-4 text-4xl md:text-5xl">Sitios Web</h3>
                    <p class="text-sm text-subtle max-w-md leading-relaxed">Interfaces optimizadas para carga en &lt; 1.5s, diseñadas para capturar leads B2B con tasas de conversión superiores.</p>
                    <span class="inline-flex items-center gap-2 mt-8 text-sm text-gold font-bold uppercase tracking-widest opacity-0 group-hover:opacity-100 transition-all duration-300 transform translate-y-2 group-hover:translate-y-0">
                        Ver demos <i class="fa-solid fa-arrow-right"></i>
                    </span>
                </div>
                <div class="flex-[2] flex items-center justify-center p-10 md:p-16">
                    <div class="w-48 h-48 md:w-64 md:h-64 rounded-full bg-gradient-to-br from-gold/15 to-gold/5 border border-gold/10 opacity-50 group-hover:opacity-100 transition-all duration-700"></div>
                </div>
            </a>

            <!-- 2x2 Grid -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                <a href="/portafolio/seo-geo" class="showcase-card group relative rounded-2xl p-10 md:p-12 overflow-hidden border border-white/[0.06] hover:border-gold/30 transition-all duration-500 bg-gradient-to-br from-[#191c22] to-[#11131a] flex flex-col justify-between min-h-[300px]">
                    <span class="absolute top-8 right-8 text-[6rem] leading-none opacity-[0.03] group-hover:opacity-[0.08] transition-opacity duration-500 pointer-events-none select-none">🔍</span>
                    <div class="relative z-10">
                        <span class="ui-caption text-gold/60 mb-5 block"><i class="fa-solid fa-magnifying-glass-chart mr-2"></i>Autoridad Orgánica</span>
                        <h3 class="text-white/90 group-hover:text-white transition-colors mb-3">SEO-GEO</h3>
                        <p class="text-sm text-subtle leading-relaxed">Aumento de tráfico cualificado mediante Schema estructurado y posicionamiento en ChatGPT/Google AI.</p>
                    </div>
                    <span class="inline-flex items-center gap-2 mt-8 text-sm text-gold font-bold uppercase tracking-widest opacity-0 group-hover:opacity-100 transition-all duration-300 transform translate-y-2 group-hover:translate-y-0">
                        Ver demos <i class="fa-solid fa-arrow-right"></i>
                    </span>
                </a>

                <a href="/portafolio/agentes-ia" class="showcase-card group relative rounded-2xl p-10 md:p-12 overflow-hidden border border-white/[0.06] hover:border-gold/30 transition-all duration-500 bg-gradient-to-br from-[#1b1820] to-[#13111a] flex flex-col justify-between min-h-[300px]">
                    <span class="absolute top-8 right-8 text-[6rem] leading-none opacity-[0.03] group-hover:opacity-[0.08] transition-opacity duration-500 pointer-events-none select-none">🤖</span>
                    <div class="relative z-10">
                        <span class="ui-caption text-gold/60 mb-5 block"><i class="fa-solid fa-robot mr-2"></i>Operaciones Autónomas</span>
                        <h3 class="text-white/90 group-hover:text-white transition-colors mb-3">Agentes IA</h3>
                        <p class="text-sm text-subtle leading-relaxed">Reducción del 80% en tiempo de respuesta con asistentes de ventas que cualifican 24/7.</p>
                    </div>
                    <span class="inline-flex items-center gap-2 mt-8 text-sm text-gold font-bold uppercase tracking-widest opacity-0 group-hover:opacity-100 transition-all duration-300 transform translate-y-2 group-hover:translate-y-0">
                        Ver demos <i class="fa-solid fa-arrow-right"></i>
                    </span>
                </a>

                <a href="/portafolio/webapps" class="showcase-card group relative rounded-2xl p-10 md:p-12 overflow-hidden border border-white/[0.06] hover:border-gold/30 transition-all duration-500 bg-gradient-to-br from-[#181b22] to-[#10121a] flex flex-col justify-between min-h-[300px]">
                    <span class="absolute top-8 right-8 text-[6rem] leading-none opacity-[0.03] group-hover:opacity-[0.08] transition-opacity duration-500 pointer-events-none select-none">⚡</span>
                    <div class="relative z-10">
                        <span class="ui-caption text-gold/60 mb-5 block"><i class="fa-solid fa-code mr-2"></i>Plataformas Operativas</span>
                        <h3 class="text-white/90 group-hover:text-white transition-colors mb-3">WebApps</h3>
                        <p class="text-sm text-subtle leading-relaxed">Eliminación de cuellos de botella con dashboards ERP/CRM diseñados para su operativa.</p>
                    </div>
                    <span class="inline-flex items-center gap-2 mt-8 text-sm text-gold font-bold uppercase tracking-widest opacity-0 group-hover:opacity-100 transition-all duration-300 transform translate-y-2 group-hover:translate-y-0">
                        Ver demos <i class="fa-solid fa-arrow-right"></i>
                    </span>
                </a>

                <a href="/portafolio/ai-marketing" class="showcase-card group relative rounded-2xl p-10 md:p-12 overflow-hidden border border-white/[0.06] hover:border-gold/30 transition-all duration-500 bg-gradient-to-br from-[#1a1d24] to-[#12141a] flex flex-col justify-between min-h-[300px]">
                    <span class="absolute top-8 right-8 text-[6rem] leading-none opacity-[0.03] group-hover:opacity-[0.08] transition-opacity duration-500 pointer-events-none select-none">📊</span>
                    <div class="relative z-10">
                        <span class="ui-caption text-gold/60 mb-5 block"><i class="fa-solid fa-bullseye mr-2"></i>Automatización Inteligente</span>
                        <h3 class="text-white/90 group-hover:text-white transition-colors mb-3">AI Marketing</h3>
                        <p class="text-sm text-subtle leading-relaxed">Entregables de analítica, funnels y workflows automatizados.</p>
                    </div>
                    <span class="inline-flex items-center gap-2 mt-8 text-sm text-gold font-bold uppercase tracking-widest opacity-0 group-hover:opacity-100 transition-all duration-300 transform translate-y-2 group-hover:translate-y-0">
                        Ver demos <i class="fa-solid fa-arrow-right"></i>
                    </span>
                </a>
            </div>

            <!-- Bottom wide card -->
            <a href="/portafolio/avatares-ia" class="showcase-card group relative flex flex-col md:flex-row items-center rounded-2xl overflow-hidden border border-white/[0.06] hover:border-gold/30 transition-all duration-500 bg-gradient-to-r from-[#1a1820] to-[#12101a] mt-8">
                <div class="flex-[3] p-10 md:p-16 relative z-10">
                    <span class="ui-caption text-gold/60 mb-4 block"><i class="fa-solid fa-user-astronaut mr-2"></i>Comunicación Escalable</span>
                    <h3 class="text-white/90 group-hover:text-white transition-colors mb-4 text-4xl">Avatares IA</h3>
                    <p class="text-sm text-subtle max-w-md leading-relaxed">Clones de video generados para social media a escala.</p>
                    <span class="inline-flex items-center gap-2 mt-8 text-sm text-gold font-bold uppercase tracking-widest opacity-0 group-hover:opacity-100 transition-all duration-300 transform translate-y-2 group-hover:translate-y-0">
                        Ver demos <i class="fa-solid fa-arrow-right"></i>
                    </span>
                </div>
                <div class="flex-[2] flex items-center justify-center p-10 md:p-16">
                    <div class="w-48 h-48 md:w-64 md:h-64 rounded-full bg-gradient-to-br from-gold/15 to-gold/5 border border-gold/10 opacity-50 group-hover:opacity-100 transition-all duration-700"></div>
                </div>
            </a>
        </div>
    </section>
        </div>
    </section>

    </main>

    <Footer />
</Layout>

<script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
        const gsap = window.gsap;
        const ScrollTrigger = window.ScrollTrigger;
        if (!gsap || !ScrollTrigger) return;

        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (prefersReducedMotion) return;

        // Showcase cards — clipPath curtain reveal
        gsap.fromTo(".showcase-card",
            { clipPath: "inset(100% 0 0 0)", opacity: 0 },
            {
                clipPath: "inset(0% 0 0 0)", opacity: 1, duration: 0.9, stagger: 0.12, ease: "power3.out",
                scrollTrigger: {
                    trigger: ".solutions-showcase",
                    start: "top 80%",
                    once: true
                }
            }
        );
    });
</script>
