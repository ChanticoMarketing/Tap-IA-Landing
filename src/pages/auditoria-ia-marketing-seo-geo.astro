---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CtaWhatsApp from '../components/CtaWhatsApp.astro';
import SchemaService from '../components/SchemaService.astro';
---

<Layout 
    title="Auditoría IA & SEO/GEO | Diagnóstico de Visibilidad | TAP-IA"
    description="Auditoría integral de Inteligencia Artificial aplicada a negocio, marketing digital avanzado y estrategias de visibilidad SEO/GEO."
>

    <Header />
    <SchemaService 
        name="Auditoría IA, Marketing y SEO/GEO"
        description="Auditoría integral de Inteligencia Artificial aplicada a negocio, marketing digital avanzado y estrategias de visibilidad SEO/GEO."
        url="/auditoria-ia-marketing-seo-geo"
        serviceType="AI, Marketing and SEO/GEO Audit"
    />

    <section class="relative min-h-[60vh] pt-36 pb-10 px-6 flex flex-col items-center justify-center overflow-hidden">
        <div class="absolute top-20 left-1/2 -translate-x-1/2 w-[600px] h-[600px] bg-red-500/5 rounded-full blur-[120px] pointer-events-none -z-10"></div>
        
        <div class="max-w-4xl mx-auto text-center relative z-10">
            <span class="editorial-label text-gold mb-6 block">Lead Magnet / Auditoría</span>
            <h1 class="font-serif text-4xl md:text-6xl mb-6 text-white leading-tight">
                ¿Qué tan <span class="italic font-light text-white/60">visible e inteligente</span> es tu presencia digital hoy?
            </h1>
            <p class="text-xl text-subtle font-light max-w-2xl mx-auto mb-10 leading-relaxed">
                No es una auditoría automática de un bot. Es un diagnóstico profundo realizado por un estratega técnico para detectar fugas de conversión y oportunidades de IA.
            </p>
            <CtaWhatsApp text="Solicitar Auditoría Gratuita" microcopy="Cupos limitados por semana para asegurar calidad." />
        </div>
    </section>

    <!-- QUÉ INCLUYE LA AUDITORÍA -->
    <section class="py-24 px-6 relative border-t border-white/5 bg-white/[0.01]">
        <div class="max-w-5xl mx-auto">
            <h2 class="text-3xl text-center mb-16 text-white font-light">Un diagnóstico en <span class="text-gold">3 niveles</span></h2>
            
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <div class="matte-card p-10 rounded-2xl border border-white/5 hover:border-gold/20 transition-all">
                    <span class="text-white/20 text-4xl font-serif italic mb-6 block">01</span>
                    <h4 class="text-white text-xl mb-4">SEO/GEO Readiness</h4>
                    <p class="text-subtle text-sm">¿Google te indexa bien? ¿ChatGPT te puede citar? Revisamos tus señales técnicas de autoridad y citalidad.</p>
                </div>
                <div class="matte-card p-10 rounded-2xl border border-white/5 hover:border-gold/20 transition-all">
                    <span class="text-white/20 text-4xl font-serif italic mb-6 block">02</span>
                    <h4 class="text-white text-xl mb-4">CRO & Mensaje</h4>
                    <p class="text-subtle text-sm">¿Tu propuesta de valor es clara? Detectamos por dónde se están escapando tus leads actuales.</p>
                </div>
                <div class="matte-card p-10 rounded-2xl border border-white/5 hover:border-gold/20 transition-all">
                    <span class="text-white/20 text-4xl font-serif italic mb-6 block">03</span>
                    <h4 class="text-white text-xl mb-4">IA Opportunity</h4>
                    <p class="text-subtle text-sm">Identificamos el proceso específico de tu operación que más se beneficiaría de un agente o automatización.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- POR QUÉ AHORA -->
    <section class="py-24 px-6 relative border-t border-white/5">
        <div class="max-w-3xl mx-auto text-center">
            <h2 class="mb-8 text-white font-light">El mercado B2B no perdona la <span class="italic text-white/60">fricción técnica</span>.</h2>
            <p class="text-subtle mb-12">En un mundo donde la IA responde en segundos, un sitio lento, confuso o invisible es una sentencia de muerte comercial. Obtén claridad sobre tu estado actual.</p>
            <CtaWhatsApp text="Quiero mi Diagnóstico" />
        </div>
    </section>

    <Footer />
</Layout>
