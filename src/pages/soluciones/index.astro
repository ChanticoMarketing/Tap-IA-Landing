<script is:inline>
    // GSAP Scroll Animations
    document.addEventListener("DOMContentLoaded", () => {
        const gsap = window.gsap;
        const ScrollTrigger = window.ScrollTrigger;
        
        if (!gsap || !ScrollTrigger) return;

        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const isMobileViewport = window.matchMedia('(max-width: 767px)').matches;
        const skipHeroMotion = prefersReducedMotion || isMobileViewport;

        // Typewriter del título
        const titleBase = document.getElementById('typewriter-base');
        const titleAccent = document.getElementById('typewriter-accent');
        const cursorBase = document.getElementById('cursor-base');
        const cursorAccent = document.getElementById('cursor-accent');

        const textBase = "Soluciones de <span class='font-serif italic text-gold'>IA</span>,";
        const textAccent = "marketing y sistemas digitales";

        if (skipHeroMotion) {
            if(titleBase) titleBase.innerHTML = textBase;
            if(titleAccent) titleAccent.innerHTML = textAccent;
        } else {
            // Animación del cursor base
            if (cursorBase) {
                const blinkBase = gsap.to(cursorBase, {
                    opacity: 1, ease: "steps(1)", repeat: -1, duration: 0.5
                });

                // Secuencia
                const tl = gsap.timeline({ delay: 0.2 });
                
                // Escribir base
                tl.to(titleBase, {
                    duration: 1.2,
                    text: { value: textBase, delimiter: "" },
                    ease: "none",
                    onComplete: () => {
                        blinkBase.kill();
                        gsap.set(cursorBase, { opacity: 0 });
                    }
                })
                // Cursor acento parpadea y escribe
                .call(() => {
                    if (cursorAccent) {
                        gsap.to(cursorAccent, {
                            opacity: 1, ease: "steps(1)", repeat: -1, duration: 0.5
                        });
                    }
                })
                .to(titleAccent, {
                    duration: 1.5,
                    text: { value: textAccent, delimiter: "" },
                    ease: "none"
                }, "+=0.2");
            }
        }

        if (prefersReducedMotion) return;

        // Reveal items fade up
        gsap.utils.toArray('.reveal-item').forEach((elem) => {
            gsap.fromTo(elem, 
                { opacity: 0, y: 40 },
                {
                    opacity: 1, 
                    y: 0, 
                    duration: 1, 
                    ease: "power3.out",
                    scrollTrigger: {
                        trigger: elem,
                        start: "top 85%",
                        toggleActions: "play none none reverse"
                    }
                }
            );
        });

        // Interactive Sticky System Logic
        const modules = gsap.utils.toArray('.svc-module');
        modules.forEach((mod) => {
            const targetId = mod.getAttribute('data-target');
            const modId = mod.getAttribute('data-id');
            const visualizer = document.getElementById(targetId);
            const node = mod.querySelector('.svc-node');
            
            if(!visualizer) return;

            ScrollTrigger.create({
                trigger: mod,
                start: "top 55%",
                end: "bottom 55%",
                onEnter: () => activateModule(),
                onEnterBack: () => activateModule(),
            });

            function activateModule() {
                // Dim all text modules
                gsap.to('.svc-module', { opacity: 0.3, duration: 0.5 });
                // Highlight active text module
                gsap.to(mod, { opacity: 1, duration: 0.5 });

                // Reset all nodes
                gsap.to('.svc-node', { 
                    backgroundColor: '#0a0b0e', 
                    boxShadow: 'none' 
                });
                // Highlight active node
                gsap.to(node, { 
                    backgroundColor: '#d4af37', 
                    boxShadow: '0 0 15px rgba(212,175,55,0.8)' 
                });

                // Crossfade visualizers
                gsap.to('.svc-vis', { opacity: 0, scale: 1.1, zIndex: 0, duration: 0.8 });
                gsap.to(visualizer, { opacity: 1, scale: 1, zIndex: 10, duration: 0.8 });

                // Update Terminal ID
                const sysId = document.getElementById('sys-id');
                if(sysId && modId) sysId.innerText = modId;
            }
        });

        // Timeline Process Logic
        const timelineSteps = gsap.utils.toArray('.timeline-step');
        const timelineDots = gsap.utils.toArray('.timeline-dot');
        const timelineProgress = document.getElementById('timeline-progress');

        if (timelineSteps.length > 0 && timelineProgress) {
            // Animación de la barra de progreso vertical
            gsap.to(timelineProgress, {
                scaleY: 1,
                ease: "none",
                scrollTrigger: {
                    trigger: timelineSteps[0],
                    start: "top 70%",
                    endTrigger: timelineSteps[timelineSteps.length - 1],
                    end: "top 70%",
                    scrub: 0.5
                }
            });

            // Lógica de activación de cada paso
            timelineSteps.forEach((step, index) => {
                ScrollTrigger.create({
                    trigger: step,
                    start: "top 70%",
                    end: "bottom 70%",
                    onEnter: () => activateStep(index),
                    onEnterBack: () => activateStep(index),
                });
            });

            function activateStep(activeIndex) {
                timelineSteps.forEach((step, i) => {
                    if (i === activeIndex) {
                        step.classList.add('is-active');
                        gsap.to(step, { opacity: 1, duration: 0.3 });
                        if(timelineDots[i]) {
                            gsap.to(timelineDots[i], { backgroundColor: '#d4af37', borderColor: '#d4af37', boxShadow: '0 0 10px rgba(212,175,55,0.5)', duration: 0.3 });
                        }
                    } else {
                        step.classList.remove('is-active');
                        gsap.to(step, { opacity: 0.6, duration: 0.3 });
                        if(timelineDots[i]) {
                            gsap.to(timelineDots[i], { backgroundColor: '#161922', borderColor: 'rgba(255,255,255,0.2)', boxShadow: 'none', duration: 0.3 });
                        }
                    }
                });
            }
        }
    });
</script>