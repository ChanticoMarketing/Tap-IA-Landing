---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PremiumSectionHeader from '../components/PremiumSectionHeader.astro';
import KeyTakeaways from '../components/KeyTakeaways.astro';
import ShareButton from '../components/ShareButton.astro';
---

<Layout 
    title="Sobre TAP-IA | Consultoría de IA y Estrategia B2B"
    description="Conoce TAP-IA: consultores en Inteligencia Artificial y arquitectos de estrategias digitales y SEO/GEO para empresas B2B."
>
    <Header />

    <main class="relative overflow-hidden z-10">
        <!-- Luces cinemáticas de fondo -->
        <div class="absolute top-1/4 right-0 w-[600px] h-[600px] bg-gold/5 rounded-full blur-[100px] pointer-events-none -z-10"></div>
        <div class="absolute bottom-1/4 left-0 w-[500px] h-[500px] bg-royal/5 rounded-full blur-[100px] pointer-events-none -z-10"></div>

        <!-- HERO SECTION -->
        <section class="min-h-[60vh] pt-36 pb-16 px-6 relative flex items-center">
            <div class="max-w-4xl mx-auto">
                <span class="editorial-label block mb-6">Nuestra Filosofía</span>
                <h1 class="font-serif text-4xl md:text-6xl mb-8 text-white leading-tight">
                    Arquitectura de dominio digital e inteligencia artificial con criterio de negocio
                </h1>
                
                <!-- Respuesta Directa a la Intención de Búsqueda -->
                <p class="text-xl text-offwhite/90 font-light leading-relaxed mb-6">
                    Tap-IA es una firma de consultoría y desarrollo técnico especializada en conectar la inteligencia artificial con el núcleo de negocio de las empresas. No diseñamos páginas decorativas ni vendemos automatizaciones sueltas; creamos ecosistemas que multiplican la ventaja operativa, la captación de prospectos y la autoridad orgánica.
                </p>

                <!-- Resumen TL;DR / 5 Puntos Clave -->
                <KeyTakeaways 
                    points={[
                        "Criterio Antes de Herramientas: La IA solo genera retorno cuando se aplica a procesos operativos y comerciales claros.",
                        "Enfoque de Estratega Técnico: Diagnosticamos, diseñamos y programamos soluciones a medida sin tercerización opaca.",
                        "Pioneros en SEO/GEO: Construimos activos digitales indexables en Google y citables por ChatGPT, Claude y Perplexity.",
                        "Gobernanza y Privacidad: Garantizamos la seguridad y confidencialidad absoluta de los datos de cada cliente.",
                        "Impacto Medible: Cada proyecto cuenta con métricas financieras y operativas definidas desde el primer día."
                    ]}
                    class="my-8"
                />

                <div class="flex items-center gap-4 mt-6">
                    <ShareButton title="Sobre TAP-IA: Arquitectura de Dominio Digital" text="Conoce la filosofía y enfoque de consultoría en IA de Tap-IA:" url="https://tap-ia.tech/nosotros" />
                </div>
            </div>
        </section>

        <!-- VISIÓN Y PROPÓSITO -->
        <section class="py-20 px-6 relative border-t border-white/5 bg-charcoal">
            <div class="max-w-4xl mx-auto text-left space-y-6">
                <h2 class="font-serif text-2xl md:text-3xl text-white">Sistemas que trascienden el hype tecnológico</h2>
                <p class="text-subtle text-base leading-relaxed">
                    La rápida evolución de los modelos fundacionales ha creado una saturación de herramientas temporales. En Tap-IA nos alejamos de las modas pasajeras. Diseñamos soluciones basadas en principios de ingeniería robustos y estrategias de marketing probadas, asegurando que tu infraestructura digital crezca y sea sostenible en el mediano y largo plazo.
                </p>
                <p class="text-subtle text-base leading-relaxed">
                    Entendemos que cada negocio tiene procesos únicos. Por ello, adaptamos arquitecturas RAG, agentes autónomos y posicionamiento <a href="/servicios/seo-geo" class="text-gold hover:underline">SEO/GEO</a> para integrarse armónicamente con tus operaciones y CRM existentes, maximizando el valor estratégico de tu conocimiento propietario.
                </p>
            </div>
        </section>

        <!-- ENFOQUE METODOLÓGICO -->
        <section class="py-16 px-6 relative border-t border-white/5" aria-label="Nuestro Enfoque">
            <div class="max-w-6xl mx-auto">
                <PremiumSectionHeader 
                    label="Diferenciador" 
                    title="Tecnología con <span class='italic text-white/60'>Criterio</span>" 
                    subtitle="Por qué los líderes B2B eligen a Tap-IA para liderar su transición hacia la inteligencia artificial."
                    centered={false}
                />

                <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mt-12">
                    <div class="p-8 rounded-2xl bg-[#161922]/20 border border-white/5 backdrop-blur-md">
                        <div class="w-12 h-12 rounded-xl bg-gold/5 border border-gold/20 flex items-center justify-center text-gold mb-6">
                            <i class="fa-solid fa-chess" aria-hidden="true"></i>
                        </div>
                        <h3 class="font-playfair text-xl text-white mb-3 font-light">1. Claridad Ejecutiva</h3>
                        <p class="text-sm text-subtle font-light leading-relaxed">
                            Traducimos la complejidad técnica de los modelos generativos y los <a href="/agentes-ia-a-medida" class="text-gold hover:underline">agentes de IA</a> en roadmaps operativos y retornos de inversión medibles.
                        </p>
                    </div>

                    <div class="p-8 rounded-2xl bg-[#161922]/20 border border-white/5 backdrop-blur-md">
                        <div class="w-12 h-12 rounded-xl bg-gold/5 border border-gold/20 flex items-center justify-center text-gold mb-6">
                            <i class="fa-solid fa-code" aria-hidden="true"></i>
                        </div>
                        <h3 class="font-playfair text-xl text-white mb-3 font-light">2. Sistemas Propios</h3>
                        <p class="text-sm text-subtle font-light leading-relaxed">
                            Desarrollamos <a href="/webapps-ia-a-medida" class="text-gold hover:underline">WebApps personalizadas</a> y agentes conectados a tus bases de datos sin depender de plataformas intermedias con costos ocultos.
                        </p>
                    </div>

                    <div class="p-8 rounded-2xl bg-[#161922]/20 border border-white/5 backdrop-blur-md">
                        <div class="w-12 h-12 rounded-xl bg-gold/5 border border-gold/20 flex items-center justify-center text-gold mb-6">
                            <i class="fa-solid fa-radar" aria-hidden="true"></i>
                        </div>
                        <h3 class="font-playfair text-xl text-white mb-3 font-light">3. Optimización SEO/GEO</h3>
                        <p class="text-sm text-subtle font-light leading-relaxed">
                            Diseñamos la estructura semántica y de datos estructurados para que los LLMs reconozcan y citen a tu empresa como referente en su sector.
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <!-- EL FUNDADOR (BLOQUE E-E-A-T) -->
        <section class="py-16 pb-24 px-6 border-t border-white/5" aria-labelledby="heading-founder">
            <div class="max-w-5xl mx-auto">
                <div class="card-glow p-8 md:p-12 rounded-3xl bg-gradient-to-b from-[#161922]/80 to-[#0a0b0e]/95 border border-white/10 flex flex-col md:flex-row items-center gap-8 md:gap-12 relative overflow-hidden">
                    <div class="absolute inset-0 bg-noise opacity-[0.02] pointer-events-none"></div>
                    
                    <div class="w-40 h-40 md:w-48 md:h-48 rounded-full overflow-hidden border-2 border-gold/30 shrink-0 bg-[#12141a] shadow-[0_0_30px_rgba(212,175,55,0.15)]">
                        <img 
                            src="/assets/emmanuel_tapia.jpg" 
                            alt="Emmanuel Tapia, Fundador y Estratega Técnico en IA de TAP-IA" 
                            class="w-full h-full object-cover"
                            width="250"
                            height="250"
                            loading="lazy"
                        />
                    </div>

                    <div class="flex-grow space-y-4 text-center md:text-left">
                        <span class="editorial-label text-gold text-[10px] tracking-[0.2em] font-bold block" id="heading-founder">Liderazgo Técnico</span>
                        <h2 class="font-serif text-3xl md:text-4xl text-white font-light">Emmanuel Tapia</h2>
                        <p class="text-xs font-mono text-gold/80 tracking-widest uppercase mb-4">Fundador & AI Strategist</p>
                        <p class="text-sm md:text-base text-subtle font-light leading-relaxed mb-6">
                            Especialista en estructuración de sistemas de marketing digital, optimización para motores de respuesta de IA (GEO) y desarrollo de agentes autónomos para la optimización de procesos de negocio.
                        </p>
                        <a 
                            href="/nosotros/emmanuel-tapia" 
                            class="inline-flex items-center text-xs font-mono tracking-widest uppercase text-gold hover:text-white transition-colors gap-2"
                        >
                            Leer perfil profesional completo <i class="fa-solid fa-arrow-right text-[10px]"></i>
                        </a>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <!-- Schema AboutPage para E-E-A-T optimizado -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "AboutPage",
      "@id": "https://tap-ia.tech/nosotros#webpage",
      "url": "https://tap-ia.tech/nosotros",
      "name": "Sobre TAP-IA | Arquitectura de Dominio Digital",
      "description": "Descubre TAP-IA: consultores en Inteligencia Artificial y arquitectos de estrategias digitales B2B.",
      "mainEntity": {
        "@type": "Organization",
        "@id": "https://tap-ia.tech/#organization",
        "name": "TAP-IA",
        "founder": {
          "@type": "Person",
          "@id": "https://tap-ia.tech/nosotros/emmanuel-tapia#person",
          "name": "Emmanuel Tapia"
        }
      }
    })} />

    <Footer />
</Layout>