---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CtaWhatsApp from '../components/CtaWhatsApp.astro';
import TapIALiquidGradient from '../components/TapIALiquidGradient.astro';
---

<Layout title="TAP-IA | IA aplicada a marketing y crecimiento">
    <Header />

    <!-- HERO SECTION -->
    <section class="relative min-h-[85vh] md:min-h-screen flex flex-col items-center justify-center pt-24 pb-12 md:pt-32 md:pb-20 px-6 overflow-hidden">
        <!-- Interactive WebGL Liquid Gradient Background -->
        <TapIALiquidGradient />

        <div class="max-w-4xl mx-auto w-full text-center relative z-10 flex flex-col items-center">
            <!-- Scrim vertical para proteger la legibilidad del texto sobre el fondo animado -->
            <div class="absolute inset-0 w-full h-full bg-gradient-to-b from-[#0a0b0e]/50 via-[#0a0b0e]/20 to-transparent pointer-events-none -z-10 rounded-3xl blur-[10px]"></div>

            <span class="hero-item inline-flex items-center gap-2 py-1 px-3 rounded-full border border-gold/20 bg-gold/[0.04] editorial-label text-gold mb-6 backdrop-blur-sm">
                <span class="w-1.5 h-1.5 rounded-full bg-gold animate-pulse"></span>
                IA Aplicada a Marketing
            </span>
            <h1 class="hero-item mb-6">
                IA para marketing con <br class="hidden md:block">
                <span class="text-white/80 italic font-light">claridad y ejecución real</span>
            </h1>
            <p class="hero-item text-subtle max-w-2xl mx-auto mb-10 text-base md:text-[1.1rem]">
                Convertimos la Inteligencia Artificial en decisiones, sistemas y flujos que realmente ayudan a vender, optimizar y crecer. Sin humo ni tecnicismos innecesarios.
            </p>
            <div class="hero-item relative z-50">
                <CtaWhatsApp text="Iniciar evaluación gratuita" microcopy="En 5 minutos definimos si necesitas estrategia o implementación." />
            </div>
        </div>
    </section>

    <!-- TRUST STRIP -->
    <section class="trust-section border-y border-white/5 bg-white/[0.02] py-6 overflow-hidden">
        <p class="editorial-label text-center mb-5">Tecnología integrada a tu operación</p>
        <div class="relative overflow-hidden [mask-image:linear-gradient(to_right,transparent,black_10%,black_90%,transparent)]">
            <div class="flex gap-10 animate-marquee whitespace-nowrap w-max items-center">
                <!-- Set 1 -->
                <img class="trust-item h-6 w-auto opacity-55 hover:opacity-90 transition-opacity" src="https://cdn.simpleicons.org/openai/9ca3af" alt="OpenAI" loading="lazy" />
                <span class="trust-item text-subtle/30 text-xs">◆</span>
                <img class="trust-item h-6 w-auto opacity-55 hover:opacity-90 transition-opacity" src="https://cdn.simpleicons.org/anthropic/9ca3af" alt="Anthropic" loading="lazy" />
                <span class="trust-item text-subtle/30 text-xs">◆</span>
                <img class="trust-item h-6 w-auto opacity-55 hover:opacity-90 transition-opacity" src="https://cdn.simpleicons.org/hubspot/9ca3af" alt="HubSpot" loading="lazy" />
                <span class="trust-item text-subtle/30 text-xs">◆</span>
                <img class="trust-item h-6 w-auto opacity-55 hover:opacity-90 transition-opacity" src="https://cdn.simpleicons.org/make/9ca3af" alt="Make" loading="lazy" />
                <span class="trust-item text-subtle/30 text-xs">◆</span>
                <img class="trust-item h-6 w-auto opacity-55 hover:opacity-90 transition-opacity" src="https://cdn.simpleicons.org/zapier/9ca3af" alt="Zapier" loading="lazy" />
                <span class="trust-item text-subtle/30 text-xs">◆</span>
                <img class="trust-item h-6 w-auto opacity-55 hover:opacity-90 transition-opacity" src="https://cdn.simpleicons.org/n8n/9ca3af" alt="n8n" loading="lazy" />
                <span class="trust-item text-subtle/30 text-xs">◆</span>
                <img class="trust-item h-6 w-auto opacity-55 hover:opacity-90 transition-opacity" src="https://cdn.simpleicons.org/googlegemini/9ca3af" alt="Google Gemini" loading="lazy" />
                <span class="trust-item text-subtle/30 text-xs">◆</span>
                <img class="trust-item h-6 w-auto opacity-55 hover:opacity-90 transition-opacity" src="https://cdn.simpleicons.org/perplexity/9ca3af" alt="Perplexity" loading="lazy" />
                <span class="trust-item text-subtle/30 text-xs">◆</span>
                <!-- Set 2 — duplicado para loop continuo -->
                <img class="trust-item h-6 w-auto opacity-55 hover:opacity-90 transition-opacity" src="https://cdn.simpleicons.org/openai/9ca3af" alt="OpenAI" loading="lazy" />
                <span class="trust-item text-subtle/30 text-xs">◆</span>
                <img class="trust-item h-6 w-auto opacity-55 hover:opacity-90 transition-opacity" src="https://cdn.simpleicons.org/anthropic/9ca3af" alt="Anthropic" loading="lazy" />
                <span class="trust-item text-subtle/30 text-xs">◆</span>
                <img class="trust-item h-6 w-auto opacity-55 hover:opacity-90 transition-opacity" src="https://cdn.simpleicons.org/hubspot/9ca3af" alt="HubSpot" loading="lazy" />
                <span class="trust-item text-subtle/30 text-xs">◆</span>
                <img class="trust-item h-6 w-auto opacity-55 hover:opacity-90 transition-opacity" src="https://cdn.simpleicons.org/make/9ca3af" alt="Make" loading="lazy" />
                <span class="trust-item text-subtle/30 text-xs">◆</span>
                <img class="trust-item h-6 w-auto opacity-55 hover:opacity-90 transition-opacity" src="https://cdn.simpleicons.org/zapier/9ca3af" alt="Zapier" loading="lazy" />
                <span class="trust-item text-subtle/30 text-xs">◆</span>
                <img class="trust-item h-6 w-auto opacity-55 hover:opacity-90 transition-opacity" src="https://cdn.simpleicons.org/n8n/9ca3af" alt="n8n" loading="lazy" />
                <span class="trust-item text-subtle/30 text-xs">◆</span>
                <img class="trust-item h-6 w-auto opacity-55 hover:opacity-90 transition-opacity" src="https://cdn.simpleicons.org/googlegemini/9ca3af" alt="Google Gemini" loading="lazy" />
                <span class="trust-item text-subtle/30 text-xs">◆</span>
                <img class="trust-item h-6 w-auto opacity-55 hover:opacity-90 transition-opacity" src="https://cdn.simpleicons.org/perplexity/9ca3af" alt="Perplexity" loading="lazy" />
                <span class="trust-item text-subtle/30 text-xs">◆</span>
            </div>
        </div>
    </section>

    <!-- ACCESOS RÁPIDOS — Diseño Editorial Premium -->
    <section class="quick-access-section py-24 px-6 relative border-b border-white/5 bg-[#0a0b0e]">
        <!-- Fondo base con textura y glows sutiles -->
        <div class="absolute inset-0 bg-gradient-to-b from-transparent to-[#16191f]/30 pointer-events-none"></div>
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] bg-[#2563eb]/6 rounded-full blur-[100px] -z-10 pointer-events-none"></div>

        <div class="max-w-7xl mx-auto relative z-10">
            <div class="flex flex-col md:flex-row justify-between items-start md:items-end mb-16 gap-8">
                <div class="max-w-2xl">
                    <span class="editorial-label block mb-3">Soluciones Estratégicas</span>
                    <div class="gold-rule mb-6"></div>
                    <h2 class="text-4xl md:text-5xl font-light leading-tight">¿Qué necesitas <br/><span class="italic text-white/60">destrabar hoy?</span></h2>
                </div>
                <p class="text-subtle text-base md:text-lg max-w-md font-light">
                    No vendemos herramientas aisladas. Implementamos sistemas concretos de negocio para que operes con criterio, automatices la fricción y aumentes tus márgenes.
                </p>
            </div>
            
            <!-- Grid Editorial: 2 Columnas principales, pero asimétrico en alturas -->
            <div class="grid grid-cols-1 md:grid-cols-12 gap-5 md:gap-6">
                <!-- Tarjeta 1: Web -->
                <a href="/soluciones/web" class="card-glow group col-span-1 md:col-span-7 relative p-8 md:p-12 flex flex-col justify-between">
                    <div class="absolute -right-20 -top-20 w-80 h-80 bg-[#2563eb]/8 rounded-full blur-[100px] group-hover:bg-[#2563eb]/15 transition-all duration-1000 pointer-events-none"></div>
                    
                    <div class="flex justify-between items-start mb-24 md:mb-32">
                        <span class="text-white/10 font-serif text-6xl md:text-7xl italic group-hover:text-gold/30 transition-colors duration-700 select-none">01</span>
                        <div class="w-12 h-12 md:w-14 md:h-14 rounded-full border border-white/10 flex items-center justify-center bg-white/5 group-hover:bg-gold group-hover:border-gold transition-all duration-500 shadow-lg">
                            <i class="fa-solid fa-arrow-right text-white text-sm md:text-base transform -rotate-45 group-hover:rotate-0 transition-transform duration-500"></i>
                        </div>
                    </div>
                    
                    <div class="relative z-10">
                        <h3 class="text-3xl md:text-4xl text-white mb-3 md:mb-4 font-light tracking-tight">Web con <span class="italic text-gold">estrategia</span></h3>
                        <p class="text-subtle text-base md:text-lg max-w-md font-light leading-relaxed">Sitios que no solo se ven bien: explican tu propuesta, posicionan en el mercado, capturan leads y convierten.</p>
                    </div>
                </a>

                <!-- Tarjeta 2: SEO-GEO -->
                <a href="/soluciones/seo-geo" class="card-glow group col-span-1 md:col-span-5 relative p-8 md:p-12 flex flex-col justify-between">
                    <div class="absolute -left-20 -bottom-20 w-72 h-72 bg-[#1a2744]/15 rounded-full blur-[80px] group-hover:bg-[#2563eb]/12 transition-all duration-1000 pointer-events-none"></div>
                    
                    <div class="flex justify-between items-start mb-24 md:mb-32">
                        <span class="text-white/10 font-serif text-6xl md:text-7xl italic group-hover:text-gold/30 transition-colors duration-700 select-none">02</span>
                        <div class="w-12 h-12 md:w-14 md:h-14 rounded-full border border-white/10 flex items-center justify-center bg-white/5 group-hover:bg-white group-hover:border-white transition-all duration-500 shadow-lg">
                            <i class="fa-solid fa-arrow-right text-white group-hover:text-[#0a0b0e] text-sm md:text-base transform -rotate-45 group-hover:rotate-0 transition-transform duration-500"></i>
                        </div>
                    </div>
                    
                    <div class="relative z-10">
                        <h3 class="text-3xl md:text-4xl text-white mb-3 md:mb-4 font-light tracking-tight">SEO-GEO</h3>
                        <p class="text-subtle text-base md:text-lg font-light leading-relaxed">Visibilidad dominante en Google y en los nuevos entornos generativos de IA.</p>
                    </div>
                </a>

                <!-- Tarjeta 3: Agentes IA -->
                <a href="/soluciones/agentes-ia" class="card-glow group col-span-1 md:col-span-4 relative p-8 flex flex-col justify-between">
                    <div class="flex justify-between items-start mb-16">
                        <span class="text-white/10 font-serif text-5xl italic group-hover:text-white/30 transition-colors duration-700 select-none">03</span>
                        <i class="fa-solid fa-arrow-right text-white/30 text-base transform -rotate-45 group-hover:rotate-0 group-hover:text-white transition-all duration-500"></i>
                    </div>
                    <div class="relative z-10">
                        <h3 class="text-2xl text-white mb-2 font-light">Agentes <span class="italic">IA</span></h3>
                        <p class="text-subtle text-sm md:text-base font-light">Atención y resolución operativa 24/7 sin fricción para el usuario.</p>
                    </div>
                </a>

                <!-- Tarjeta 4: WebApps -->
                <a href="/soluciones/webapps" class="card-glow group col-span-1 md:col-span-4 relative p-8 flex flex-col justify-between">
                    <div class="flex justify-between items-start mb-16">
                        <span class="text-white/10 font-serif text-5xl italic group-hover:text-white/30 transition-colors duration-700 select-none">04</span>
                        <i class="fa-solid fa-arrow-right text-white/30 text-base transform -rotate-45 group-hover:rotate-0 group-hover:text-white transition-all duration-500"></i>
                    </div>
                    <div class="relative z-10">
                        <h3 class="text-2xl text-white mb-2 font-light">WebApps</h3>
                        <p class="text-subtle text-sm md:text-base font-light">Herramientas a medida para máxima eficiencia interna y automatización.</p>
                    </div>
                </a>

                <!-- Tarjeta 5: AI Marketing -->
                <a href="/soluciones/ai-marketing" class="card-glow group col-span-1 md:col-span-4 relative p-8 flex flex-col justify-between">
                    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-40 h-40 bg-[#2563eb]/6 rounded-full blur-[60px] group-hover:bg-[#2563eb]/14 transition-all duration-1000 pointer-events-none"></div>
                    <div class="flex justify-between items-start mb-16 relative z-10">
                        <span class="text-white/10 font-serif text-5xl italic group-hover:text-gold/30 transition-colors duration-700 select-none">05</span>
                        <i class="fa-solid fa-arrow-right text-white/30 text-base transform -rotate-45 group-hover:rotate-0 group-hover:text-gold transition-all duration-500"></i>
                    </div>
                    <div class="relative z-10">
                        <h3 class="text-2xl text-white mb-2 font-light">AI <span class="italic">Marketing</span></h3>
                        <p class="text-subtle text-sm md:text-base font-light">Analítica y workflows para ejecutar estrategias con precisión milimétrica.</p>
                    </div>
                </a>
            </div>
        </div>
    </section>

    <!-- ZONA CONTINUA: PROPUESTA Y PORTAFOLIO -->
    <div class="border-t border-white/5 bg-white/[0.01] relative overflow-hidden">

        <!-- PROPUESTA DE VALOR CENTRAL -->
        <section class="pt-24 pb-16 px-6 relative">
            <div class="absolute -bottom-40 -left-20 w-[400px] h-[400px] bg-[#1a2744]/15 rounded-full blur-[80px] -z-10 pointer-events-none"></div>
        <div class="max-w-4xl mx-auto relative z-10">
            
            <h2 class="mb-8 text-white relative z-10">
                La mayoría ya usa IA. <br>
                <span class="text-gold italic">Muy pocos la están usando con criterio de marketing.</span>
            </h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-start relative z-10">
                <div class="text-subtle space-y-6">
                    <p>Hoy muchas empresas ya tienen ChatGPT, automatizaciones sueltas o herramientas aisladas.</p>
                    <p>El problema no es acceso. El problema es que siguen sin una estructura clara para convertir todo eso en:</p>
                    <ul class="space-y-3 text-white/90">
                        <li class="flex items-center gap-3">
                            <span class="text-gold text-xs">&#10022;</span>
                            <span>mejor contenido</span>
                        </li>
                        <li class="flex items-center gap-3">
                            <span class="text-gold text-xs">&#10022;</span>
                            <span>mejor operación</span>
                        </li>
                        <li class="flex items-center gap-3">
                            <span class="text-gold text-xs">&#10022;</span>
                            <span>mejor visibilidad</span>
                        </li>
                        <li class="flex items-center gap-3">
                            <span class="text-gold text-xs">&#10022;</span>
                            <span>mejor toma de decisiones</span>
                        </li>
                    </ul>
                </div>
                <div class="bg-[#16191f]/80 backdrop-blur-xl p-8 md:p-10 rounded-2xl border border-white/10 shadow-2xl relative z-10">
                    <p class="text-lg text-white mb-6">Tap-IA entra justo ahí:</p>
                    <p class="text-subtle mb-6">Para traducir la complejidad en una implementación clara, útil y accionable.</p>
                    <p class="text-xl font-medium text-gold">Esa es la diferencia entre <span class="line-through opacity-50">usar IA</span> y tener ventaja con IA.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- PORTAFOLIO — Cinematic Showcase Panels -->
    <section class="portfolio-section pb-24 pt-8 px-6 relative">
        <div class="max-w-7xl mx-auto">
            <div class="flex flex-col md:flex-row justify-between items-end mb-16">
                <div>
                    <span class="editorial-label block mb-3">Portafolio</span>
                    <div class="gold-rule mb-6"></div>
                    <h2 class="mb-4 text-white">Trabajo con criterio</h2>
                    <p class="text-subtle max-w-xl">Demos que muestran proceso, criterio, entregables y calidad técnica aplicada.</p>
                    <p class="text-sm text-subtle/80 mt-4 max-w-lg">Tu audiencia B2B no quiere discurso inflado. Quiere ver cómo piensas, cómo estructuras y cómo aterrizas la IA a un contexto real. Por eso aquí no vas a encontrar “miren qué futurista”. Vas a encontrar demos que muestran cómo se convierte una idea en sistema y un sistema en ventaja.</p>
                </div>
                <a href="/portafolio" class="hidden md:flex text-gold hover:text-white transition-colors text-sm font-medium items-center gap-2 border-b border-gold/30 hover:border-white pb-1 mt-6 md:mt-0">
                    Ver archivo completo <i class="fa-solid fa-arrow-right"></i>
                </a>
            </div>
            
            <div class="flex flex-col gap-5">
                <!-- Panel 1: Sitios Web -->
                <a href="/portafolio/sitios-web" class="portfolio-panel group relative flex flex-col md:flex-row items-center rounded-2xl overflow-hidden border border-white/[0.06] hover:border-gold/30 transition-all duration-500 bg-gradient-to-r from-[#1a1d24] to-[#12141a]">
                    <div class="flex-[3] p-8 md:p-12 relative z-10">
                        <span class="ui-caption text-gold/60 mb-3 block"><i class="fa-solid fa-laptop-code mr-2"></i>Interfaz & Conversión</span>
                        <h3 class="text-white/90 group-hover:text-white transition-colors mb-3">Sitios Web</h3>
                        <p class="text-sm text-subtle max-w-md">Infraestructura digital pensada para captar, explicar y convertir.</p>
                        <span class="inline-flex items-center gap-2 mt-6 text-sm text-gold opacity-0 group-hover:opacity-100 transition-all duration-300 transform translate-y-2 group-hover:translate-y-0">
                            Ver demos <i class="fa-solid fa-arrow-right"></i>
                        </span>
                    </div>
                    <div class="flex-[2] flex items-center justify-center p-8 md:p-12 relative overflow-hidden">
                        <div class="portfolio-orb absolute inset-0 bg-gradient-to-br from-gold/15 to-gold/5 opacity-60 group-hover:opacity-100 transition-all duration-700 blur-3xl rounded-full scale-50 group-hover:scale-100 mix-blend-screen"></div>
                        <img src="/images/holograma_datos_premium.webp" alt="Data Core" class="relative z-10 w-48 h-48 md:w-64 md:h-64 object-cover mix-blend-screen opacity-50 group-hover:opacity-100 transition-all duration-700 scale-95 group-hover:scale-105" loading="lazy" />
                    </div>
                </a>

                <!-- Panel 2: SEO-GEO -->
                <a href="/portafolio/seo-geo" class="portfolio-panel group relative flex flex-col md:flex-row items-center rounded-2xl overflow-hidden border border-white/[0.06] hover:border-[#2563eb]/30 transition-all duration-500 bg-gradient-to-r from-[#191c24] to-[#11131c]">
                    <div class="flex-[3] p-8 md:p-12 relative z-10">
                        <span class="ui-caption text-gold/60 mb-3 block"><i class="fa-solid fa-magnifying-glass-chart mr-2"></i>Arquitectura de visibilidad</span>
                        <h3 class="text-white/90 group-hover:text-white transition-colors mb-3">SEO-GEO</h3>
                        <p class="text-sm text-subtle max-w-md">Arquitectura de visibilidad para buscadores clásicos y entornos generativos.</p>
                        <span class="inline-flex items-center gap-2 mt-6 text-sm text-gold opacity-0 group-hover:opacity-100 transition-all duration-300 transform translate-y-2 group-hover:translate-y-0">
                            Ver demos <i class="fa-solid fa-arrow-right"></i>
                        </span>
                    </div>
                    <div class="flex-[2] flex items-center justify-center p-8 md:p-12 relative overflow-hidden min-h-[180px]">
                        <!-- Patrón de puntos animado -->
                        <div class="absolute inset-0 opacity-20 group-hover:opacity-40 transition-opacity duration-700"
                             style="background-image: radial-gradient(circle, #2563eb 1px, transparent 1px); background-size: 20px 20px;">
                        </div>
                        <!-- Glow navy al hover -->
                        <div class="absolute inset-0 bg-gradient-to-br from-[#2563eb]/0 to-[#1a2744]/20 opacity-0 group-hover:opacity-100 transition-opacity duration-700 blur-xl"></div>
                        <!-- Icono central -->
                        <div class="relative z-10 w-16 h-16 rounded-2xl border border-[#2563eb]/20 bg-[#1a2744]/40 flex items-center justify-center group-hover:border-[#2563eb]/60 group-hover:bg-[#1a2744]/80 transition-all duration-500">
                            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" opacity="0.7">
                                <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
                            </svg>
                        </div>
                    </div>
                </a>

                <!-- Panel 3: Agentes IA -->
                <a href="/portafolio/agentes-ia" class="portfolio-panel group relative flex flex-col md:flex-row items-center rounded-2xl overflow-hidden border border-white/[0.06] hover:border-[#2563eb]/30 transition-all duration-500 bg-gradient-to-r from-[#1b1820] to-[#13111a]">
                    <div class="flex-[3] p-8 md:p-12 relative z-10">
                        <span class="ui-caption text-gold/60 mb-3 block"><i class="fa-solid fa-robot mr-2"></i>Asistentes Operativos</span>
                        <h3 class="text-white/90 group-hover:text-white transition-colors mb-3">Agentes IA</h3>
                        <p class="text-sm text-subtle max-w-md">Asistentes listos para integrarse a procesos comerciales y operativos.</p>
                        <span class="inline-flex items-center gap-2 mt-6 text-sm text-gold opacity-0 group-hover:opacity-100 transition-all duration-300 transform translate-y-2 group-hover:translate-y-0">
                            Ver demos <i class="fa-solid fa-arrow-right"></i>
                        </span>
                    </div>
                    <div class="flex-[2] flex items-center justify-center p-8 md:p-12 relative overflow-hidden min-h-[180px]">
                        <!-- Red de nodos animada con SVG -->
                        <svg class="absolute inset-0 w-full h-full opacity-15 group-hover:opacity-35 transition-opacity duration-700" viewBox="0 0 200 150" fill="none" aria-hidden="true">
                            <circle cx="40" cy="40" r="3" fill="#2563eb"/>
                            <circle cx="100" cy="75" r="4" fill="#2563eb"/>
                            <circle cx="160" cy="40" r="3" fill="#2563eb"/>
                            <circle cx="70" cy="110" r="3" fill="#2563eb"/>
                            <circle cx="140" cy="110" r="3" fill="#2563eb"/>
                            <line x1="40" y1="40" x2="100" y2="75" stroke="#2563eb" stroke-width="0.8" opacity="0.6"/>
                            <line x1="100" y1="75" x2="160" y2="40" stroke="#2563eb" stroke-width="0.8" opacity="0.6"/>
                            <line x1="100" y1="75" x2="70" y2="110" stroke="#2563eb" stroke-width="0.8" opacity="0.6"/>
                            <line x1="100" y1="75" x2="140" y2="110" stroke="#2563eb" stroke-width="0.8" opacity="0.6"/>
                            <line x1="40" y1="40" x2="70" y2="110" stroke="#2563eb" stroke-width="0.4" opacity="0.3"/>
                            <line x1="160" y1="40" x2="140" y2="110" stroke="#2563eb" stroke-width="0.4" opacity="0.3"/>
                        </svg>
                        <!-- Glow navy al hover -->
                        <div class="absolute inset-0 bg-gradient-to-br from-[#2563eb]/0 to-[#1a2744]/20 opacity-0 group-hover:opacity-100 transition-opacity duration-700 blur-xl"></div>
                        <!-- Icono central -->
