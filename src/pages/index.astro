---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CtaWhatsApp from '../components/CtaWhatsApp.astro';
import ContactWizard from '../components/ContactWizard.astro';
import PremiumSectionHeader from '../components/PremiumSectionHeader.astro';
import ShareButton from '../components/ShareButton.astro';

const url = Astro.url;
const plan = url.searchParams.get('plan') ?? '';
const problem = url.searchParams.get('problem') ?? '';
const servicio = url.searchParams.get('servicio') ?? '';
const demo = url.searchParams.get('demo') ?? '';

const heroWaMessage = '¡Hola Tap-IA! Vi tu web y quiero implementar Marketing e IA en mi negocio. ¿Me atienden ahora?';
const heroWaHref = `https://wa.me/5213324239103?text=${encodeURIComponent(heroWaMessage)}`;
---

<Layout 
    title="TAP-IA | IA Aplicada a Negocio, Marketing y SEO/GEO"
    description="Consultoría e implementación de inteligencia artificial para empresas y marketing B2B. SEO/GEO, agentes IA a medida, automatización y estrategia digital."
>
    <Header />

    <!-- HERO SECTION -->
    <section class="hero-container relative min-h-0 md:min-h-[85vh] lg:min-h-[100svh] flex flex-col justify-center pt-28 pb-10 md:pt-32 md:pb-12 px-4 sm:px-6 overflow-hidden">

        <div class="max-w-7xl mx-auto w-full relative z-10 flex flex-col lg:flex-row items-center justify-between text-left gap-12 lg:gap-8">
            
            <!-- Columna Izquierda: Texto -->
            <div class="w-full lg:w-[55%] flex flex-col items-start relative">
                <!-- Scrim horizontal reforzado para proteger la legibilidad del texto -->
                <div class="absolute inset-0 w-full md:w-[150%] md:left-[-25%] h-full bg-gradient-to-r from-[#0a0b0e] via-[#0a0b0e]/70 to-transparent pointer-events-none -z-10 rounded-3xl blur-[40px]"></div>

                <span class="hero-item editorial-label block mb-8">
                    IA Aplicada a Negocio y Marketing
                </span>
                <h1
                    class="hero-item mb-5 max-w-4xl hero-text-shadow relative text-3xl md:text-5xl lg:text-[3.25rem] leading-[1.05]"
                    id="hero-title"
                    aria-label="IA aplicada a negocio y marketing para convertir complejidad técnica en decisiones claras"
                >
                    <span id="typewriter-base">La IA no hace marketing por ti.</span><span id="cursor-base" class="inline-block w-[3px] md:w-[4px] h-[0.9em] bg-gold ml-1 align-middle opacity-0" aria-hidden="true"></span> <br class="hidden md:block">
                    <span id="typewriter-accent" class="text-white/80">Te obliga a hacerlo mejor.</span><span id="cursor-accent" class="inline-block w-[3px] md:w-[4px] h-[0.9em] bg-gold ml-1 align-middle opacity-0" aria-hidden="true"></span>
                </h1>
                <div class="hero-item gold-rule mb-5"></div>
                
                <!-- Respuesta Inmediata a la Intención de Búsqueda -->
                <p class="hero-item text-offwhite/90 max-w-xl mb-8 text-base md:text-lg font-light leading-relaxed">
                    Ayudamos a líderes, empresas y equipos de marketing a traducir la inteligencia artificial en ventaja operativa: diagnóstico de madurez, agentes autónomos, posicionamiento SEO/GEO y automatización de procesos con retorno de inversión comprobable.
                </p>

                <!-- CTA Inmediato -->
                <div class="hero-item hero-cta-priority relative z-50 w-full flex flex-col sm:flex-row items-start sm:items-center gap-4 mt-2">
                    <CtaWhatsApp align="start" text="Solicitar diagnóstico estratégico" microcopy="Respuesta directa por WhatsApp · Sin formularios largos." href={heroWaHref} />
                    <ShareButton title="TAP-IA: IA aplicada a negocio y marketing" text="Conoce la estrategia de IA y SEO/GEO de Tap-IA:" url="https://tap-ia.tech" />
                </div>
            </div>

            <!-- Columna Derecha: PNG con transparencia real -->
            <div class="w-full lg:w-[45%] flex justify-center lg:justify-end items-center perspective-[1200px]">
                <div class="hero-item relative w-full max-w-[520px] tilt-3d-element transition-all duration-700 isolate">
                    <img
                        src="/Hero-Section-image-removebg-preview-removebg-preview.png"
                        alt="Hero Section Image"
                        class="relative z-10 block w-full h-auto max-h-[50vh] md:max-h-[60vh] lg:max-h-[65vh] xl:max-h-[520px] object-contain drop-shadow-[0_0_50px_rgba(212,175,55,0.22)] animate-[float_6s_ease-in-out_infinite] [clip-path:inset(2px)]"
                        width="800"
                        height="800"
                        sizes="(max-width: 768px) 90vw, 520px"
                        fetchpriority="high"
                        loading="eager"
                        decoding="async"
                    />
                </div>
            </div>

        </div>
    </section>

