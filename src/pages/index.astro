<script is:inline>
    // GSAP Animation Logic For the Homepage
    document.addEventListener("DOMContentLoaded", () => {
        const gsap = window.gsap;
        const ScrollTrigger = window.ScrollTrigger;
        
        if (!gsap || !ScrollTrigger) return;

        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        // Ocultar pre-render elements para el hero
        gsap.set(".hero-item", { y: 40, opacity: 0 });
        
        // 1. Hero Choreography
        window.addEventListener('preloaderComplete', () => {
            gsap.to(".hero-item", {
                y: 0,
                opacity: 1,
                duration: 1.2,
                stagger: 0.15,
                ease: "power3.out",
                force3D: true,
                clearProps: "transform"
            });
        });

        if (prefersReducedMotion) return;

        // Revelación de Texto (Efecto suave para Títulos)
        const revealElements = document.querySelectorAll('h2');
        revealElements.forEach(el => {
            gsap.fromTo(el, 
                { y: 30, opacity: 0 },
                { 
                    y: 0, opacity: 1, duration: 1, ease: "power3.out",
                    scrollTrigger: {
                        trigger: el,
                        start: "top 85%",
                        once: true
                    }
                }
            );
        });

        

        // Parallax en los Halos de Luz de fondo (Orbs radiales)
        const bgOrbs = document.querySelectorAll('.bg-gold\\/15, .bg-gold\\/12, .bg-gold\\/8, .bg-gold\\/10, .bg-gold\\/20');
        bgOrbs.forEach((orb, i) => {
            gsap.to(orb, {
                y: (i % 2 === 0) ? -150 : 150,
                x: (i % 2 === 0) ? 50 : -50,
                ease: "none",
                scrollTrigger: {
                    trigger: orb.parentElement,
                    start: "top bottom",
                    end: "bottom top",
                    scrub: 2
                }
            });
        });

        // Entrada de tarjetas de metodología
        gsap.utils.toArray(".methodology-step").forEach((step, i) => {
            gsap.fromTo(step,
                { y: 30, opacity: 0 },
                {
                    y: 0, opacity: 1, duration: 0.8, ease: "power2.out",
                    delay: i * 0.15,
                    scrollTrigger: { trigger: "#methodology-container", start: "top 80%", once: true }
                }
            );
        });

        // Trust Strip (Marcas)
        gsap.fromTo(".trust-item",
            { opacity: 0, y: 20 },
            { 
                opacity: 1, y: 0, stagger: 0.1, duration: 0.8, ease: "power2.out",
                scrollTrigger: { trigger: ".trust-section", start: "top 90%", once: true }
            }
        );

        // Hover Magnético en botones (Vanilla JS + GSAP)
        const magneticElements = document.querySelectorAll('.magnetic-btn');
        magneticElements.forEach(el => {
            el.addEventListener('mousemove', (e) => {
                const rect = el.getBoundingClientRect();
                const x = e.clientX - rect.left - rect.width / 2;
                const y = e.clientY - rect.top - rect.height / 2;
                gsap.to(el, { x: x * 0.1, y: y * 0.1, duration: 0.3, ease: "power2.out" });
            });
            el.addEventListener('mouseleave', () => {
                gsap.to(el, { x: 0, y: 0, duration: 0.7, ease: "elastic.out(1, 0.3)" });
            });
        });

        // Showcase & Portfolio Cards (Aparición)
        // Cards del grid de soluciones — stagger reveal
        gsap.set(".card-glow", { y: 60, opacity: 0, scale: 0.96 });
        gsap.to(".card-glow", {
            y: 0, opacity: 1, scale: 1,
            duration: 0.9, stagger: 0.1, ease: "power3.out",
            scrollTrigger: { trigger: ".quick-access-section", start: "top 75%", once: true }
        });

        gsap.fromTo(".portfolio-panel",
            { x: -50, opacity: 0 },
            {
                x: 0, opacity: 1, duration: 1, stagger: 0.15, ease: "power3.out",
                scrollTrigger: { trigger: ".portfolio-section", start: "top 80%", once: true }
            }
        );

        gsap.fromTo(".pricing-card",
            { y: 40, opacity: 0 },
            {
                y: 0, opacity: 1, duration: 0.8, stagger: 0.1, ease: "power2.out",
                scrollTrigger: { trigger: ".pricing-section", start: "top 80%", once: true }
            }
        );
    });
</script>
