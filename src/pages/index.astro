<script is:inline>
    // GSAP Animation Logic For the Homepage
    document.addEventListener("DOMContentLoaded", () => {
        const gsap = window.gsap;
        const ScrollTrigger = window.ScrollTrigger;
        
        if (!gsap || !ScrollTrigger) return;

        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const isMobileViewport = window.matchMedia('(max-width: 767px)').matches;
        const hasFinePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
        const skipHeroMotion = prefersReducedMotion || isMobileViewport;

        // Typewriter del título (TextPlugin en Layout.astro)
        const titleBase = document.getElementById('typewriter-base');
        const titleAccent = document.getElementById('typewriter-accent');
        const cursorBase = document.getElementById('cursor-base');
        const cursorAccent = document.getElementById('cursor-accent');

        const textBase = "La IA no hace marketing por ti.";
        const textAccent = "Te obliga a hacerlo mejor.";

        if (skipHeroMotion) {
            if (titleBase) titleBase.textContent = textBase;
            if (titleAccent) titleAccent.textContent = textAccent;
            if (cursorBase) cursorBase.style.display = 'none';
            if (cursorAccent) cursorAccent.style.display = 'none';
        }

        gsap.set(".hero-cta-priority", { opacity: 1, y: 0 });

        if (!skipHeroMotion) {
            gsap.set(".hero-item:not(#hero-title):not(.hero-cta-priority)", { y: 40, opacity: 0 });
        }

        function startCursorBlink(el) {
            return gsap.to(el, {
                opacity: 0,
                duration: 0.45,
                repeat: -1,
                ease: "steps(1)",
                yoyo: true
            });
        }

        // Hero: typewriter + entrada del resto de elementos
        window.addEventListener('preloaderComplete', () => {
            const tl = gsap.timeline();

            if (!skipHeroMotion && titleBase && titleAccent && cursorBase && cursorAccent) {
                titleBase.textContent = "";
                titleAccent.textContent = "";
                
                tl.set(cursorBase, { opacity: 1 })
                  .to(titleBase, {
                      text: textBase,
                      duration: 2,
                      ease: "none"
                  })
                  .set(cursorBase, { opacity: 0 })
                  .set(cursorAccent, { opacity: 1 }, "+=0.15")
                  .to(titleAccent, {
                      text: textAccent,
                      duration: 1.6,
                      ease: "none"
                  }, "+=0.1")
                  .call(() => { startCursorBlink(cursorAccent); });
            }

            tl.to(".hero-item:not(#hero-title):not(.hero-cta-priority)", {
                y: 0,
                opacity: 1,
                duration: skipHeroMotion ? 0 : 1.2,
                stagger: skipHeroMotion ? 0 : 0.12,
                ease: "power3.out",
                force3D: true,
                clearProps: "transform"
            }, skipHeroMotion ? 0 : "-=0.6");

            if (skipHeroMotion) {
                gsap.set(".hero-item:not(#hero-title)", { opacity: 1, y: 0 });
            }
        });

        if (prefersReducedMotion) return;

        // Custom Scramble Effect for Value Prop
        function scrambleText(element, finalString, durationMs) {
            const chars = "01A!<>*^#X%&$@?";
            let iterations = 0;
            const maxIterations = durationMs / 30; // approx 30ms per frame
            
            const interval = setInterval(() => {
                let scrambled = "";
                const lockCount = Math.floor((iterations / maxIterations) * finalString.length);
                
                for (let i = 0; i < finalString.length; i++) {
                    if (i < lockCount) {
                        scrambled += finalString[i];
                    } else if (finalString[i] === " ") {
                        scrambled += " ";
                    } else {
                        scrambled += chars[Math.floor(Math.random() * chars.length)];
                    }
                }
                
                element.innerText = scrambled;
                iterations++;
                
                if (iterations > maxIterations) {
                    clearInterval(interval);
                    element.innerText = finalString;
                }
            }, 30);
        }

        // DECODE & ENLIGHTEN (Value Proposition Unified)
        const vpBase = document.getElementById('decode-text-base');
        const vpAccent = document.getElementById('decode-text-accent');
        const vpContent = document.getElementById('value-prop-content');

        if (vpBase && vpAccent && vpContent) {
            const vpTextCol = vpContent.querySelector('.text-subtle');
            const vpVisualContainer = vpContent.querySelector('.vp-visual');

            if (!prefersReducedMotion && vpTextCol && vpVisualContainer) {
                const decodeTargets = vpContent.querySelectorAll('.decode-target');
                
                // Ocultar textos INICIALMENTE para que no se lean antes del efecto
                gsap.set([vpBase, vpAccent, ...decodeTargets], { opacity: 0 });

                // Configurar estados iniciales de las columnas individuales
                gsap.set(vpTextCol, { opacity: 0, y: 30 });
                gsap.set(vpVisualContainer, { 
                    opacity: 0, 
                    scale: 1.08, 
                    filter: isMobileViewport ? "none" : "blur(12px)" 
                });

                // Guardar texto original
                vpBase.dataset.text = vpBase.innerText;
                vpAccent.dataset.text = vpAccent.innerText;
                decodeTargets.forEach(el => el.dataset.text = el.innerText);

                ScrollTrigger.create({
                    trigger: "#value-prop",
                    start: "top 75%",
                    once: true,
                    onEnter: () => {
                        // 1. Mostrar y decodificar base
                        gsap.set(vpBase, { opacity: 1 });
                        scrambleText(vpBase, vpBase.dataset.text, 1000);

                        // 2. Timeline
                        const tl = gsap.timeline({ delay: 1.0 });

                        tl.call(() => {
                            gsap.set(vpAccent, { opacity: 1 });
                            scrambleText(vpAccent, vpAccent.dataset.text, 1200);
                        })
                        // Revelar el contenedor padre inmediatamente sin transiciones pesadas de golpe
                        .to(vpContent, {
                            opacity: 1,
                            y: 0,
                            filter: "none",
                            duration: 0.1
                        }, "+=1.2")
                        // Animar la columna de texto hacia arriba
                        .to(vpTextCol, {
                            opacity: 1,
                            y: 0,
                            duration: isMobileViewport ? 0.5 : 0.8,
                            ease: "power2.out"
                        })
                        .call(() => {
                            // Decodificar el contenido en cascada una vez que el texto está visible
                            decodeTargets.forEach((el, index) => {
                                setTimeout(() => {
                                    gsap.set(el, { opacity: 1 });
                                    scrambleText(el, el.dataset.text, 1000);
                                }, index * 100);
                            });
                        })
                        // Animar la imagen con un ligero retraso, zoom-out y desenfoque
                        .to(vpVisualContainer, {
                            opacity: 1,
                            scale: 1,
                            filter: "blur(0px)",
                            duration: isMobileViewport ? 0.5 : 1.2,
                            ease: "power3.out"
                        }, "-=0.4");
                    }
                });
            } else {
                // Fallback
                gsap.set([vpBase, vpAccent, ...vpContent.querySelectorAll('.decode-target')], { opacity: 1 });
                gsap.set(vpContent, { opacity: 1, y: 0, filter: "none" });
                if (vpTextCol && vpVisualContainer) {
                    gsap.set([vpTextCol, vpVisualContainer], { opacity: 1, y: 0, scale: 1, filter: "none" });
                }
            }
        }

        // Revelación de Texto (Efecto suave para Títulos restantes)
        const revealElements = document.querySelectorAll('h2:not(#value-prop h2)');
        revealElements.forEach(el => {
            gsap.fromTo(el, 
                { y: 40, opacity: 0 },
                { 
                    y: 0, opacity: 1, duration: 1.5, ease: "expo.out",
                    scrollTrigger: {
                        trigger: el,
                        start: "top 85%",
                        once: true
                    }
                }
            );
        });



        // Entrada de tarjetas de metodología
        gsap.utils.toArray(".methodology-step").forEach((step, i) => {
            gsap.fromTo(step,
                { y: 40, opacity: 0 },
                {
                    y: 0, opacity: 1, duration: 1.2, ease: "expo.out",
                    delay: i * 0.15,
                    clearProps: "transform",
                    scrollTrigger: { trigger: "#methodology-container", start: "top 80%", once: true }
                }
            );
        });

        // Trust Strip (Marcas)
        gsap.fromTo(".trust-item",
            { opacity: 0, y: 20 },
            { 
                opacity: 1, y: 0, stagger: 0.1, duration: 1.2, ease: "expo.out",
                scrollTrigger: { trigger: ".trust-section", start: "top 90%", once: true }
            }
        );

        // Hover Magnético en botones (solo puntero fino)
        const magneticElements = hasFinePointer ? document.querySelectorAll('.magnetic-btn') : [];
        magneticElements.forEach(el => {
            el.addEventListener('mousemove', (e) => {
                const rect = el.getBoundingClientRect();
                const x = e.clientX - rect.left - rect.width / 2;
                const y = e.clientY - rect.top - rect.height / 2;
                gsap.to(el, { x: x * 0.1, y: y * 0.1, duration: 0.3, ease: "power2.out" });
            });
            el.addEventListener('mouseleave', () => {
                gsap.to(el, { x: 0, y: 0, duration: 0.7, ease: "elastic.out(1, 0.3)" });
            });
        });

        // Kinetic Flex Accordion (Efecto Wow)
        const accordionItems = gsap.utils.toArray('.accordion-item');
        if (accordionItems.length > 0) {
            gsap.fromTo(accordionItems, 
                { y: 50, opacity: 0 },
                {
                    y: 0, opacity: 1, duration: 1.2, stagger: 0.1, ease: "power3.out",
                    scrollTrigger: {
                        trigger: ".accordion-container",
                        start: "top 80%",
                        once: true
                    }
                }
            );
        }

        // Showcase & Portfolio Cards (Aparición)
        // Cards del grid de soluciones — stagger reveal
        gsap.set(".card-glow", { y: 80, opacity: 0, scale: 0.95 });
        gsap.to(".card-glow", {
            y: 0, opacity: 1, scale: 1,
            duration: 1.5, stagger: 0.15, ease: "expo.out",
            scrollTrigger: { trigger: ".quick-access-section", start: "top 75%", once: true }
        });

        // Portfolio: entrada en scroll (preview vía CSS :has)
        const portfolioItems = gsap.utils.toArray('.portfolio-item');
        if (portfolioItems.length > 0) {
            gsap.fromTo(portfolioItems,
                { y: prefersReducedMotion ? 0 : 40, opacity: prefersReducedMotion ? 1 : 0 },
                {
                    y: 0, opacity: 1,
                    duration: prefersReducedMotion ? 0 : 1,
                    stagger: prefersReducedMotion ? 0 : 0.12,
                    ease: "expo.out",
                    scrollTrigger: { trigger: ".portfolio-section", start: "top 80%", once: true }
                }
            );
        }

        gsap.fromTo(".pricing-card",
            { y: 50, opacity: 0 },
            {
                y: 0, opacity: 1, duration: 1.2, stagger: 0.15, ease: "expo.out",
                scrollTrigger: { trigger: ".pricing-section", start: "top 80%", once: true }
            }
        );

        // Intelligence Feed / Editorial Rows
        const editorialRows = gsap.utils.toArray('.editorial-row');
        if (editorialRows.length > 0) {
            gsap.fromTo(editorialRows,
                { y: prefersReducedMotion ? 0 : 35, opacity: prefersReducedMotion ? 1 : 0 },
                {
                    y: 0, opacity: 1,
                    duration: prefersReducedMotion ? 0 : 1,
                    stagger: prefersReducedMotion ? 0 : 0.12,
                    ease: "expo.out",
                    scrollTrigger: { trigger: "#novedades-ia", start: "top 80%", once: true }
                }
            );
        }

        // 3D Tilt Effect for Hero Image
        const heroContainer = document.querySelector('.hero-container');
        const tiltElement = document.querySelector('.tilt-3d-element');

        if (heroContainer && tiltElement && !prefersReducedMotion && hasFinePointer) {
            // GSAP quickTo para máximo rendimiento y evitar que la animación se trabe en mousemove
            const xTo = gsap.quickTo(tiltElement, "rotateY", { ease: "power2.out", duration: 0.6 });
            const yTo = gsap.quickTo(tiltElement, "rotateX", { ease: "power2.out", duration: 0.6 });
            
            gsap.set(tiltElement, { transformPerspective: 1200 });

            heroContainer.addEventListener('mousemove', (e) => {
                const rect = heroContainer.getBoundingClientRect();
                const x = e.clientX - rect.left; 
                const y = e.clientY - rect.top;
                
                const centerX = rect.width / 2;
                const centerY = rect.height / 2;
                
                // Rotación máxima de 12 grados
                const rotateX = ((y - centerY) / centerY) * -12; 
                const rotateY = ((x - centerX) / centerX) * 12;
                
                xTo(rotateY);
                yTo(rotateX);
            });

            heroContainer.addEventListener('mouseleave', () => {
                // Volver a la posición original suavemente
                gsap.to(tiltElement, {
                    rotateX: 0,
                    rotateY: 0,
                    ease: "elastic.out(1, 0.4)",
                    duration: 1.5,
                    overwrite: "auto"
                });
            });
        }
    });
</script>

<style>
    /* Kinetic Flex Accordion CSS */
    .accordion-item {
        flex: 1;
        transition: flex 0.7s cubic-bezier(0.25, 1, 0.25, 1), background-color 0.5s ease;
        cursor: pointer;
        min-width: 0;
    }

    @media (max-width: 767px) {
        .accordion-item {
            flex: none;
            min-height: 11rem;
        }

        .accordion-item .accordion-details {
            opacity: 1;
            max-height: none;
            transform: none;
            pointer-events: auto;
        }

        .accordion-item .accordion-icon {
            opacity: 1;
            transform: translateX(0);
        }
    }

    @media (hover: hover) and (pointer: fine) {
        .accordion-item {
            will-change: flex, width;
        }

        .accordion-item:hover {
            flex: 4;
        }

        .accordion-item .accordion-details {
            opacity: 0;
            max-height: 0;
            transform: translateY(20px);
            transition: opacity 0.5s ease 0.2s, transform 0.5s ease 0.2s, max-height 0.7s cubic-bezier(0.25, 1, 0.25, 1);
            will-change: opacity, transform, max-height;
            pointer-events: none;
        }

        .accordion-item:hover .accordion-details {
            opacity: 1;
            max-height: 200px;
            transform: translateY(0);
            pointer-events: auto;
        }

        .accordion-item .accordion-icon {
            opacity: 0;
            transform: translateX(-10px);
            transition: all 0.5s ease;
        }

        .accordion-item:hover .accordion-icon {
            opacity: 1;
            transform: translateX(0);
        }
    }

    /* Título rotado en Desktop */
    @media (min-width: 768px) {
        .accordion-title {
            transform-origin: bottom left;
            transform: rotate(-90deg) translateY(100%);
        }

        .accordion-item:hover .accordion-title {
            transform: rotate(0deg) translateY(0);
        }
    }

    /* Portfolio Split Layout — preview panel (CSS :has) */
    @media (min-width: 1024px) {
        .portfolio-preview-img {
            opacity: 0;
            transition: opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .portfolio-preview-img.portfolio-preview-img--default {
            opacity: 1;
        }

        .portfolio-split:has(.portfolio-item:hover) .portfolio-preview-img--default,
        .portfolio-split:has(.portfolio-item:focus-within) .portfolio-preview-img--default {
            opacity: 0;
        }

        .portfolio-split:has(.portfolio-list .portfolio-item:nth-child(1):hover) .portfolio-preview-img[data-preview="sitios"],
        .portfolio-split:has(.portfolio-list .portfolio-item:nth-child(1):focus-within) .portfolio-preview-img[data-preview="sitios"],
        .portfolio-split:has(.portfolio-list .portfolio-item:nth-child(2):hover) .portfolio-preview-img[data-preview="seo"],
        .portfolio-split:has(.portfolio-list .portfolio-item:nth-child(2):focus-within) .portfolio-preview-img[data-preview="seo"],
        .portfolio-split:has(.portfolio-list .portfolio-item:nth-child(3):hover) .portfolio-preview-img[data-preview="agentes"],
        .portfolio-split:has(.portfolio-list .portfolio-item:nth-child(3):focus-within) .portfolio-preview-img[data-preview="agentes"] {
            opacity: 1;
        }

        .portfolio-split:has(.portfolio-item:hover) .portfolio-item:not(:hover),
        .portfolio-split:has(.portfolio-item:focus-within) .portfolio-item:not(:focus-within) {
            opacity: 0.45;
        }

        .portfolio-split:has(.portfolio-item:hover) .portfolio-item:hover,
        .portfolio-split:has(.portfolio-item:focus-within) .portfolio-item:focus-within {
            opacity: 1;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .portfolio-preview-img {
            transition: none;
        }
    }

    /* Propuesta de valor: Máscara de transparencia pura optimizada para hardware */
    .vp-visual {
        transform: translate3d(0, 0, 0);
        will-change: mask-image;
    }

    .vp-visual-img {
        -webkit-mask-image: radial-gradient(ellipse 85% 85% at 50% 50%, #000000 50%, transparent 100%);
        mask-image: radial-gradient(ellipse 85% 85% at 50% 50%, #000000 50%, transparent 100%);
        
        -webkit-mask-size: cover;
        mask-size: cover;
        
        -webkit-mask-repeat: no-repeat;
        mask-repeat: no-repeat;
        
        -webkit-mask-position: center;
        mask-position: center;
        
        /* Promoción a capa de hardware (GPU) */
        transform: translate3d(0, 0, 0);
    }
</style>
