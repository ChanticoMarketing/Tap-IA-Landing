---
import SchemaOrganization from '../components/SchemaOrganization.astro';
import { getSeoDefaults, SITE_URL } from '../lib/seo';

interface Props {
	title: string;
	description?: string;
	ogImage?: string;
	keywords?: string;
	canonical?: string;
	noIndex?: boolean;
}

const {
	title,
	description,
	ogImage = `${SITE_URL}/logo.png`,
	keywords,
	canonical,
	noIndex
} = Astro.props;

const seoDefaults = getSeoDefaults(Astro.url.pathname);
const canonicalURL = new URL(canonical ?? seoDefaults.canonical, SITE_URL).href;
const resolvedDescription = description ?? seoDefaults.description;
const effectiveNoIndex = noIndex ?? seoDefaults.noIndex;
const robotsContent = effectiveNoIndex ? 'noindex, follow' : 'index, follow';
---

<!doctype html>
<html lang="es" class="scroll-smooth">
	<head>
		<!-- Google tag (gtag.js) -->
		<script async src="https://www.googletagmanager.com/gtag/js?id=G-M41YW56FWH"></script>
		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			function gtag(){dataLayer.push(arguments);}
			gtag('js', new Date());

			gtag('config', 'G-M41YW56FWH');
		</script>

		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content={resolvedDescription} />
		<meta name="robots" content={robotsContent} />
		{keywords && <meta name="keywords" content={keywords} />}
		<link rel="canonical" href={canonicalURL} />
		<link rel="sitemap" href="/sitemap.xml" />

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={resolvedDescription} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:locale" content="es_MX" />
		<meta property="og:site_name" content="TAP-IA" />

		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={resolvedDescription} />
		<meta name="twitter:image" content={ogImage} />

		<title>{title}</title>

        <!-- Favicon -->
        <link rel="icon" type="image/png" href="/Logo-Favicon.png" />
        
        <!-- Fuentes -->
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600&family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400&display=swap" rel="stylesheet">
    
        <!-- Iconos -->
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

        <!-- Contentsquare / Hotjar Tracking -->
        <script src="https://t.contentsquare.net/uxa/df620f776941c.js" async defer></script>

	</head>
	<body class="bg-charcoal text-offwhite font-sans antialiased selection:bg-gold selection:text-white overflow-x-hidden">
        
        <!-- PREMIUM CURTAIN PRELOADER -->
        <div id="preloader" class="fixed inset-0 bg-charcoal z-[9999] flex items-center justify-center" style="background-color: var(--color-charcoal);">
            <div class="text-center opacity-0 translate-y-4" id="preloader-content">
                <div class="text-white tracking-[0.2em] text-4xl md:text-5xl uppercase drop-shadow-[0_0_15px_rgba(255,255,255,0.2)]" style="font-family: var(--font-playfair)">Tap-IA</div>
                <div class="h-1 w-0 bg-gold mt-4 mx-auto rounded-full" id="preloader-line"></div>
            </div>
        </div>

		<!-- Free-Floating Atmospheric Orbs -->
		<div class="fixed inset-0 z-[-2] pointer-events-none overflow-hidden" aria-hidden="true">
			<div class="floating-orb floating-orb--gold absolute w-[28vw] h-[28vw] min-w-[180px] min-h-[180px] rounded-full blur-[100px] md:blur-[140px] opacity-0" style="top: 0; left: 0; will-change: transform, opacity;"></div>
			<div class="floating-orb floating-orb--gold absolute w-[22vw] h-[22vw] min-w-[140px] min-h-[140px] rounded-full blur-[90px] md:blur-[120px] opacity-0" style="top: 0; left: 0; will-change: transform, opacity;"></div>
			<div class="floating-orb floating-orb--blue absolute w-[32vw] h-[32vw] min-w-[220px] min-h-[220px] rounded-full blur-[110px] md:blur-[150px] opacity-0" style="top: 0; left: 0; will-change: transform, opacity;"></div>
			<div class="floating-orb floating-orb--blue absolute w-[24vw] h-[24vw] min-w-[160px] min-h-[160px] rounded-full blur-[95px] md:blur-[130px] opacity-0" style="top: 0; left: 0; will-change: transform, opacity;"></div>
		</div>

		<SchemaOrganization />
		<div class="noise-overlay z-[-1]"></div>
		<slot />

        <script>
            import { gsap } from "gsap";
            import { ScrollTrigger } from "gsap/ScrollTrigger";
            import { TextPlugin } from "gsap/TextPlugin";

            gsap.registerPlugin(ScrollTrigger, TextPlugin);

            // Hacer gsap global por si componentes locales lo necesitan
            (window as any).gsap = gsap;
            (window as any).ScrollTrigger = ScrollTrigger;
            (window as any).TextPlugin = TextPlugin;

            document.addEventListener("DOMContentLoaded", () => {
                const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
                const isMobileViewport = window.matchMedia('(max-width: 767px)').matches;

                function finishPreloader() {
                    document.documentElement.style.overflow = '';
                    document.body.style.overflow = '';
                    (window as any).__preloaderComplete = true;
                    window.dispatchEvent(new Event('preloaderComplete'));
                }

                const preloaderEl = document.getElementById('preloader');

                if (prefersReducedMotion || isMobileViewport) {
                    if (preloaderEl) {
                        preloaderEl.style.display = 'none';
                    }
                    (window as any).__preloaderComplete = true;
                    finishPreloader();
                } else {
                    document.documentElement.style.overflow = 'hidden';
                    document.body.style.overflow = 'hidden';

                    const tl = gsap.timeline();

                    tl.to("#preloader-content", {
                        opacity: 1,
                        y: 0,
                        duration: 1,
                        ease: "power3.out",
                        delay: 0.1
                    })
                    .to("#preloader-line", {
                        width: "100%",
                        duration: 0.8,
                        ease: "power2.inOut"
                    }, "-=0.5")
                    .to("#preloader", {
                        yPercent: -100,
                        duration: 1.2,
                        ease: "expo.inOut",
                        delay: 0.5,
                        onStart: () => {
                            document.documentElement.style.overflow = '';
                            document.body.style.overflow = '';
                        },
                        onComplete: finishPreloader
                    });
                }

                // --- FREE-FLOATING ORBS CHOREOGRAPHY (desktop + puntero fino) ---
                const orbs = gsap.utils.toArray<HTMLElement>('.floating-orb');
                const goldOrbs = orbs.filter((o) => o.classList.contains('floating-orb--gold'));
                const blueOrbs = orbs.filter((o) => o.classList.contains('floating-orb--blue'));
                const canRunOrbAmbient =
                    orbs.length > 0 &&
                    !prefersReducedMotion &&
                    !isMobileViewport &&
                    window.matchMedia('(min-width: 768px)').matches;

                if (canRunOrbAmbient) {
                    const GOLD_PEAK = 0.65;
                    const BLUE_PEAK = 0.48;
                    const GLOW_HALF = 4.5; // segundos por subida/bajada (curva continua, sin cortes)

                    let orbsAmbientActive = false;
                    let ambientStarted = false;
                    const driftTimers: gsap.core.Tween[] = [];

                    // Los orbes ahora pueden moverse por toda la pantalla de forma dinámica
                    function getOrbBounds(orb: HTMLElement) {
                        const maxX = Math.max(0, window.innerWidth - orb.offsetWidth);
                        const maxY = Math.max(0, window.innerHeight - orb.offsetHeight);
                        return {
                            xMin: 0,
                            xMax: maxX,
                            yMin: 0,
                            yMax: maxY
                        };
                    }

                    // Deriva suave (quickTo evita saltos entre tweens encadenados)
                    function startOrbDrift(orb: HTMLElement) {
                        const { xMin, xMax, yMin, yMax } = getOrbBounds(orb);
                        const xTo = gsap.quickTo(orb, 'x', { duration: 14, ease: 'sine.inOut' });
                        const yTo = gsap.quickTo(orb, 'y', { duration: 14, ease: 'sine.inOut' });

                        const wander = () => {
                            if (!orbsAmbientActive) return;
                            xTo(gsap.utils.random(xMin, xMax));
                            yTo(gsap.utils.random(yMin, yMax));
                            const t = gsap.delayedCall(gsap.utils.random(12, 20), wander);
                            driftTimers.push(t);
                        };

                        xTo(gsap.utils.random(xMin, xMax));
                        yTo(gsap.utils.random(yMin, yMax));
                        wander();
                    }

                    // Respiración de opacidad continua (sin .set(0) que producía tirones)
                    function startOrbGlow(orb: HTMLElement, peak: number, phaseDelay: number) {
                        gsap.fromTo(
                            orb,
                            { opacity: 0 },
                            {
                                opacity: peak,
                                duration: GLOW_HALF,
                                ease: 'sine.inOut',
                                yoyo: true,
                                repeat: -1,
                                delay: phaseDelay
                            }
                        );
                    }

                    function startOrbAmbient() {
                        if (ambientStarted) return;
                        ambientStarted = true;
                        orbsAmbientActive = true;

                        goldOrbs.forEach((orb, i) => {
                            const { xMin, xMax, yMin, yMax } = getOrbBounds(orb);
                            gsap.set(orb, {
                                x: gsap.utils.random(xMin, xMax),
                                y: gsap.utils.random(yMin, yMax),
                                opacity: 0,
                                force3D: true
                            });
                            startOrbDrift(orb);
                            startOrbGlow(orb, GOLD_PEAK, i * 1.8);
                        });

                        // Azul en contrafase: cuando el oro sube, el azul baja (no compiten en pantalla)
                        blueOrbs.forEach((orb, i) => {
                            const { xMin, xMax, yMin, yMax } = getOrbBounds(orb);
                            gsap.set(orb, {
                                x: gsap.utils.random(xMin, xMax),
                                y: gsap.utils.random(yMin, yMax),
                                opacity: 0,
                                force3D: true
                            });
                            startOrbDrift(orb);
                            startOrbGlow(orb, BLUE_PEAK, GLOW_HALF + i * 1.8);
                        });
                    }

                    function stopOrbAmbient() {
                        orbsAmbientActive = false;
                        ambientStarted = false;
                        driftTimers.forEach((t) => t.kill());
                        driftTimers.length = 0;
                        orbs.forEach((orb) => {
                            gsap.killTweensOf(orb);
                            gsap.set(orb, { opacity: 0 });
                        });
                    }

                    (window as any).stopOrbAmbient = stopOrbAmbient;

                    window.addEventListener('resize', () => {
                        if (!orbsAmbientActive) return;
                        orbs.forEach((orb) => {
                            const { xMin, xMax, yMin, yMax } = getOrbBounds(orb);
                            const x = gsap.getProperty(orb, 'x') as number;
                            const y = gsap.getProperty(orb, 'y') as number;
                            gsap.set(orb, {
                                x: gsap.utils.clamp(xMin, xMax, x),
                                y: gsap.utils.clamp(yMin, yMax, y)
                            });
                        });
                    });

                    // Start immediately
                    startOrbAmbient();
                }
            });
        </script>
	</body>
</html>

<style is:global>
    @import 'tailwindcss';

    @theme {
        --color-charcoal: #0a0b0e;
        --color-matte: #16191f;
        --color-gold: #d4af37;
        --color-royal: #2a5a8c;
        --color-navy: #1a2744;
        --color-navy-accent: #2a5a8c;
        --color-success: #10b981;
        --color-error: #f43f5e;
        --color-whatsapp: #25d366;
        --color-offwhite: #e2e4e9;
        --color-subtle: #9ca3af;
        --font-playfair: 'Playfair Display', serif;
        --font-jakarta: 'Plus Jakarta Sans', sans-serif;
    }

    /* Global Typography Reset */
    h1 {
        font-family: var(--font-playfair);
        font-weight: 700;
        letter-spacing: -0.02em;
        color: var(--color-offwhite);
        font-size: clamp(2.5rem, 6vw, 4.5rem);
        line-height: 1.05;
        text-wrap: balance;
    }

    h2 {
        font-family: var(--font-playfair);
        font-weight: 600;
        letter-spacing: -0.01em;
        color: var(--color-offwhite);
        font-size: clamp(2rem, 5vw, 3.5rem);
        line-height: 1.1;
        text-wrap: balance;
    }

    h3 {
        font-family: var(--font-playfair);
        font-weight: 500;
        color: var(--color-offwhite);
        font-size: clamp(1.5rem, 3vw, 1.85rem);
        line-height: 1.2;
    }

    body {
        font-family: var(--font-jakarta);
        font-weight: 400;
        color: var(--color-subtle);
        font-size: clamp(0.95rem, 1.2vw, 1.125rem);
        line-height: 1.6;
        background-color: var(--color-charcoal);
    }

    .ui-caption {
        font-family: var(--font-jakarta);
        font-weight: 500;
        text-transform: uppercase;
        color: var(--color-subtle);
        font-size: clamp(0.75rem, 1.5vw, 0.875rem);
        letter-spacing: 0.05em;
    }

    /* Editorial label — "IA APLICADA A MARKETING" style */
    .editorial-label {
        font-family: var(--font-jakarta);
        font-weight: 700;
        text-transform: uppercase;
        color: var(--color-gold);
        font-size: 13px;
        letter-spacing: 0.25em;
    }

    /* Gold rule — thin decorative line separator */
    .gold-rule {
        height: 1px;
        max-width: 80px;
        background: linear-gradient(90deg, var(--color-gold), transparent);
        border: none;
    }

    .text-gold {
        color: var(--color-gold) !important;
    }

    .text-offwhite {
        color: var(--color-offwhite) !important;
    }

    .text-subtle {
        color: var(--color-subtle) !important;
    }

    /* Sombra de texto para el Hero: garantiza legibilidad sobre cualquier fondo */
    .hero-text-shadow {
        text-shadow:
            0 2px 8px rgba(0, 0, 0, 0.8),
            0 4px 24px rgba(0, 0, 0, 0.6),
            0 8px 48px rgba(0, 0, 0, 0.4);
    }
    .hero-text-shadow-sm {
        text-shadow:
            0 1px 4px rgba(0, 0, 0, 0.9),
            0 2px 16px rgba(0, 0, 0, 0.7);
    }

    /* Destellos atmosféricos: un color puro por orbe; GPU-friendly */
    .floating-orb {
        transform: translate3d(0, 0, 0);
        backface-visibility: hidden;
        contain: layout style paint;
    }

    .floating-orb--gold {
        background-color: #d4af37;
    }

    .floating-orb--blue {
        background-color: var(--color-royal);
    }

    .noise-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: 50;
        pointer-events: none;
        opacity: 0.025;
        background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
    }

    .matte-card {
        background: linear-gradient(180deg, rgba(15, 17, 20, 0.96) 0%, rgba(8, 9, 11, 0.99) 100%);
        backdrop-filter: blur(16px);
        border: 1px solid rgba(255, 255, 255, 0.08);
        box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.05), 0 12px 40px rgba(0, 0, 0, 0.65);
        border-radius: 12px;
        transition: transform 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94), opacity 0.4s ease, border-color 0.4s ease;
        will-change: transform, opacity;
    }

    /* Estilos personalizados para el formulario */
    .step-content {
        display: none;
        animation: fadeIn 0.5s ease-out;
    }

    .step-content.active {
        display: block;
    }

    @keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Checkbox Styles */
    input[type="checkbox"] {
        accent-color: #d4af37;
        width: 1.2em;
        height: 1.2em;
        cursor: pointer;
    }

    .option-label {
        display: flex;
        align-items: center;
        padding: 10px 12px;
        border-radius: 8px;
        border: 1px solid rgba(255, 255, 255, 0.05);
        background: rgba(255, 255, 255, 0.02);
        cursor: pointer;
        transition: all 0.2s;
    }

    .option-label:hover {
        background: rgba(212, 175, 55, 0.08); /* Tono dorado premium en hover */
        border-color: rgba(212, 175, 55, 0.45); /* Borde dorado destacado */
        color: #ffffff; /* Texto blanco puro */
    }

    .option-label:hover span {
        color: #ffffff; /* Forzar legibilidad de las letras */
    }

    .option-label:has(input:checked) {
        border-color: rgba(212, 175, 55, 0.6);
        background: rgba(212, 175, 55, 0.1);
    }

    .option-label:has(input:focus-visible) {
        outline: 2px solid var(--color-gold);
        outline-offset: 2px;
        border-color: rgba(212, 175, 55, 0.6);
        background: rgba(212, 175, 55, 0.05);
    }

    input:checked+span {
        color: var(--color-gold);
        font-weight: 500;
    }

    .input-field--error {
        border-color: rgba(155, 77, 77, 0.8) !important;
        box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.5), 0 0 0 2px rgba(155, 77, 77, 0.15) !important;
    }

    .field-error {
        color: #c97a7a;
        font-size: 0.75rem;
        margin-top: 0.5rem;
    }

    .services-group--error .option-label {
        border-color: rgba(155, 77, 77, 0.4);
    }

    .honeypot-field {
        position: absolute;
        left: -9999px;
        width: 1px;
        height: 1px;
        overflow: hidden;
        opacity: 0;
        pointer-events: none;
    }

    @media (prefers-reduced-motion: reduce) {
        .step-content.active {
            animation: none;
        }
    }

    .input-field {
        background: rgba(10, 11, 14, 0.6);
        border: 1px solid rgba(255, 255, 255, 0.08);
        box-shadow: inset 0 2px 6px rgba(0, 0, 0, 0.6);
        color: #e2e4e9;
        padding: 10px 14px;
        border-radius: 8px;
        width: 100%;
        transition: all 0.3s ease;
    }

    .input-field:focus {
        outline: none;
        border-color: rgba(212, 175, 55, 0.5);
        box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.5), 0 0 0 2px rgba(212, 175, 55, 0.1);
        background: rgba(10, 11, 14, 0.9);
    }

    /* Estilo personalizado para Select */
    select.input-field {
        appearance: none;
        background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23d4af37' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3e%3cpolyline points='6 9 12 15 18 9'%3e%3c/polyline%3e%3c/svg%3e");
        background-repeat: no-repeat;
        background-position: right 1rem center;
        background-size: 1em;
        padding-right: 2.5rem;
        cursor: pointer;
        color-scheme: dark; /* Fuerza al navegador a usar dropdowns oscuros de alto contraste */
    }

    select option {
        background-color: #16191f;
        color: #ffffff; /* Blanco puro para evitar letra gris sobre fondo de selección nativo */
        padding: 10px;
    }

    @keyframes pulse-slow {

        0%,
        100% {
            opacity: 0.4;
            transform: scale(1);
        }

        50% {
            opacity: 0.6;
            transform: scale(1.05);
        }
    }

    .animate-pulse-slow {
        animation: pulse-slow 8s infinite;
    }
    
    .animate-sweep {
        animation: sweep 0.2s ease-in-out;
    }

    @keyframes sweep {
        0% { opacity: 0; transform: translateY(-10px); }
        100% { opacity: 1; transform: translateY(0); }
    }


    details>summary {
        list-style: none;
    }

    details>summary::-webkit-details-marker {
        display: none;
    }

    /* ─── Card Glow System ─── */
    .card-glow {
        position: relative;
        background: linear-gradient(180deg, rgba(22, 25, 31, 0.3) 0%, rgba(10, 11, 14, 0.7) 100%);
        border: 1px solid rgba(255, 255, 255, 0.05);
        box-shadow: 
            inset 0 1px 1px rgba(255, 255, 255, 0.03), 
            0 10px 40px rgba(0, 0, 0, 0.4);
        border-radius: 20px;
        transition: background 0.6s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.6s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.6s cubic-bezier(0.16, 1, 0.3, 1), backdrop-filter 0.6s cubic-bezier(0.16, 1, 0.3, 1);
        overflow: hidden;
        backdrop-filter: blur(12px);
    }

    .card-glow:hover {
        background: linear-gradient(180deg, rgba(22, 25, 31, 0.4) 0%, rgba(10, 11, 14, 0.8) 100%);
        border-color: rgba(212, 175, 55, 0.3);
        box-shadow: 
            0 20px 80px rgba(0, 0, 0, 0.6),
            0 0 40px rgba(212, 175, 55, 0.05),
            inset 0 1px 1px rgba(212, 175, 55, 0.2);
    }

    .card-glow::after {
        content: '';
        position: absolute;
        inset: 0;
        background: radial-gradient(circle at var(--mouse-x, 50%) var(--mouse-y, 50%), rgba(212, 175, 55, 0.08), transparent 80%);
        opacity: 0;
        transition: opacity 0.5s ease;
        pointer-events: none;
        z-index: 0;
    }

    .card-glow:hover::after {
        opacity: 1;
    }

    .card-glow > * {
        position: relative;
        z-index: 1;
    }

    /* GPU optimizations for GSAP scroll triggers */
    .card-glow,
    main > section,
    .divide-y > div {
        will-change: transform, opacity;
    }

    /* ─── Marquee ─── */
    @keyframes marquee {
        0%   { transform: translateX(0); }
        100% { transform: translateX(-50%); }
    }

    .animate-marquee {
        animation: marquee 35s linear infinite;
    }

    .animate-marquee:hover {
        animation-play-state: paused;
    }

    @media (prefers-reduced-motion: reduce) {
        .animate-marquee {
            animation: none;
        }
    }

    /* ─── CTA background gradient animation ─── */
    @keyframes cta-gradient-shift {
        0%   { background-position: 0% 50%; }
        50%  { background-position: 100% 50%; }
        100% { background-position: 0% 50%; }
